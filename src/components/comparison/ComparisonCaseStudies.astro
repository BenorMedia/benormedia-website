---
/**
 * ComparisonCaseStudies — case studies section (Figma 3790:37773): section
 * header (`caseStudiesHeader`) and up to three v2 `CaseStudyCard`s in the
 * shared `CaseStudyGrid` ("resources" layout: 40px columns, 60px below the
 * header, h3 titles). Cards = the editor's picks, else the 3 newest
 * published case studies (SCHEMAS v0.13). No cards → no section.
 */
import Container from "../ui/Container.astro";
import CaseStudyGrid from "../case-studies/CaseStudyGrid.astro";
import ComparisonSectionHeader from "./ComparisonSectionHeader.astro";
import type { AccentSectionHeader, CaseStudyCard } from "../../lib/sanity/types";

interface Props {
  header?: AccentSectionHeader | null | undefined;
  cards: readonly CaseStudyCard[];
}

const { header, cards } = Astro.props;
const list = cards.slice(0, 3);
---

{list.length > 0 && (
  <section class="c-cmp-cases">
    <Container>
      <ComparisonSectionHeader header={header} titleWidth="55.7rem" descriptionWidth="35.2rem" />
      <CaseStudyGrid cards={list} variant="resources" />
    </Container>
  </section>
)}

<style>
  .c-cmp-cases {
    background: var(--color-white);
  }
  /* Figma: 110px above and below. */
  .c-cmp-cases :global(.c-container) {
    padding-top: 7.857rem;
    padding-bottom: 7.857rem;
  }
  @media (max-width: 767px) {
    .c-cmp-cases :global(.c-container) {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }
</style>
