---
/**
 * ComparisonPill — c-cmp-pill
 * "Webflow VS <competitor>" (Figma hero 3790:37351, index card 3790:38001):
 * a thin bordered box with a square on each side (the Eyebrow / CaseStudyLogo
 * pattern), the Webflow logo in an accent box, "VS", and the competitor logo
 * in a gray box. The hero variant adds the chevron after the competitor logo
 * (static: no interaction spec yet, DECISIONS → Comparison, design team).
 *
 * Every size is in `em` of the pill's own font size (Figma "VS" = 18px), so
 * the whole pill scales as one: the hero sets 18px at the 14px base
 * (1.286rem); the index card sets it from the card width (container query
 * units on the card thumbnail), as Figma keeps the same pill in a 543px card.
 *
 * Webflow logo: fixed in code (`src/assets/comparison/logos/webflow.png`,
 * 2x export, lead 2026-10-22: keep as exported). Competitor logo: Sanity
 * `competitorLogo` (or the `/dev/comparison` fixture), sized by `logoBox`;
 * no logo → the competitor name as text.
 */
import { Image } from "astro:assets";
import webflowLogo from "../../assets/comparison/logos/webflow.png";
import chevron from "../../assets/comparison/icons/chevron-down.svg?raw";
import { COMPARISON_COPY, WEBFLOW_NAME } from "./copy";
import { altOr, logoBox, type ComparisonImageInput } from "./image";

interface Props {
  competitorName: string;
  competitorLogo?: ComparisonImageInput;
  variant?: "hero" | "card";
  /** Above the fold: load eagerly. */
  eager?: boolean;
  class?: string;
}

const { competitorName, competitorLogo, variant = "hero", eager = false, class: className } = Astro.props;

// Figma px at the pill's 18px type: Webflow 153.6 × 26.39; competitor logos
// from 26 (Framer, Wix) to 37.43 (WordPress) tall.
const PILL_PX = 18;
const logo = logoBox(competitorLogo, altOr(competitorLogo, competitorName), { minHeight: 26, maxHeight: 37.43 });
const em = (px: number): string => `${Math.round((px / PILL_PX) * 1000) / 1000}em`;
const loading = eager ? "eager" : "lazy";
const rootClass = ["c-cmp-pill", `is-${variant}`, className].filter(Boolean).join(" ");
---

<span class={rootClass}>
  <span class="c-cmp-pill__side is-webflow">
    <Image
      class="c-cmp-pill__logo is-webflow"
      src={webflowLogo}
      alt={WEBFLOW_NAME}
      width={154}
      height={27}
      densities={[1, 2]}
      loading={loading}
    />
  </span>
  <span class="c-cmp-pill__vs" aria-hidden="true">{COMPARISON_COPY.vs}</span>
  <span class="c-cmp-pill__side is-competitor">
    {logo ? (
      <img
        class="c-cmp-pill__logo"
        src={logo.src}
        width={Math.round(logo.width)}
        height={Math.round(logo.height)}
        alt={logo.alt}
        style={`height: ${em(logo.height)};`}
        loading={loading}
        decoding="async"
      />
    ) : (
      <span class="c-cmp-pill__name">{competitorName}</span>
    )}
    {variant === "hero" && <span class="c-cmp-pill__chevron" aria-hidden="true" set:html={chevron} />}
  </span>
</span>

<style>
  /* Figma 3790:37351: 0.6px #C9CEDA border (Eyebrow's 0.5px gray), 3.6px
     radius, 12 / 19.2 / 9.6px padding, 9.6px gaps, at 18px type. */
  .c-cmp-pill {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    gap: 0.533em;
    padding: 0.667em 1.067em 0.533em;
    border: 0.5px solid var(--color-gray);
    border-radius: 3.6px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.286rem; /* Figma "VS" 18px at the 14px base. TODO: DS */
    font-weight: 400;
    line-height: normal;
  }
  /* Side squares: 12px, 6.6px out (Figma 3790:37358 / 37359). */
  .c-cmp-pill::before,
  .c-cmp-pill::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0.667em;
    height: 0.667em;
    transform: translateY(-50%);
    border: 0.5px solid var(--color-gray);
    border-radius: 1.8px;
    background: var(--color-white);
  }
  .c-cmp-pill::before {
    left: -0.367em;
  }
  .c-cmp-pill::after {
    right: -0.367em;
  }

  .c-cmp-pill__side {
    display: inline-flex;
    align-items: center;
    gap: 0.533em;
    padding: 0.667em 1.067em 0.533em;
    border: 0.5px solid var(--color-gray);
    border-radius: 3.6px;
  }
  /* Webflow box: the accent Eyebrow's border and 8% tint (Figma 3790:37352). */
  .c-cmp-pill__side.is-webflow {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  /* Competitor box: gray border, gray at 8% (Figma 3790:37355). */
  .c-cmp-pill__side.is-competitor {
    background: color-mix(in srgb, var(--color-gray) 8%, transparent);
  }

  .c-cmp-pill__logo {
    display: block;
    width: auto;
    max-width: none;
  }
  .c-cmp-pill__logo.is-webflow {
    height: 1.466em; /* 26.39px */
  }
  .c-cmp-pill__name {
    color: var(--color-black-secondary);
    font-size: 1.111em; /* 20px Paragraph. TODO: DS name fallback (no design). */
    white-space: nowrap;
  }

  /* "VS": Figma 18px, 1.152px tracking, uppercase, Black 800. */
  .c-cmp-pill__vs {
    align-self: center;
    letter-spacing: 0.064em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Chevron 15.27 × 8.84px, `--color-text` (ui handoff). */
  .c-cmp-pill__chevron {
    display: inline-flex;
    color: var(--color-text);
  }
  .c-cmp-pill__chevron :global(svg) {
    display: block;
    width: 0.848em;
    height: 0.491em;
  }

  /* Index card: the same pill at the card's scale (18px in a 543px card,
     Figma 3790:38001). The thumbnail is the size container. */
  .c-cmp-pill.is-card {
    font-size: 3.315cqi;
  }

  /* Phones: the hero pill keeps one line on a 375px screen. TODO: DS mobile (no mobile design). */
  @media (max-width: 767px) {
    .c-cmp-pill.is-hero {
      font-size: 1.35rem;
    }
  }
</style>
