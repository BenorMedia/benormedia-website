---
/**
 * ComparisonTable — side-by-side table (Figma 3790:37411): section header
 * (`tableHeader`) and a real `<table>`:
 *   - `<caption>`: the section title as plain text (visually hidden, the
 *     visible heading says the same);
 *   - `<thead>`: the gradient bar with the white logos, `<th scope="col">`
 *     per column (the first column's header is visually hidden);
 *   - one `<tbody>` per group: a gray label row (`<th scope="rowgroup"
 *     colspan="3">`), then one row per feature: `<th scope="row">` + the
 *     Webflow cell (check) + the competitor cell (dash).
 * The section's `id` is the target of the hero's second button.
 *
 * Logos: Webflow white fixed in code; competitor `competitorLogoOnDark`,
 * else `competitorLogo` whitened with a CSS filter (SCHEMAS v0.13, the
 * `CaseStudyLogo` approach), else the name in white.
 *
 * Never a scroll area (lead 2026-10-22). ≤767 (no mobile frame, Proposed):
 * each row restacks with CSS, the feature name full width above the
 * Webflow and competitor cells, which stay side by side; the header bar
 * becomes the same two columns, so the logos line up with their cells.
 * Explicit ARIA table roles keep the table semantics while `display`
 * changes.
 *
 * Spacing (lead 2026-10-22, "more compact"): Figma 3790:37411 values
 * scaled with the type (Figma 20px text → `c-paragraph`, ×0.728), so rows
 * keep Figma's proportions: bar 70px / 12px padding, 8px under the bar,
 * 12px between rows, 24px cell padding and 48px between columns, group
 * rows 24px padding.
 */
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import ComparisonSectionHeader from "./ComparisonSectionHeader.astro";
import ComparisonMark from "./ComparisonMark.astro";
import webflowWhite from "../../assets/comparison/logos/webflow-white.png";
import type { AccentSectionHeader, ComparisonTableGroup } from "../../lib/sanity/types";
import { accentTitleText } from "../../lib/sanity/portable-text";
import { altOr, logoBox, type ComparisonImageInput } from "./image";
import { COMPARISON_COPY, COMPARISON_TABLE_ID, WEBFLOW_NAME } from "./copy";

interface Props {
  header?: AccentSectionHeader | null | undefined;
  groups?: readonly ComparisonTableGroup[] | null | undefined;
  competitorName: string;
  competitorLogo?: ComparisonImageInput;
  competitorLogoOnDark?: ComparisonImageInput;
}

const { header, groups, competitorName, competitorLogo, competitorLogoOnDark } = Astro.props;

const items = (groups ?? [])
  .map((group) => ({
    key: group._key,
    label: group.label?.trim() ?? "",
    rows: (group.rows ?? []).filter((row) => row.feature?.trim()),
  }))
  .filter((group) => group.rows.length > 0);

const title = accentTitleText(header?.title);
const caption = title.replace(/\s+/g, " ") || `${WEBFLOW_NAME} vs ${competitorName}`;
// Figma: Webflow white 167.24 × 30; WordPress white about 160.8 × 36.5.
const darkLogo = competitorLogoOnDark && (competitorLogoOnDark.previewSrc || competitorLogoOnDark.asset) ? competitorLogoOnDark : null;
const logoSource = darkLogo ?? competitorLogo;
const logo = logoBox(logoSource, altOr(logoSource, competitorName), { minHeight: 26, maxHeight: 36.5 });
const whiten = !darkLogo;
---

{(title || items.length > 0) && (
  <section class="c-cmp-table" id={COMPARISON_TABLE_ID}>
    <Container>
      <ComparisonSectionHeader header={header} titleWidth="43.3rem" descriptionWidth="35.2rem" />
      {items.length > 0 && (
        <div class="c-cmp-table__wrap">
          <table class="c-cmp-table__table" role="table">
            <caption class="c-cmp-table__sr-only">{caption}</caption>
            <thead role="rowgroup">
              <tr class="c-cmp-table__head" role="row">
                <th scope="col" role="columnheader" class="c-cmp-table__head-cell is-feature"><span class="c-cmp-table__sr-only">{COMPARISON_COPY.tableFeature}</span></th>
                <th scope="col" role="columnheader" class="c-cmp-table__head-cell">
                  <Image class="c-cmp-table__logo is-webflow" src={webflowWhite} alt={WEBFLOW_NAME} width={167} height={30} densities={[1, 2]} loading="lazy" />
                </th>
                <th scope="col" role="columnheader" class="c-cmp-table__head-cell">
                  {logo ? (
                    <img
                      class={["c-cmp-table__logo", whiten && "is-whiten"].filter(Boolean).join(" ")}
                      src={logo.src}
                      width={Math.round(logo.width)}
                      height={Math.round(logo.height)}
                      alt={logo.alt}
                      style={`--c-cmp-table-logo-h: ${Math.round((logo.height / 30) * 1000) / 1000};`}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="c-cmp-table__logo-name c-paragraph">{competitorName}</span>
                  )}
                </th>
              </tr>
            </thead>
            {items.map((group) => (
              <tbody class="c-cmp-table__group" role="rowgroup">
                {group.label && (
                  <tr class="c-cmp-table__label-row" role="row">
                    <th scope="rowgroup" colspan="3" role="rowheader" class="c-cmp-table__group-label">
                      <span class="c-cmp-table__group-box c-paragraph_s">{group.label}</span>
                    </th>
                  </tr>
                )}
                {group.rows.map((row) => (
                  <tr class="c-cmp-table__row" role="row">
                    <th scope="row" role="rowheader" class="c-cmp-table__feature c-paragraph">{row.feature}</th>
                    <td role="cell" class="c-cmp-table__cell c-paragraph">
                      <span class="c-cmp-table__value"><ComparisonMark kind="check" />{row.webflow}</span>
                    </td>
                    <td role="cell" class="c-cmp-table__cell c-paragraph">
                      <span class="c-cmp-table__value"><ComparisonMark kind="dash" />{row.competitor}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      )}
    </Container>
  </section>
)}

<style>
  .c-cmp-table {
    /* Figma px × 0.728 (20px Figma text = `c-paragraph`) → rem. TODO: DS */
    --c-cmp-table-pad: 1.248rem;  /* 24px cell / group padding */
    --c-cmp-table-gap: 0.624rem;  /* 12px between rows */
    --c-cmp-table-head-gap: 0.416rem; /* 8px under the header bar */
    background: var(--color-white);
    /* Hero "View comparison" anchor: clear the sticky nav. TODO: DS */
    scroll-margin-top: 6.571rem;
  }
  /* Figma: 110px above and below. */
  .c-cmp-table :global(.c-container) {
    padding-top: 7.857rem;
    padding-bottom: 7.857rem;
  }
  /* Header → table 60px. Not a scroll area at any width. */
  .c-cmp-table__wrap {
    margin-top: 4.286rem;
  }
  .c-cmp-table__table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    border-spacing: 0;
  }

  /* Header bar (Figma 3790:37421): 70px, 12px padding, 8px radius, one
     gradient across the three cells (each shows its third). */
  .c-cmp-table__head-cell {
    width: 33.333%;
    height: 3.64rem;
    padding: 0.437rem var(--c-cmp-table-pad);
    background: var(--gradient-primary);
    background-size: 300% 100%;
    text-align: left;
    vertical-align: middle;
  }
  .c-cmp-table__head-cell:nth-child(1) {
    border-radius: 8px 0 0 8px;
    background-position: 0 0;
  }
  .c-cmp-table__head-cell:nth-child(2) {
    background-position: 50% 0;
  }
  .c-cmp-table__head-cell:nth-child(3) {
    border-radius: 0 8px 8px 0;
    background-position: 100% 0;
  }
  /* Logos: Webflow white 30px tall (×0.728); the competitor's height is
     relative to it (`--c-cmp-table-logo-h`, from the file). */
  .c-cmp-table__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: calc(1.56rem * var(--c-cmp-table-logo-h, 1));
  }
  .c-cmp-table__logo.is-webflow {
    height: 1.56rem;
  }
  .c-cmp-table__logo.is-whiten {
    filter: brightness(0) invert(1);
  }
  .c-cmp-table__logo-name {
    color: var(--color-white);
  }

  /* Group label row (Figma 3790:37425): half a row gap above and below,
     8px under the header bar. Box: #FAFAFA (Grey 400, no token; closest
     `--color-gray-light` #F0F0F0 until the lead picks a token, TODO: DS),
     8px radius, 24px padding; Acumin Semibold 18px uppercase, 1.152px
     tracking, Black 800 (18px beside 20px rows → `c-paragraph_s`, TODO:
     DS). Semibold (600) is not in the kit (400 / 700): 700, TODO: DS. */
  .c-cmp-table__group-label {
    padding: calc(var(--c-cmp-table-gap) / 2) 0;
    text-align: left;
    font-weight: inherit;
  }
  .c-cmp-table__group:first-of-type .c-cmp-table__label-row > .c-cmp-table__group-label {
    padding-top: var(--c-cmp-table-head-gap);
  }
  .c-cmp-table__group-box {
    display: block;
    padding: var(--c-cmp-table-pad);
    border-radius: 8px;
    background: var(--color-gray-light); /* TODO: DS Figma #FAFAFA */
    color: var(--color-text);
    font-weight: 700; /* Figma Semibold 600, not in the kit. TODO: DS */
    line-height: normal;
    letter-spacing: 0.064em;
    text-transform: uppercase;
  }

  /* Feature rows: 24px padding plus half the 12px row gap above and below;
     48px between columns = 24px on each side of a cell. */
  .c-cmp-table__feature,
  .c-cmp-table__cell {
    padding: calc(var(--c-cmp-table-pad) + var(--c-cmp-table-gap) / 2) var(--c-cmp-table-pad);
    vertical-align: middle;
    text-align: left;
  }
  /* Figma Text 600: Acumin Medium 20px, Black 500. */
  .c-cmp-table__feature {
    color: var(--color-black-secondary);
    font-weight: 400; /* Figma Medium 500, not in the kit (400 / 700): closest 400. TODO: DS */
    line-height: normal;
  }
  /* Figma Paragraph, Black 500 at 65%, 8px icon → text. */
  .c-cmp-table__value {
    display: flex;
    align-items: flex-start;
    gap: 0.571rem;
    color: color-mix(in srgb, var(--color-black-secondary) 65%, transparent);
  }
  .c-cmp-table__value :global(.c-cmp-mark) {
    margin-top: calc((1.5em - 1.714rem) / 2);
  }

  .c-cmp-table__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ≤767 (no mobile frame, Proposed): rows restack. The header bar and each
     row become two equal columns (Webflow | competitor); the feature name
     sits full width above its two cells; the hidden "Feature" header
     leaves the grid. TODO: DS mobile. */
  @media (max-width: 767px) {
    .c-cmp-table :global(.c-container) {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .c-cmp-table__wrap {
      margin-top: 3rem;
    }
    .c-cmp-table__table,
    .c-cmp-table__table thead,
    .c-cmp-table__table tbody {
      display: block;
    }
    .c-cmp-table__head,
    .c-cmp-table__row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .c-cmp-table__label-row {
      display: block;
    }
    .c-cmp-table__head {
      border-radius: 8px;
      background: var(--gradient-primary);
    }
    .c-cmp-table__head-cell {
      width: auto;
      height: 4.5rem;
      padding: 0.75rem 1.25rem;
      background: none;
      border-radius: 0;
    }
    .c-cmp-table__head-cell.is-feature {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .c-cmp-table__logo.is-webflow {
      height: 2rem;
    }
    .c-cmp-table__logo {
      height: calc(2rem * var(--c-cmp-table-logo-h, 1));
    }
    .c-cmp-table__group-label {
      display: block;
      padding: 0.5rem 0;
    }
    .c-cmp-table__group:first-of-type .c-cmp-table__label-row > .c-cmp-table__group-label {
      padding-top: 0.5rem;
    }
    .c-cmp-table__group-box {
      padding: 1.25rem;
    }
    .c-cmp-table__feature {
      grid-column: 1 / -1;
      padding: 1.25rem 1.25rem 0.5rem;
    }
    .c-cmp-table__cell {
      padding: 0.5rem 1.25rem 1.25rem;
      vertical-align: top;
    }
  }
</style>
