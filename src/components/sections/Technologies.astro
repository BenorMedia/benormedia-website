---
/**
 * Technologies — Home "Technologies" section.
 *
 * Section header + diagram (tool categories → BenorMedia mark →
 * capabilities). On desktop the image is rebuilt inline and animated
 * (squares along the lines, looping capability rows): see
 * src/scripts/animations/tech-diagram.ts, hooked on `data-anim="tech-diagram"`.
 *
 * `/images/home/technologies.svg` is an optimized copy of
 * `docs/refs/technologies-image.svg` (embedded bitmaps downscaled to WebP;
 * vectors untouched) — 20 MB → ~0.4 MB. Its lines, squares and rows are
 * grouped with `tech-` ids for the animation (same drawing).
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
---

<section class="c-tech">
  <Container>
    <SectionHeader
      eyebrow="Technologies"
      title={"We deal with everything,\nso you don’t have to."}
      class="c-tech__header"
    />

    <!-- ≤767: dedicated mobile diagram (lead 2026-10-16: new artwork,
         WebP 968w; was 1125w / 1536w, QA S5 2026-09-30); desktop keeps
         the SVG. -->
    <picture class="c-tech__diagram">
      <source
        media="(max-width: 767px)"
        srcset="/images/home/technologies-mobile.webp 968w"
        sizes="100vw"
        type="image/webp"
        width="968"
        height="1719"
      />
      <img
        src="/images/home/technologies.svg"
        alt="Diagram: tools for web design and development, CRM and API integrations, SEO / GEO / AEO, CRO optimization, and CMS integrations and migrations connect through BenorMedia into capabilities such as scalable CMS structure, web design and development systems, custom API and CRM integrations, accessibility, GDPR and CCPA, content creation, and CRO, SEO and AEO / GEO analytics."
        width="1680"
        height="1107"
        loading="lazy"
        decoding="async"
        data-anim="tech-diagram"
      />
    </picture>
  </Container>
</section>

<style>
  .c-tech {
    background: var(--color-white);
  }

  .c-tech__diagram {
    display: block;
    /* TODO: DS space between section header and content. */
    margin-top: 3rem;
  }
  /* Mobile: the diagram spans the whole screen width, outside the
     container's side padding; the header stays in the container (lead
     2026-10-01). Negative margins = the container's mobile side padding
     (utilities.css, 2rem); `100vw` was wider than the page when a scrollbar
     takes space, which cut the image on the right. `max-width: none`
     lifts base.css's `picture { max-width: 100% }`, which otherwise kept
     the box at the content width (shifted left, short on the right). */
  @media (max-width: 767px) {
    .c-tech__diagram {
      max-width: none;
      margin-inline: -2rem;
    }
  }

  /* Full width, natural height: both diagrams show every label. */
  .c-tech__diagram img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Animated diagram (tech-diagram.ts, ≥768 only): built by JS, so the
     classes are global. Same box as the image it replaces. */
  .c-tech__diagram.is-replaced {
    display: none;
  }
  .c-tech :global(.c-tech__live) {
    position: relative;
    overflow: hidden;
    /* TODO: DS space between section header and content. */
    margin-top: 3rem;
  }
  .c-tech :global(.c-tech__live > svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .c-tech :global(.c-tech__squares) {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .c-tech :global(.c-tech__live > .c-tech__row) {
    position: absolute;
    /* Wider than the box (row + its copy); base.css caps svg at 100%. */
    max-width: none;
    will-change: transform;
    animation: c-tech-row var(--tech-duration) linear infinite;
  }
  .c-tech :global(.c-tech__row.is-reverse) {
    animation-direction: reverse;
  }
  .c-tech :global(.c-tech__live.is-paused > .c-tech__row) {
    animation-play-state: paused;
  }

  @keyframes c-tech-row {
    to {
      transform: translateX(var(--tech-shift));
    }
  }
</style>
