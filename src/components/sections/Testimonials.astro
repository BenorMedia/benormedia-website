---
/**
 * Testimonials — Home "Testimonials" section.
 *
 * Section header + `TestimonialSlider` (expanding-card slider, Figma
 * 4227:6140; replaced the two-row marquee 2026-11-04). The slider sits in
 * the container. Data: `getTestimonials()` in the page.
 *
 * Shown on every page that renders it (lead 2026-11-04; hidden from
 * 2026-09-30 while production shipped without testimonials).
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import TestimonialSlider from "../ui/TestimonialSlider.astro";
import type { Testimonial } from "../../lib/sanity/types";

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

{testimonials.length > 0 && (
<section class="c-testimonials">
  <Container class="cc-tp_0">
    <SectionHeader
      eyebrow="Testimonials"
      title="Hear from our clients."
      description="What marketing leaders say after launch day, and years into working together."
      class="c-testimonials__header"
    />

    <TestimonialSlider testimonials={testimonials} class="c-testimonials__slider" />
  </Container>
</section>
)}

<style>
  .c-testimonials {
    /* Decorative lines image removed (lead 2026-11-05). */
    background: var(--color-white);
    /* Clip the full-bleed marquee (100vw includes the scrollbar). */
    overflow-x: clip;
  }

  /* Subtitle constraint — every Testimonials section (lead 2026-09-30).
     Mobile: full width, like the Services / Technologies headers. */
  .c-testimonials :global(.c-testimonials__header .c-section-header__description) {
    max-width: 28%;
  }

  /* Tablet + mobile: full width (lead 2026-09-30, QA Q6 — the % width came
     out at ≈190–300px at 768–991). */
  @media (max-width: 991px) {
    .c-testimonials :global(.c-testimonials__header .c-section-header__description) {
      max-width: 100%;
    }
  }

  /* Header → arrows: 40px (Figma 4227:6427). */
  .c-testimonials :global(.c-testimonials__slider) {
    margin-top: 2.083rem;
  }
</style>
