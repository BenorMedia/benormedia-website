---
/**
 * AboutTeam — /about "Our team." (Figma 4145:15247): a four-column grid of
 * member cards (photo, name, role, arrow) and a closing "Want to join the
 * team?" card whose button opens the contact modal.
 *
 * Members come from `authors.ts` (names and the lead's team titles), each
 * card linking to the member's author page (the whole card is the link).
 * Hover (lead 2026-11-03: "same as all the other cards"): ClientCard's,
 * the lift, accent border and shadow, the arrow turning -30.963° in accent.
 *
 * Photos: the lead's card photos (2026-11-03, `/images/about/team/`), the
 * ring lines drawn in; transparent, so the card's glow shows through.
 *
 * Art in Figma px (`--u`, as Services): the blue glow behind every card,
 * a second small glow on the 2nd and 4th columns, and on the join card the
 * Services Support icons and people (`/images/home/services/support-*`).
 *
 * ≤991: two columns; ≤767: one (no tablet or mobile design, TODO: DS).
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import { ARROW_RIGHT } from "../new-pages/blog-icons";
import type { TeamMember } from "../../lib/content/about";

interface Props {
  eyebrow: string;
  title: string;
  members: readonly TeamMember[];
  join: { title: string; body: string; button: string };
}

const { eyebrow, title, members, join } = Astro.props;

const SVC = "/images/home/services";

/** A piece by its centre: x from the card's left (or right with `right`),
 *  y from its top, size, rotation and Figma's image crop (%). */
interface Piece {
  src: string;
  x: number;
  y: number;
  w: number;
  h: number;
  r?: number;
  right?: boolean;
  crop?: readonly [number, number, number, number];
}
const pieceStyle = (p: Piece): string =>
  [
    `--x:${p.x}`, `--y:${p.y}`, `--w:${p.w}`, `--h:${p.h}`, `--r:${p.r ?? 0}deg`,
    ...(p.crop ? [`--cw:${p.crop[0]}%`, `--ch:${p.crop[1]}%`, `--cl:${p.crop[2]}%`, `--ct:${p.crop[3]}%`] : []),
  ].join(";");

// Figma "Frame 2147237499" (every card) and "Frame 2147237501" (columns 2, 4).
const GLOW: Piece = { src: `${SVC}/blob-a.svg`, x: -73.5, y: 113.2, w: 681.88, h: 771.27, right: true };
const SMALL_GLOW: Record<number, Piece> = {
  1: { src: "/images/about/blob-c.svg", x: 52.76, y: 565.07, w: 409.13, h: 462.77 },
  3: { src: "/images/about/blob-c.svg", x: 328.76, y: 455.53, w: 409.13, h: 462.77 },
};
const JOIN_ICONS: Piece[] = [
  { src: `${SVC}/support-pencil.webp`, x: -1.21, y: 361.09, w: 87.8, h: 75.044, r: -4.74 },
  { src: `${SVC}/support-shield.webp`, x: 167.49, y: 352.51, w: 103, h: 111.339, r: 5.16 },
  { src: `${SVC}/support-code.webp`, x: 228.53, y: 484.99, w: 87.8, h: 80.598, r: -11.77, crop: [145.71, 158.73, -22.85, -29.36] },
  { src: `${SVC}/support-palette.webp`, x: 381.18, y: 402.97, w: 100, h: 112.685, r: -17.15, crop: [162.04, 143.8, -31.02, -27.05] },
];
const JOIN_PEOPLE: Piece = {
  src: `${SVC}/support-people.webp`, x: 198.75, y: 543.04, w: 434.08, h: 446.09, crop: [141.54, 137.73, -21.01, -22.3],
};

---

<section class="c-about-team">
  <Container>
    <SectionHeader eyebrow={eyebrow} title={title} />

    <div class="c-about-team__grid">
      {members.map((m, i) => (
        <article class="c-about-team__card">
          <div class="c-about-team__media" aria-hidden="true">
            <img class:list={["c-about-team__art", { "is-right": GLOW.right }]} style={pieceStyle(GLOW)} src={GLOW.src} alt="" loading="lazy" decoding="async" />
            {SMALL_GLOW[i % 4] && (
              <img class="c-about-team__art" style={pieceStyle(SMALL_GLOW[i % 4]!)} src={SMALL_GLOW[i % 4]!.src} alt="" loading="lazy" decoding="async" />
            )}
          </div>
          <div class="c-about-team__photo">
            <img src={m.photo} width="396" height="438" alt={m.name} loading="lazy" decoding="async" />
          </div>
          <div class="c-about-team__body">
            <h3 class="c-about-team__name c-text_m">
              <a class="c-about-team__link" href={m.href}>{m.name}</a>
            </h3>
            <p class="c-about-team__role c-paragraph">{m.role}</p>
            <span class="c-about-team__arrow" set:html={ARROW_RIGHT} />
          </div>
        </article>
      ))}

      <article class="c-about-team__card is-join">
        <div class="c-about-team__media" aria-hidden="true">
          {JOIN_ICONS.map((p) => (
            <span class:list={["c-about-team__art", { "is-crop": !!p.crop }]} style={pieceStyle(p)}>
              <img src={p.src} alt="" loading="lazy" decoding="async" />
            </span>
          ))}
          <img class="c-about-team__art is-right" style={pieceStyle(GLOW)} src={GLOW.src} alt="" loading="lazy" decoding="async" />
          <span class="c-about-team__art is-crop" style={pieceStyle(JOIN_PEOPLE)}>
            <img src={JOIN_PEOPLE.src} alt="" loading="lazy" decoding="async" />
          </span>
        </div>
        <div class="c-about-team__join">
          <h3 class="c-about-team__name c-text_m">{join.title}</h3>
          <p class="c-about-team__role c-paragraph">{join.body}</p>
          <Button variant="gradient" class="c-about-team__button js-open-contact">{join.button}</Button>
        </div>
      </article>
    </div>
  </Container>
</section>

<style>
  .c-about-team {
    --u: calc(1rem / 19.2);
    background: var(--color-white);
  }

  .c-about-team__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(30 * var(--u));
    margin-top: calc(40 * var(--u));
  }
  @media (max-width: 991px) {
    .c-about-team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .c-about-team__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      margin-top: 3rem;
    }
  }

  /* --- Card --------------------------------------------------------------- */
  .c-about-team__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: calc(563.66 * var(--u));
    overflow: hidden;
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-white);
    transition:
      transform var(--duration-hover) var(--ease-smooth),
      border-color var(--duration-hover) var(--ease-smooth),
      box-shadow var(--duration-hover) var(--ease-smooth);
  }
  /* ClientCard's hover. Member cards only: the join card is not a link. */
  @media (hover: hover) and (min-width: 768px) {
    .c-about-team__card:not(.is-join):hover {
      transform: translateY(-3%);
      border-color: var(--color-accent);
      box-shadow: 0 0 20px color-mix(in srgb, var(--color-black-secondary) 14%, transparent);
    }
  }
  .c-about-team__card:has(.c-about-team__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .c-about-team__photo {
    height: calc(437.66 * var(--u));
  }
  /* ≤991 the cards are wider than Figma's 396 px column: keep the photo's
     own 396 × 438 ratio so the head is not cropped. */
  @media (max-width: 991px) {
    .c-about-team__card {
      min-height: 0;
    }
    .c-about-team__photo {
      height: auto;
      aspect-ratio: 396 / 438;
    }
  }
  .c-about-team__photo img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 0%;
  }

  .c-about-team__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
    padding: calc(20 * var(--u)) calc(62 * var(--u)) calc(20 * var(--u)) calc(20 * var(--u));
  }
  .c-about-team__name {
    margin: 0;
    color: var(--color-black-secondary);
  }
  .c-about-team__role {
    margin: 0;
    color: var(--color-text);
  }
  .c-about-team__link {
    color: inherit;
    text-decoration: none;
  }
  .c-about-team__link:focus-visible {
    outline: none;
  }
  /* The whole card is the hit area. */
  .c-about-team__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .c-about-team__card:has(.c-about-team__link) .c-about-team__body {
    position: static;
  }

  /* The site's arrow, centred in Figma's 62.49 × 63.16 box. */
  .c-about-team__arrow {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(62.49 * var(--u));
    height: calc(63.16 * var(--u));
    color: var(--color-text);
    transition:
      transform var(--duration-hover) var(--ease-smooth),
      color var(--duration-hover) var(--ease-smooth);
  }
  .c-about-team__arrow :global(svg) {
    display: block;
    width: calc(22.49 * var(--u));
    height: calc(23.16 * var(--u));
  }
  @media (hover: hover) and (min-width: 768px) {
    .c-about-team__card:not(.is-join):hover .c-about-team__arrow {
      transform: rotate(-30.963deg);
      color: var(--color-accent);
    }
  }

  /* --- Join card ---------------------------------------------------------- */
  .c-about-team__join {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(8 * var(--u));
    padding: calc(40 * var(--u)) calc(16 * var(--u)) 0;
    text-align: center;
  }
  .c-about-team__join .c-about-team__role {
    max-width: calc(370 * var(--u));
  }
  .c-about-team__join :global(.c-about-team__button) {
    margin-top: calc(12 * var(--u));
  }
  @media (max-width: 767px) {
    .c-about-team__card.is-join {
      min-height: calc(600 * var(--u));
    }
  }

  /* --- Artwork ------------------------------------------------------------ */
  .c-about-team__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .c-about-team__art {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    max-width: none;
    transform: translate(-50%, -50%) rotate(var(--r));
  }
  /* ≤991 the join card is wider than Figma's 396 px: centre its art. */
  @media (max-width: 991px) {
    .c-about-team__card.is-join .c-about-team__art:not(.is-right) {
      left: calc(50% + (var(--x) - 198) * var(--u));
    }
  }
  .c-about-team__art.is-right {
    left: calc(100% + var(--x) * var(--u));
  }
  .c-about-team__art > img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .c-about-team__art.is-crop {
    overflow: hidden;
  }
  .c-about-team__art.is-crop > img {
    position: absolute;
    left: var(--cl);
    top: var(--ct);
    width: var(--cw);
    height: var(--ch);
  }
</style>
