---
/**
 * ServiceProcess — "Process" section of the service template.
 * Figma: BenorMedia › Process Section (4301:10711). Behaviour reference
 * (lead 2026-11-10): usevitrum.com, "From flat SVG to finished 3D asset".
 * Sizes are Figma px through `--u` (1/19.2 rem: the 1920 frame fills the
 * viewport, as Services / About / CTA).
 *
 * Header: shared `SectionHeader` — eyebrow "Process", `processTitle`
 * (accentTitle segments), `processDescription` (`\n` = line break).
 *
 * Box: two columns inside a rounded white frame.
 *   - Left: an isometric stack, one layer per step (max 7, lead 2026-11-10),
 *     each with a numbered marker. The active step's layer turns blue and
 *     lifts; the others stay grey. Decorative (aria-hidden): the list says
 *     the same thing. Art: `public/images/services/process/layer.svg` and
 *     `layer-active.svg`, the Figma layers' own vectors (markers are HTML so
 *     the numbers follow the step order).
 *   - Right: a numbered list. Each step is a disclosure button (number +
 *     name). The active step opens on a grey card with its description,
 *     optional note and feature pills, and a progress ring around its number.
 *   - Autoplay: the ring fills over `--c-service-process-duration`, then the
 *     next step opens (looping). It waits until the box is on screen, pauses
 *     while hovered or focused, and stops for good once the visitor picks a
 *     step. No autoplay with reduced motion (the ring just shows full).
 *   - Keys: Up / Down / Home / End move between the step buttons.
 *   - No JS: every step is open and readable; the stack shows step 1.
 *   - Mobile ≤767: one column, the stack above the list, smaller. No mobile
 *     design yet. TODO: DS mobile.
 *   - 1 step: no autoplay. 0 steps: header only. No title and no steps: the
 *     section is not rendered.
 *
 * The step `image` field is no longer shown (the stack replaces it).
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import type { ProcessStep } from "../../lib/sanity/types";
import { linkRuns, type TitleSegment } from "../../lib/sanity/portable-text";

interface Props {
  /** Plain title (`\n` = line break). Empty = no title. */
  title: string;
  titleSegments?: readonly TitleSegment[];
  description?: string | null | undefined;
  steps: readonly ProcessStep[];
  /** Id prefix for the step buttons / bodies (unique per page). */
  id?: string;
}

const { title, titleSegments, description, steps, id = "process-step" } = Astro.props;

/** The stack is drawn for at most 7 layers (lead 2026-11-10). */
const MAX_STEPS = 7;

const named = steps.filter((step) => step.name?.trim());
if (named.length > MAX_STEPS) {
  console.warn(
    `[ServiceProcess] ${named.length} steps for "${title.trim() || id}": only the first ${MAX_STEPS} are shown. Trim the list in Sanity.`,
  );
}

const items = named.slice(0, MAX_STEPS).map((step, i) => {
  const num = String(i + 1);
  return {
    key: step._key,
    num,
    name: step.name.trim(),
    description: step.description?.trim() || null,
    note: linkRuns(step.note),
    features: (step.features ?? []).map((f) => f.trim()).filter(Boolean),
    buttonId: `${id}-${num}`,
    bodyId: `${id}-${num}-body`,
  };
});

const hasTitle = title.trim().length > 0;
const shouldRender = hasTitle || items.length > 0;
const gradientId = `${id}-ring-gradient`;

const headerOptional = {
  ...(titleSegments !== undefined && { titleSegments }),
  ...(description?.trim() ? { description: description.trim() } : {}),
};
---

{shouldRender && (
  <section class="c-service-process" data-service-process>
    <Container>
      {hasTitle && <SectionHeader eyebrow="Process" title={title} {...headerOptional} />}

      {items.length > 0 && (
        <div class="c-service-process__box" style={`--c-service-process-count: ${items.length}`}>
          <div class="c-service-process__visual" aria-hidden="true">
            <div class="c-service-process__stack">
              {items.map((item, i) => (
                <div
                  class={["c-service-process__layer", i === 0 && "is-active"].filter(Boolean).join(" ")}
                  style={`--c-service-process-i: ${i}`}
                >
                  <img
                    class="c-service-process__layer-art"
                    src="/images/services/process/layer.svg"
                    width="300"
                    height="180"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <img
                    class="c-service-process__layer-art is-active-art"
                    src="/images/services/process/layer-active.svg"
                    width="401"
                    height="227"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="c-service-process__marker-line"></span>
                  <span class="c-service-process__marker">{item.num}</span>
                </div>
              ))}
            </div>
          </div>

          <ol class="c-service-process__steps">
            {items.map((item, i) => (
              <li class={["c-service-process__step", i === 0 && "is-active"].filter(Boolean).join(" ")}>
                <button
                  type="button"
                  id={item.buttonId}
                  class="c-service-process__step-head"
                  aria-expanded={i === 0 ? "true" : "false"}
                  aria-controls={item.bodyId}
                >
                  <span class="c-service-process__num c-paragraph_s">
                    <svg
                      class="c-service-process__ring"
                      width="47"
                      height="47"
                      viewBox="0 0 46.8276 46.8276"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        class="c-service-process__ring-track"
                        d="M23.4138 45.5937C35.6643 45.5937 45.5953 35.6627 45.5953 23.4122C45.5953 11.1617 35.6643 1.23069 23.4138 1.23069C11.1634 1.23069 1.23236 11.1617 1.23236 23.4122C1.23236 35.6627 11.1634 45.5937 23.4138 45.5937Z"
                        stroke-width="1.54038"
                      />
                      <path
                        class="c-service-process__ring-progress"
                        d="M23.4138 45.5937C35.6643 45.5937 45.5953 35.6627 45.5953 23.4122C45.5953 11.1617 35.6643 1.23069 23.4138 1.23069C11.1634 1.23069 1.23236 11.1617 1.23236 23.4122C1.23236 35.6627 11.1634 45.5937 23.4138 45.5937Z"
                        stroke={`url(#${gradientId})`}
                        stroke-width="1.54038"
                        stroke-linecap="round"
                        pathLength="1"
                      />
                      <defs>
                        <linearGradient id={gradientId} x1="1.23236" y1="6.96091" x2="50.7999" y2="21.197" gradientUnits="userSpaceOnUse">
                          <stop class="c-service-process__ring-stop-start" />
                          <stop class="c-service-process__ring-stop-end" offset="1" />
                        </linearGradient>
                      </defs>
                    </svg>
                    <span class="c-service-process__num-text">{item.num}</span>
                  </span>
                  <span class="c-service-process__step-name c-paragraph_m">{item.name}</span>
                </button>

                <div id={item.bodyId} class="c-service-process__step-body" role="region" aria-labelledby={item.buttonId}>
                  <div class="c-service-process__step-body-inner">
                    {(item.description || item.note.length > 0) && (
                      <div class="c-service-process__step-text">
                        {item.description && (
                          <p class="c-service-process__step-description c-paragraph">{item.description}</p>
                        )}
                        {item.note.length > 0 && (
                          <p class="c-service-process__step-note c-paragraph">
                            {item.note.map((run) => (run.href ? <a href={run.href}>{run.text}</a> : run.text))}
                          </p>
                        )}
                      </div>
                    )}
                    {item.features.length > 0 && (
                      <ul class="c-service-process__features">
                        {item.features.map((feature) => (
                          <li class="c-service-process__feature">{feature}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      )}
    </Container>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-service-process]").forEach((section) => {
    const box = section.querySelector<HTMLElement>(".c-service-process__box");
    if (!box) return;
    const steps = Array.from(box.querySelectorAll<HTMLElement>(".c-service-process__step"));
    const layers = Array.from(box.querySelectorAll<HTMLElement>(".c-service-process__layer"));
    const buttons = steps.map((step) => step.querySelector<HTMLButtonElement>(".c-service-process__step-head"));
    const bodies = steps.map((step) => step.querySelector<HTMLElement>(".c-service-process__step-body"));
    if (steps.length === 0) return;

    let active = 0;
    const select = (index: number): void => {
      active = (index + steps.length) % steps.length;
      steps.forEach((step, i) => {
        const on = i === active;
        step.classList.toggle("is-active", on);
        layers[i]?.classList.toggle("is-active", on);
        buttons[i]?.setAttribute("aria-expanded", String(on));
        bodies[i]?.toggleAttribute("inert", !on);
      });
    };
    select(0);
    section.classList.add("is-enhanced");

    // Autoplay: the active ring's CSS animation sets the pace; its end opens
    // the next step.
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let autoplay = steps.length > 1 && !reduced;
    let visible = false;
    let hovered = false;
    let focused = false;
    const sync = (): void => {
      section.classList.toggle("is-autoplay", autoplay);
      section.classList.toggle("is-paused", !visible || hovered || focused);
    };
    const stop = (): void => {
      autoplay = false;
      sync();
    };
    sync();

    if (autoplay) {
      box.addEventListener("animationend", (event) => {
        if (!autoplay) return;
        const target = event.target as Element | null;
        if (!target?.classList.contains("c-service-process__ring-progress")) return;
        select(active + 1);
      });
      new IntersectionObserver(
        ([entry]) => {
          visible = entry?.isIntersecting ?? false;
          sync();
        },
        { threshold: 0.35 },
      ).observe(box);
      box.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") hovered = true;
        sync();
      });
      box.addEventListener("pointerleave", () => {
        hovered = false;
        sync();
      });
      box.addEventListener("focusin", () => {
        focused = true;
        sync();
      });
      box.addEventListener("focusout", (event) => {
        if (!box.contains(event.relatedTarget as Node | null)) focused = false;
        sync();
      });
    }

    buttons.forEach((button, i) => {
      button?.addEventListener("click", () => {
        stop();
        select(i);
      });
      button?.addEventListener("keydown", (event) => {
        const last = buttons.length - 1;
        const to =
          event.key === "ArrowDown" ? (i + 1) % buttons.length
          : event.key === "ArrowUp" ? (i - 1 + buttons.length) % buttons.length
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : -1;
        if (to < 0) return;
        event.preventDefault();
        buttons[to]?.focus();
      });
    });
  });
</script>

<style>
  .c-service-process {
    /* 1 Figma px (1920 frame). */
    --u: calc(1rem / 19.2);
    /* Stack px: same scale as the frame on desktop. */
    --s: var(--u);
    /* Time each step stays open while autoplaying. TODO: DS (no spec;
       lead may tune). */
    --c-service-process-duration: 6s;
    /* Figma #F9F9F9 (active step) / #F2F3F6 (visual panel top): no tokens
       yet. TODO: DS */
    --c-service-process-surface: #F9F9F9;
    --c-service-process-panel: #F2F3F6;

    position: relative;
    overflow: clip;
    background: var(--color-white);
  }

  /* Line art behind the box sides (Figma 4301:10712, 1920 × 747 at 62%;
     same art as the service hero, `service-mid-hero-bg.webp`, which already
     carries that opacity). */
  .c-service-process::before {
    content: "";
    position: absolute;
    top: calc(460 * var(--u));
    left: 50%;
    width: calc(1920 * var(--u));
    height: calc(747 * var(--u));
    transform: translateX(-50%);
    background-image: url("/images/services/service-mid-hero-bg.webp");
    background-image: image-set(
      url("/images/services/service-mid-hero-bg.webp") 1x,
      url("/images/services/service-mid-hero-bg@2x.webp") 2x
    );
    background-repeat: no-repeat;
    background-size: 100% auto;
    pointer-events: none;
  }

  .c-service-process :global(.c-container) {
    position: relative;
    /* Problem border → eyebrow ≈ 110px, box → next section ≈ 90px in the
       ref. TODO: DS section spacing. */
    padding-top: 7.857rem;
    padding-bottom: 6.429rem;
  }

  /* Description width in this section only: 48% (lead 2026-10-01; was 50%);
     full width on phones. */
  .c-service-process :global(.c-section-header__description) {
    max-width: 48%;
  }

  /* --- Box (Figma 4301:11002) --------------------------------------------- */
  .c-service-process__box {
    display: flex;
    align-items: stretch;
    max-width: calc(1478 * var(--u));
    margin: calc(60 * var(--u)) auto 0;
    padding: calc(9.858 * var(--u));
    border: var(--border-default);
    border-radius: 30px;
    background: var(--color-white);
  }

  /* --- Visual panel + stack ----------------------------------------------- */
  .c-service-process__visual {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    place-items: center;
    padding: calc(49.292 * var(--u)) calc(39.434 * var(--u));
    border-radius: 20px;
    background:
      radial-gradient(90% 70% at 50% 0%, var(--color-white) 0%, transparent 70%),
      linear-gradient(180deg, var(--c-service-process-panel) 0%, var(--c-service-process-surface) 100%);
    /* Figma: inset 0 0 0 1.232px rgba(38,40,46,.08), inset 0 1.232px 0 #fff. */
    box-shadow:
      inset 0 0 0 1px rgba(38, 40, 46, 0.08),
      inset 0 1px 0 var(--color-white);
    overflow: hidden;
  }

  /* 373 wide; layers every 87.54px, each plate 178.2 tall (Figma stack). */
  .c-service-process__stack {
    position: relative;
    width: calc(373 * var(--s));
    height: calc(((var(--c-service-process-count) - 1) * 87.54 + 178.2) * var(--s));
  }

  /* One layer: its box starts at the plate's top corner. Upper layers sit in
     front (as in Figma). */
  .c-service-process__layer {
    position: absolute;
    top: calc(var(--c-service-process-i) * 87.54 * var(--s));
    left: 0;
    width: 100%;
    height: calc(178.2 * var(--s));
    z-index: calc(var(--c-service-process-count) - var(--c-service-process-i));
    transition: transform var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__layer.is-active {
    transform: translateY(calc(-6 * var(--s)));
  }

  .c-service-process__layer-art {
    position: absolute;
    top: calc(-0.66 * var(--s));
    left: calc(73.31 * var(--s));
    width: calc(300 * var(--s));
    max-width: none;
    height: auto;
    transition: opacity var(--duration-hover) var(--ease-smooth);
  }
  /* Active art (401 × 227, with its glow): plate corner at (75.04, 113.4)
     in the file, matched to the grey plate's corner. */
  .c-service-process__layer-art.is-active-art {
    top: calc(-27.49 * var(--s));
    left: calc(-0.59 * var(--s));
    width: calc(401 * var(--s));
    opacity: 0;
  }
  .c-service-process__layer.is-active .c-service-process__layer-art.is-active-art {
    opacity: 1;
  }

  /* Marker: 25.2px circle + 49.25px line to the plate's left corner. */
  .c-service-process__marker,
  .c-service-process__marker-line {
    position: absolute;
    transition:
      background-color var(--duration-hover) var(--ease-smooth),
      color var(--duration-hover) var(--ease-smooth),
      border-color var(--duration-hover) var(--ease-smooth),
      opacity var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__marker {
    top: calc(73.31 * var(--s));
    left: 0;
    display: grid;
    place-items: center;
    width: calc(25.2 * var(--s));
    height: calc(25.2 * var(--s));
    border: 1px solid var(--color-gray); /* Figma #B9BEC8 — TODO: DS */
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: calc(13.745 * var(--s));
    line-height: 1;
    /* Acumin sits high in its box: nudge to the optical centre. */
    padding-top: calc(1.5 * var(--s));
  }
  .c-service-process__marker {
    isolation: isolate;
  }
  .c-service-process__marker::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -1px;
    border-radius: inherit;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__marker-line {
    top: calc(85.34 * var(--s));
    left: calc(25.18 * var(--s));
    width: calc(49.25 * var(--s));
    height: 1px;
    background: var(--color-gray); /* Figma #B9BEC8 — TODO: DS */
  }
  .c-service-process__marker-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__layer.is-active .c-service-process__marker {
    border-color: transparent;
    color: var(--color-white);
  }
  .c-service-process__layer.is-active .c-service-process__marker::before,
  .c-service-process__layer.is-active .c-service-process__marker-line::after {
    opacity: 1;
  }

  /* --- Step list ---------------------------------------------------------- */
  .c-service-process__steps {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0;
    padding: calc(29.575 * var(--u)) calc(49.292 * var(--u));
    list-style: none;
  }

  .c-service-process__step {
    position: relative;
    padding: calc(17.252 * var(--u)) calc(24.646 * var(--u));
    border-radius: 22px;
    background-color: transparent;
    transition:
      background-color var(--duration-hover) var(--ease-smooth),
      padding var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__step.is-active {
    padding: calc(30 * var(--u));
    background-color: var(--c-service-process-surface);
  }
  /* No JS: every step is open, on its card. */
  .c-service-process:not(.is-enhanced) .c-service-process__step {
    padding: calc(30 * var(--u));
    background-color: var(--c-service-process-surface);
  }
  .c-service-process:not(.is-enhanced) .c-service-process__step + .c-service-process__step {
    margin-top: calc(10 * var(--u));
  }

  .c-service-process__step-head {
    display: flex;
    align-items: center;
    gap: calc(20 * var(--u));
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  /* The whole card is the hit area; the open body sits above it so its text
     and links stay usable. */
  .c-service-process__step-head::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .c-service-process__step-head:focus-visible {
    outline: none;
  }
  .c-service-process__step-head:focus-visible::before {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-service-process__step.is-active .c-service-process__step-head {
    cursor: default;
  }

  /* Number: 34.5px circle; ring 46.83px around it (Figma 4301:11277/11279). */
  .c-service-process__num {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: calc(34.505 * var(--u));
    height: calc(34.505 * var(--u));
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--color-border); /* Figma rgba(38,40,46,.14) — TODO: DS */
    color: var(--color-text);
    line-height: 1;
    transition:
      color var(--duration-hover) var(--ease-smooth),
      box-shadow var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__num::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__num-text {
    position: relative;
    padding-top: 0.1em; /* Acumin optical centre */
  }
  .c-service-process__step:not(.is-active) .c-service-process__step-head:hover .c-service-process__num {
    box-shadow: 0 0 0 1px var(--color-gray);
  }
  .c-service-process__step.is-active .c-service-process__num {
    box-shadow: 0 0 0 1px transparent;
    color: var(--color-white);
  }
  .c-service-process__step.is-active .c-service-process__num::before {
    opacity: 1;
  }

  .c-service-process__ring {
    position: absolute;
    top: calc(-6.16 * var(--u));
    left: calc(-6.16 * var(--u));
    width: calc(46.828 * var(--u));
    max-width: none; /* the reset caps svg at its parent's 34.5px */
    height: calc(46.828 * var(--u));
    /* The path starts at the bottom: flip so the fill runs clockwise from
       the top. */
    transform: scaleY(-1);
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-smooth);
    pointer-events: none;
  }
  .c-service-process__step.is-active .c-service-process__ring {
    opacity: 1;
  }
  /* Figma #2A72E0 at 20%; closest token is the accent. TODO: DS */
  .c-service-process__ring-track {
    stroke: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  .c-service-process__ring-stop-start {
    stop-color: var(--color-blue);
  }
  .c-service-process__ring-stop-end {
    stop-color: var(--color-blue-light);
  }
  .c-service-process__ring-progress {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .c-service-process.is-autoplay .c-service-process__step.is-active .c-service-process__ring-progress {
    animation: c-service-process-ring var(--c-service-process-duration) linear both;
  }
  .c-service-process.is-autoplay.is-paused .c-service-process__step.is-active .c-service-process__ring-progress {
    animation-play-state: paused;
  }
  @keyframes c-service-process-ring {
    from { stroke-dashoffset: 1; }
    to   { stroke-dashoffset: 0; }
  }

  /* Figma: inactive names are 22.18px, the open one 25px (Paragraph M).
     One size for both (no 22px token). TODO: DS */
  .c-service-process__step-name {
    color: var(--color-black-secondary);
  }

  /* Body: opens by growing its grid row (0fr → 1fr). */
  .c-service-process__step-body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows var(--duration-hover) var(--ease-smooth),
      opacity var(--duration-hover) var(--ease-smooth);
  }
