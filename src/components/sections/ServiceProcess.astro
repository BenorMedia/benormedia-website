---
/**
 * ServiceProcess — "Process" section of the service template.
 * Refs: `docs/refs/services-template/services-process.jpg` and
 * `services-procees-tabs.svg` (the tabs box, 1352px = the container content
 * width; 1 ref px = 1/14 rem).
 *
 * Header: shared `SectionHeader` — eyebrow "Process", `processTitle`
 * (accentTitle segments), `processDescription` (`\n` = line break).
 *
 * Steps: WAI-ARIA tabs wired by `initTabs` (`src/scripts/ui/tabs.ts`).
 *   - Tab bar: one `<button role="tab">` per step, numbered 01…NN by array
 *     order. Active = outlined square + the step name; inactive = gradient
 *     square with the white number only (the name stays in the accessible
 *     name, collapsed to 0 width). Arrow keys / Home / End via `initTabs`.
 *   - Smooth tab change (lead, 2026-09-29): the name's width, opacity and
 *     the square → name gap transition (the inner `__tab-name-text` keeps
 *     its wrapping while the box grows, so the other tabs slide), the
 *     square's gradient fill fades (`::before`), and the shown panel fades
 *     in. `--duration-hover` / `--ease-smooth`; reduced motion → instant
 *     (base.css).
 *   - Panel: step image left (SVG assets are served as the raw file, never
 *     rasterized), h3 name + description + feature pills right.
 *   - No JS (G-2 pattern): the tablist is rendered `hidden` and every panel
 *     is visible in order, each h3 prefixed with its number. The script
 *     reveals the tablist (initTabs) and adds `is-enhanced`, which hides the
 *     in-panel numbers (the tab shows them).
 *   - 1 step: no tab bar, just the panel. 0 steps: header only. No title and
 *     no steps: the section is not rendered.
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import type { ProcessStep } from "../../lib/sanity/types";
import type { TitleSegment } from "../../lib/sanity/portable-text";
import { urlFor, assetDimensions, isSvgAsset, type Source } from "../../lib/sanity/image";

interface Props {
  /** Plain title (`\n` = line break). Empty = no title. */
  title: string;
  titleSegments?: readonly TitleSegment[];
  description?: string | null | undefined;
  steps: readonly ProcessStep[];
  /** Id prefix for tabs / panels (unique per page). */
  id?: string;
}

const { title, titleSegments, description, steps, id = "process-step" } = Astro.props;

// Rendered image box: 464px in the ref (the illustration's own width) →
// 33.143rem. TODO: DS
const IMG_WIDTH = 464;

const items = steps
  .filter((step) => step.name?.trim())
  .map((step, i) => {
    const num = String(i + 1).padStart(2, "0");
    const image = step.image?.asset ? step.image : null;
    const assetId = image?.asset?._id ?? image?.asset?._ref;
    const size = assetDimensions(assetId);
    const height = size ? Math.round((IMG_WIDTH * size.height) / size.width) : undefined;
    let img: { src: string; srcset?: string; width: number; height: number; alt: string } | null = null;
    if (image && height) {
      if (isSvgAsset(assetId)) {
        img = { src: urlFor(image as Source).url(), width: IMG_WIDTH, height, alt: image.alt?.trim() ?? "" };
      } else {
        const base = urlFor(image as Source).auto("format").fit("max");
        img = {
          src: base.width(IMG_WIDTH).url(),
          srcset: `${base.width(IMG_WIDTH).url()} 1x, ${base.width(IMG_WIDTH * 2).url()} 2x`,
          width: IMG_WIDTH,
          height,
          alt: image.alt?.trim() ?? "",
        };
      }
    }
    return {
      key: step._key,
      num,
      name: step.name.trim(),
      description: step.description?.trim() || null,
      features: (step.features ?? []).map((f) => f.trim()).filter(Boolean),
      img,
      panelId: `${id}-${num}`,
      tabId: `${id}-${num}-tab`,
    };
  });

const hasTitle = title.trim().length > 0;
const shouldRender = hasTitle || items.length > 0;
const hasTabs = items.length > 1;

const headerOptional = {
  ...(titleSegments !== undefined && { titleSegments }),
  ...(description?.trim() ? { description: description.trim() } : {}),
};
---

{shouldRender && (
  <section class="c-service-process" data-service-process>
    <Container>
      {hasTitle && <SectionHeader eyebrow="Process" title={title} {...headerOptional} />}

      {items.length > 0 && (
        <div class="c-service-process__box">
          {hasTabs && (
            <div class="c-service-process__tabs" role="tablist" aria-label="Process steps" hidden>
              {items.map((item, i) => (
                <button
                  type="button"
                  role="tab"
                  id={item.tabId}
                  class={["c-service-process__tab", i === 0 && "is-active"].filter(Boolean).join(" ")}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={item.panelId}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="c-service-process__tab-num c-paragraph_m">{item.num}</span>{" "}
                  <span class="c-service-process__tab-name c-paragraph_m"><span class="c-service-process__tab-name-text">{item.name}</span></span>
                </button>
              ))}
            </div>
          )}

          <div class="c-service-process__panels">
            {items.map((item) => (
              /* role / tabindex / aria-labelledby are added by initTabs, so
                 without JS these are plain blocks under their h3. */
              <div
                id={item.panelId}
                class={["c-service-process__panel", !item.img && "is-no-media"].filter(Boolean).join(" ")}
                data-anim="service-process-panel"
              >
                {item.img && (
                  <div class="c-service-process__media">
                    <img
                      class="c-service-process__img"
                      src={item.img.src}
                      srcset={item.img.srcset}
                      width={item.img.width}
                      height={item.img.height}
                      alt={item.img.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="c-service-process__content">
                  <h3 class="c-service-process__step-title c-text_l">
                    <span class="c-service-process__step-num">{item.num}</span>{" "}{item.name}
                  </h3>
                  {item.description && (
                    <p class="c-service-process__step-description c-paragraph_m">{item.description}</p>
                  )}
                  {item.features.length > 0 && (
                    <ul class="c-service-process__features">
                      {item.features.map((feature) => (
                        <li class="c-service-process__feature c-paragraph">{feature}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </Container>
  </section>
)}

<script>
  import { initTabs } from "../../scripts/ui/tabs";

  document.querySelectorAll<HTMLElement>("[data-service-process]").forEach((section) => {
    const tabs = section.querySelector<HTMLElement>(".c-service-process__tabs");
    if (!tabs) return;
    initTabs(tabs);
    section.classList.add("is-enhanced");
  });
</script>

<style>
  .c-service-process {
    background: var(--color-white);
  }

  .c-service-process :global(.c-container) {
    /* Problem border → eyebrow ≈ 110px, box → next section ≈ 90px in the
       ref. TODO: DS section spacing. */
    padding-top: 7.857rem;
    padding-bottom: 6.429rem;
  }

  /* Description width (lead visual QA 2026-09-29): 50% in this section only;
     full width on phones. */
  .c-service-process :global(.c-section-header__description) {
    max-width: 50%;
  }
  @media (max-width: 767px) {
    .c-service-process :global(.c-section-header__description) {
      max-width: 100%;
    }
  }

  /* --- Box (services-procees-tabs.svg: 1352 × 622, 1px border, 8px) ------ */
  .c-service-process__box {
    margin-top: 4.786rem; /* description → box ≈ 67px — TODO: DS */
    padding: 1.5rem; /* 21px — TODO: DS */
    border: var(--border-default);
    border-radius: 8px; /* TODO: DS */
    background: var(--color-white);
  }

  /* --- Tab bar (1310 × 114, 1px border, 8px radius, 25px inset) ---------- */
  .c-service-process__tabs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.786rem; /* 25px — TODO: DS */
    border: var(--border-default);
    border-radius: 8px;
  }
  /* Author `display` would override `hidden` (removed by initTabs). */
  .c-service-process__tabs[hidden] {
    display: none;
  }

  .c-service-process__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0; /* inactive: square only */
    transition: gap var(--duration-hover) var(--ease-smooth);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .c-service-process__tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .c-service-process__tab.is-active {
    gap: 1.714rem; /* square → name 24px — TODO: DS */
  }

  /* 64px square (62px + gradient border for the active one). TODO: DS
     Every square is the active look (white fill, 1px gradient border); the
     inactive gradient fill is a `::before` layer that fades out on select. */
  .c-service-process__tab-num {
    position: relative;
    isolation: isolate;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.571rem;
    height: 4.571rem;
    border: 1px solid transparent;
    border-radius: 4px; /* TODO: DS */
    background:
      linear-gradient(var(--color-white), var(--color-white)) padding-box,
      var(--gradient-primary) border-box;
    color: var(--color-white);
    transition:
      transform var(--duration-hover) var(--ease-smooth),
      color var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__tab-num::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: var(--gradient-primary);
    opacity: 1;
    transition: opacity var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__tab:not(.is-active):hover .c-service-process__tab-num {
    transform: translateY(-7%); /* same lift as the buttons */
  }

  /* Active: 1px gradient outline + blue number (the fill fades out). */
  .c-service-process__tab.is-active .c-service-process__tab-num {
    color: var(--color-blue);
  }
  .c-service-process__tab.is-active .c-service-process__tab-num::before {
    opacity: 0;
  }

  /* Name: collapsed (0 width, transparent) on inactive tabs, still in the
     tab's accessible name; grows and fades in on the active tab. The inner
     text keeps its own width so it doesn't re-wrap while the box grows. */
  .c-service-process__tab-name {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    color: var(--color-heading);
    opacity: 0;
    transition:
      max-width var(--duration-hover) var(--ease-smooth),
      opacity var(--duration-hover) var(--ease-smooth);
  }
  .c-service-process__tab-name-text {
    display: block;
    width: max-content;
    max-width: 8.571rem; /* wraps "Website / strategy plan" as in the ref — TODO: DS */
  }
  .c-service-process__tab.is-active .c-service-process__tab-name {
    max-width: 8.571rem;
    opacity: 1;
  }

  /* --- Panels ------------------------------------------------------------- */
  .c-service-process__panels {
    display: flex;
    flex-direction: column;
  }

  .c-service-process__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    column-gap: 3rem; /* TODO: DS */
    padding: 1.5rem 0 0.75rem; /* image 417px centered under the bar — TODO: DS */
  }
  /* Without JS every panel shows: separate them. */
  .c-service-process__panel + .c-service-process__panel {
    border-top: var(--border-default);
  }
  .c-service-process__panel[hidden] {
    display: none;
  }
  /* With tabs: the panel that becomes visible fades in (the animation
     restarts each time `hidden` is removed). */
  .c-service-process.is-enhanced .c-service-process__panel:not([hidden]) {
    animation: c-service-process-panel-in var(--duration-hover) var(--ease-smooth);
  }
  @keyframes c-service-process-panel-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .c-service-process__panel:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.5rem;
  }
  .c-service-process__panel.is-no-media {
    grid-template-columns: 1fr;
    padding: 3rem 2rem;
  }

  .c-service-process__media {
    display: flex;
    justify-content: center;
  }

  .c-service-process__img {
    display: block;
    width: 33.143rem; /* 464px — TODO: DS */
    max-width: 100%;
    height: auto;
  }

  .c-service-process__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 37.5rem; /* text column ≈ 525px — TODO: DS */
  }

  .c-service-process__step-title {
    margin: 0;
    color: var(--color-black-secondary);
  }
  /* Number only without JS (the tabs show it once enhanced). */
  .c-service-process__step-num {
    color: var(--color-blue);
  }
  .c-service-process.is-enhanced .c-service-process__step-num {
    display: none;
  }

  .c-service-process__step-description {
    margin: 0.857rem 0 0; /* ≈12px — TODO: DS */
    color: var(--color-text);
  }

  /* Feature pills: sentence case, gray outline (ref). The shared `Tag` is
     uppercase + letter-spaced, so these are scoped. TODO: DS pill spec /
     sentence-case Tag variant (@ui). */
  .c-service-process__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.571rem; /* 8px — TODO: DS */
    margin: 2.357rem 0 0; /* ≈33px — TODO: DS */
    padding: 0;
    list-style: none;
  }
  .c-service-process__feature {
    padding: 0.55em 1.1em;
    border: var(--border-default);
    border-radius: 3px;
    color: var(--color-text);
    white-space: nowrap;
  }

  /* TODO: DS mobile — no ref. */
  @media (max-width: 767px) {
    .c-service-process :global(.c-container) {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .c-service-process__box {
      margin-top: 3rem;
      padding: 1rem;
    }
    /* Squares only, wrapping; the step name is the panel h3. */
    .c-service-process__tabs {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 1rem;
      padding: 1.5rem;
    }
    /* Squares only: the active name stays collapsed too. */
    .c-service-process__tab.is-active {
      gap: 0;
    }
    .c-service-process__tab.is-active .c-service-process__tab-name {
      max-width: 0;
      opacity: 0;
    }
    .c-service-process__tab-num {
      width: 5rem;
      height: 5rem;
    }
    .c-service-process__panel {
      grid-template-columns: 1fr;
      row-gap: 2rem;
      padding: 2rem 1rem 1rem;
    }
    .c-service-process__feature {
      white-space: normal;
    }
  }
</style>
