---
/**
 * ServiceProblem — "The Problem" section of the service template.
 * Ref: `docs/refs/services-template/services-problem.jpg` (the whole section
 * at the 1920 frame, 1 ref px = 1/14 rem).
 *
 * Center: Eyebrow "The Problem" + `problemTitle` (accentTitle segments) +
 * `problemDescription`, via the shared `SectionHeader` (h2, centered). The
 * description's blank-line-separated paragraphs render as separate `<p>`s
 * (the copy, including any closing "Learn how.", comes from Sanity). A
 * static gradient down arrow sits below the description on every service
 * (lead 2026-09-30; decorative, no link, no animation).
 *
 * Frame (decorative, `aria-hidden`): two thin vertical lines around the
 * center column with square nodes, as in the ref. The section's bottom border
 * closes the frame (the top edge is the logo strip's bottom border).
 *
 * Side carousels (lead request, the one animation in this phase): two
 * VERTICAL infinite marquees of the related clients' `websiteScreenshot`,
 * placed outside the frame and bleeding past the viewport (the section clips
 * them, no fade, as in the ref). Left moves bottom → top, right top → bottom,
 * very slowly. CSS only, like `LogoStrip` / `TestimonialMarquee`: each track
 * holds one "copy" (the column's clients, repeated until it is taller than
 * the section) twice, and animates translateY 0 → -50%. Only the first
 * occurrence of each client is exposed to AT (alt = screenshot alt or
 * "<name> website"); every repeat is `aria-hidden` with `alt=""`.
 *   - 4+ clients: split between the columns (left gets the first half).
 *   - 1–3 clients: both columns show all of them; the right one is
 *     rotated and fully `aria-hidden` (no double announcement).
 *   - no screenshots: center content only (no frame, no carousels).
 *   - no title and no description: the section is not rendered.
 * `prefers-reduced-motion`: tracks are static (the first images show).
 *
 * ≤991px (lead, 2026-09-29, S-20): the same two tracks become HORIZONTAL
 * full-bleed rows, one above the content (left column, moving left → right)
 * and one below it (right column, moving right → left). Same markup, same
 * screenshots, same ≈20s per screenshot; CSS only (`order`, row track,
 * `translateX` loop). Frame lines hidden. The section clips the rows, so the
 * page never scrolls sideways. Screenshot width `TODO: DS mobile`.
 *
 * Hook: `data-anim="service-problem-carousel"` on each track (`data-direction`
 * = `up` / `down`), for a future GSAP swap if the spec asks for one.
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import type { Client, SanityImage } from "../../lib/sanity/types";
import type { TitleSegment } from "../../lib/sanity/portable-text";
import { urlFor, assetDimensions, type Source } from "../../lib/sanity/image";

interface Props {
  /** Plain title (`\n` = line break). Empty = no title. */
  title: string;
  titleSegments?: readonly TitleSegment[];
  description?: string | null | undefined;
  clients: readonly Client[];
}

const { title, titleSegments, description, clients } = Astro.props;

// Rendered image box: 453.172px in the ref → 32.369rem (TODO: DS). The
// `width`/`height` attributes carry the intrinsic ratio at that width.
const IMG_WIDTH = 453;

interface Shot {
  key: string;
  src: string;
  srcset: string;
  width: number;
  height: number;
  alt: string;
}

const shots: Shot[] = clients
  .filter((c): c is Client & { websiteScreenshot: SanityImage } => !!c.websiteScreenshot?.asset)
  .map((c) => {
    const image = c.websiteScreenshot;
    const size = assetDimensions(image.asset?._id ?? image.asset?._ref);
    const height = size ? Math.round((IMG_WIDTH * size.height) / size.width) : Math.round(IMG_WIDTH * 0.5715);
    const base = urlFor(image as Source).auto("format").fit("max");
    return {
      key: c._id,
      src: base.width(IMG_WIDTH).url(),
      srcset: `${base.width(IMG_WIDTH).url()} 1x, ${base.width(IMG_WIDTH * 2).url()} 2x`,
      width: IMG_WIDTH,
      height,
      alt: image.alt?.trim() || `${c.name} website`,
    };
  });

// Columns: split when there are enough screenshots, else share them.
const split = shots.length >= 4;
const half = Math.ceil(shots.length / 2);
const leftShots = split ? shots.slice(0, half) : shots;
const rightShots = split
  ? shots.slice(half)
  : [...shots.slice(Math.floor(shots.length / 2)), ...shots.slice(0, Math.floor(shots.length / 2))];

// One copy must be taller than the section (≈701px ref) so the loop never
// shows a gap: at least 4 images (4 × ~284px).
const MIN_PER_COPY = 4;
function buildTrack(list: Shot[], exposeFirst: boolean) {
  if (list.length === 0) return [];
  const repeats = Math.ceil(MIN_PER_COPY / list.length);
  const copy = Array.from({ length: repeats }, () => list).flat();
  return [...copy, ...copy].map((shot, i) => ({
    ...shot,
    hidden: !exposeFirst || i >= list.length,
  }));
}

const columns = [
  { side: "left", direction: "up", items: buildTrack(leftShots, true) },
  { side: "right", direction: "down", items: buildTrack(rightShots, split) },
].filter((col) => col.items.length > 0);

// ≈20s per image in one copy: "very slow". TODO: DS animation spec.
const SECONDS_PER_IMAGE = 20;

const hasTitle = title.trim().length > 0;
const hasDescription = !!description?.trim();
// Same paragraph split as SectionHeader (description-only fallback below).
const descriptionParagraphs = (description ?? "")
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const shouldRender = hasTitle || hasDescription;
const hasCarousels = columns.length > 0;

const headerOptional = {
  ...(titleSegments !== undefined && { titleSegments }),
  ...(hasDescription && description ? { description } : {}),
};
---

{shouldRender && (
  <section class={["c-service-problem", hasCarousels && "is-carousels"].filter(Boolean).join(" ")}>
    <Container class="c-service-problem__container">
      {hasCarousels && (
        <div class="c-service-problem__frame" aria-hidden="true">
          <span class="c-service-problem__node is-left-mid"></span>
          <span class="c-service-problem__node is-right-top"></span>
          <span class="c-service-problem__node is-right-bottom"></span>
        </div>
      )}

      {columns.map((col) => (
        <div
          class={`c-service-problem__carousel is-${col.side}`}
          aria-hidden={col.items.every((item) => item.hidden) ? "true" : undefined}
        >
          <ul
            class="c-service-problem__track"
            data-anim="service-problem-carousel"
            data-direction={col.direction}
            style={`--c-service-problem-duration: ${(col.items.length / 2) * SECONDS_PER_IMAGE}s`}
          >
            {col.items.map((item) => (
              <li class="c-service-problem__item" aria-hidden={item.hidden ? "true" : undefined}>
                <img
                  class="c-service-problem__img"
                  src={item.src}
                  srcset={item.srcset}
                  width={item.width}
                  height={item.height}
                  alt={item.hidden ? "" : item.alt}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="c-service-problem__content">
        {hasTitle ? (
          <SectionHeader eyebrow="The Problem" title={title} {...headerOptional} />
        ) : (
          /* Description only: same header markup/classes, no empty heading. */
          <header class="c-section-header">
            <Eyebrow variant="default">The Problem</Eyebrow>
            <div class="c-section-header__text">
              {descriptionParagraphs.map((paragraph) => (
                <p class="c-section-header__description c-paragraph_m">{paragraph}</p>
              ))}
            </div>
          </header>
        )}
        {hasDescription && (
          <svg
            class="c-service-problem__arrow"
            aria-hidden="true"
            width="16"
            height="21"
            viewBox="0 0 16 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M8.82993 16.704L13.1819 12.352C13.2918 12.2341 13.4243 12.1395 13.5715 12.074C13.7187 12.0084 13.8776 11.9731 14.0387 11.9703C14.1998 11.9674 14.3599 11.9971 14.5093 12.0574C14.6587 12.1178 14.7944 12.2076 14.9084 12.3215C15.0223 12.4355 15.1122 12.5712 15.1725 12.7206C15.2329 12.8701 15.2625 13.0301 15.2597 13.1912C15.2568 13.3524 15.2216 13.5113 15.156 13.6585C15.0904 13.8057 14.9958 13.9381 14.8779 14.048L8.47793 20.448C8.25293 20.6727 7.94793 20.7989 7.62993 20.7989C7.31193 20.7989 7.00693 20.6727 6.78193 20.448L0.381933 14.048C0.264034 13.9381 0.16947 13.8057 0.103883 13.6585C0.0382961 13.5113 0.00302961 13.3524 0.000186756 13.1912C-0.0026561 13.0301 0.0269829 12.8701 0.0873366 12.7206C0.14769 12.5712 0.237522 12.4355 0.351472 12.3215C0.465422 12.2076 0.601156 12.1178 0.750577 12.0574C0.899998 11.9971 1.06004 11.9674 1.22117 11.9703C1.38229 11.9731 1.5412 12.0084 1.68839 12.074C1.83559 12.1395 1.96807 12.2341 2.07793 12.352L6.42993 16.704V1.2C6.42993 0.88174 6.55636 0.576515 6.78141 0.351472C7.00645 0.126428 7.31167 0 7.62993 0C7.94819 0 8.25342 0.126428 8.47846 0.351472C8.7035 0.576515 8.82993 0.88174 8.82993 1.2V16.704Z"
              fill="url(#c-service-problem-arrow-gradient)"
            />
            <defs>
              <linearGradient
                id="c-service-problem-arrow-gradient"
                x1="0"
                y1="2.68653"
                x2="17.6719"
                y2="6.41031"
                gradientUnits="userSpaceOnUse"
              >
                <stop style="stop-color: var(--color-blue)" />
                <stop offset="1" style="stop-color: var(--color-blue-light)" />
              </linearGradient>
            </defs>
          </svg>
        )}
      </div>
    </Container>
  </section>
)}

<style>
  .c-service-problem {
    /* Center column (frame) width and the gap frame line → screenshots,
       measured in the ref: lines at x 471 / 1477 (1006px), screenshots end
       59px / start 51px from them (avg 55px). TODO: DS */
    --c-service-problem-frame: 71.857rem;
    --c-service-problem-gap: 3.929rem;
    --c-service-problem-img: 32.369rem; /* 453.172px — TODO: DS */

    position: relative;
    overflow: hidden; /* clips the bleeding carousels */
    background: var(--color-white);
    border-bottom: var(--border-default);
  }

  .c-service-problem :global(.c-container.c-service-problem__container) {
    position: relative;
    /* 200px top / bottom in the ref (lead brief). TODO: DS */
    padding-top: 14.286rem;
    padding-bottom: 14.286rem;
  }

  .c-service-problem__content {
    position: relative;
    z-index: 1;
    max-width: var(--c-service-problem-frame);
    margin-inline: auto;
  }

  /* Static down arrow under the description (lead 2026-09-30): 16×21px
     (÷14). Gap = the header's eyebrow → text gap. TODO: DS */
  .c-service-problem__arrow {
    display: block;
    width: 1.143rem;
    height: 1.5rem;
    margin: 1.5rem auto 0;
  }

  /* --- Frame ------------------------------------------------------------ */
  .c-service-problem__frame {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--c-service-problem-frame);
    transform: translateX(-50%);
    border-inline: var(--border-default);
    pointer-events: none;
  }

  /* Square nodes on the lines (≈19px, white, light border, 2px radius).
     Positions from the ref: left line 56.3% down, right line 23.1% and at
     the bottom border. TODO: DS */
  .c-service-problem__node {
    position: absolute;
    width: 1.339rem;
    height: 1.339rem;
    border: var(--border-default);
    border-radius: 2px;
    background: var(--color-white);
    transform: translate(-50%, -50%);
  }
  .c-service-problem__node.is-left-mid {
    left: 0;
    top: 56.3%;
  }
  .c-service-problem__node.is-right-top {
    left: 100%;
    top: 23.1%;
  }
  .c-service-problem__node.is-right-bottom {
    left: 100%;
    top: 100%;
  }

  /* --- Carousels ---------------------------------------------------------- */
  .c-service-problem__carousel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--c-service-problem-img);
    overflow: hidden;
    pointer-events: none;
  }
  .c-service-problem__carousel.is-left {
    right: calc(50% + var(--c-service-problem-frame) / 2 + var(--c-service-problem-gap));
  }
  .c-service-problem__carousel.is-right {
    left: calc(50% + var(--c-service-problem-frame) / 2 + var(--c-service-problem-gap));
  }

  .c-service-problem__track {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: c-service-problem-scroll var(--c-service-problem-duration, 80s) linear infinite;
  }
  /* Right column: top → bottom. */
  .c-service-problem__track[data-direction="down"] {
    animation-direction: reverse;
  }

  @keyframes c-service-problem-scroll {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }

  /* Mobile rows (≤991): 0 → -50% moves right → left. */
  @keyframes c-service-problem-scroll-x {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Padding (not flex gap) so both halves are exactly equal and the loop
     is seamless. Gap between screenshots ≈ 25px in the ref. TODO: DS */
  .c-service-problem__item {
    padding-bottom: 1.786rem;
  }

  .c-service-problem__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px; /* TODO: DS */
  }

  /* ≤991 (lead, S-20): the side columns become two horizontal rows, above
     (left column) and below (right column) the content. TODO: DS mobile —
     no ref for the screenshot width or the row → content spacing. */
  @media (max-width: 991px) {
    .c-service-problem {
      --c-service-problem-img: 22rem;
    }
    .c-service-problem__frame {
      display: none;
    }
    .c-service-problem :global(.c-container.c-service-problem__container) {
      display: flex;
      flex-direction: column;
      gap: 4rem; /* TODO: DS mobile */
      padding-top: 8.571rem;
      padding-bottom: 8.571rem;
    }

    .c-service-problem__carousel {
      position: static;
      /* Full bleed; the section's `overflow: hidden` clips it. */
      width: 100vw;
      margin-inline: calc(50% - 50vw);
    }
    .c-service-problem__carousel.is-left {
      order: 1;
    }
    .c-service-problem__content {
      order: 2;
      width: 100%;
    }
    .c-service-problem__carousel.is-right {
      order: 3;
    }

    .c-service-problem__track {
      flex-direction: row;
      align-items: flex-start;
      width: max-content;
      animation: c-service-problem-scroll-x var(--c-service-problem-duration, 80s) linear infinite;
    }
    /* Top row (left column): left → right. */
    .c-service-problem__track[data-direction="up"] {
      animation-direction: reverse;
    }
    /* Bottom row (right column): right → left. */
    .c-service-problem__track[data-direction="down"] {
      animation-direction: normal;
    }

    /* Padding (not gap) keeps both halves equal, as on desktop. */
    .c-service-problem__item {
      flex: 0 0 auto;
      width: var(--c-service-problem-img);
      padding-bottom: 0;
      padding-right: 1.786rem;
    }
  }

  @media (max-width: 767px) {
    .c-service-problem {
      --c-service-problem-img: 20rem;
    }
    .c-service-problem :global(.c-container.c-service-problem__container) {
      gap: 3rem; /* TODO: DS mobile */
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  /* Last, so it wins over the mobile rows too. */
  @media (prefers-reduced-motion: reduce) {
    .c-service-problem__track,
    .c-service-problem__track[data-direction] {
      animation: none;
    }
  }
</style>
