---
/**
 * HomeHero — top-of-fold hero for the Home page.
 *
 * Static copy. Hero renders on the blue gradient with white type and
 * white / glass button variants. Two decorative line PNGs sit absolutely
 * inside `.c-hero__lines`, aria-hidden.
 *
 * Content stack (24px internal gap):
 *   - title sub-block (eyebrow row + h1 + subtitle, 24px gap). Eyebrow row:
 *     "$700M+" eyebrow left of the partner one; stacked on mobile, new on top.
 *   - buttons sub-block
 * Stats row removed (lead 2026-09-30); the container's bottom padding keeps
 * its space for a custom animation (spec pending).
 *
 * No animations wired — `data-anim="..."` hooks are placed for Phase 6.
 *
 * The "Get in Touch" button opens the ContactModal via the shared
 * `.js-open-contact` hook (Button doesn't spread unknown attrs — Nav / Cta
 * use the same fallback).
 */
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
---

<section class="c-hero">
  <div class="c-hero__lines" aria-hidden="true">
    <img
      class="c-hero__lines-img is-left"
      src="/images/home/hero-lines-left.png"
      alt=""
      data-anim="hero-lines"
      loading="eager"
      decoding="async"
    />
    <img
      class="c-hero__lines-img is-right"
      src="/images/home/hero-lines-right.png"
      alt=""
      data-anim="hero-lines"
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="c-hero__container">
    <div class="c-hero__block">
      <div class="c-hero__title-block">
        <div class="c-hero__eyebrows">
          <Eyebrow variant="default" class="c-hero__eyebrow">
            $700M+ RAISED BY OUR CLIENTS
          </Eyebrow>
          <Eyebrow variant="default" class="c-hero__eyebrow">
            6+ YEARS AS A WEBFLOW PROFESSIONAL PARTNER
          </Eyebrow>
        </div>

        <h1 class="c-hero__title" data-anim="hero-headline">
          We turn your website into a revenue engine.
        </h1>

        <p class="c-paragraph_m c-hero__desc">
          Your website should be your hardest working asset. We accelerate B2B
          growth through website strategy and execution, AEO, and SEO.
        </p>
      </div>

      <div class="c-hero__buttons">
        <Button variant="white" class="js-open-contact">Get in Touch</Button>
        <Button variant="glass" href="/work">See Our Work</Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- Section shell ---------------------------------------------------- */
  .c-hero {
    position: relative;
    overflow: hidden;
    margin: 0 1.429rem 5.714rem;
    border-radius: 15px;
    /* Base gradient (101deg, blue → blue-light). Solid white behind it as a
       fallback for very old renderers, per spec. */
    background:
      linear-gradient(
        101deg,
        var(--color-blue) 6.56%,
        var(--color-blue-light) 93.44%
      ),
      var(--color-white);
    color: var(--color-white);
  }

  /* --- Decorative lines ------------------------------------------------- */
  .c-hero__lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
  }
  .c-hero__lines-img {
    position: absolute;
    top: 0;
    bottom: 0;
    height: auto;
    margin-top: auto;
    margin-bottom: auto;
    width: 35%;
    max-width: none;
    display: block;
    object-fit: cover;
  }
  .c-hero__lines-img.is-left { left: 0; }
  .c-hero__lines-img.is-right { right: 0; }

  /* --- Container -------------------------------------------------------- */
  .c-hero__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    max-width: 1440px;
    margin: 0 auto;
    /* Bottom keeps the removed stats row's space for the upcoming hero
       animation. Lead 2026-09-30. */
    padding: 7.8rem 0 20.5rem;
  }

  /* --- Block 1: title stack + buttons ---------------------------------- */
  .c-hero__block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.25rem;
    width: 100%;
    max-width: 60%;
  }

  @media (max-width: 767px) {
    .c-hero__block {
      max-width: 90%;
    }
  }

  .c-hero__title-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.15rem;
    width: 100%;
  }

  /* --- Title (gradient text) ------------------------------------------- */
  .c-hero__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 6.286rem;      /* 88px */
    font-weight: 400;
    font-style: normal;
    line-height: 1.2;         /* lead 2026-09-30 */
    letter-spacing: -0.126rem; /* -1.76px */
    text-align: center;
    /* TODO: DS — secondary gradient stop (#8BC1F9) is not in tokens yet.
       Kept inline with white so the title reads as spec on the blue bg. */
    background: linear-gradient(108deg, var(--color-white) 59.9%, #8BC1F9 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    /* Fallback for browsers without background-clip: text */
    color: var(--color-white);
  }

  /* Mobile: DS mobile H1 size (§3.2 `--fs-text-xxl` = 4rem ≈ 36px) instead of
     the fixed desktop 6.286rem; letter-spacing scaled by the same ratio.
     Lead request 2026-09-29. */
  @media (max-width: 767px) {
    .c-hero__title {
      font-size: var(--fs-text-xxl);
      letter-spacing: -0.08rem;
    }
  }

  /* --- Eyebrow row (lead 2026-09-30) --------------------------------- */
  .c-hero__eyebrows {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.143rem; /* 30px ÷14 (1440 root) — lead 2026-09-30 */
  }

  @media (max-width: 767px) {
    .c-hero__eyebrows {
      flex-direction: column;
    }
  }

  .c-hero__desc {
    color: var(--color-white);
    margin: 0;
    max-width: 42rem;
    text-align: center;
  }

  /* --- Buttons row ----------------------------------------------------- */
  .c-hero__buttons {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    /* TODO: DS gap between hero CTAs. */
    gap: 1rem;
  }

  @media (max-width: 991px) {
    .c-hero__buttons {
      flex-direction: column;
      width: 100%;
    }
    .c-hero__buttons :global(.c-button) {
      width: 100%;
    }
  }

  /* --- Eyebrow on-dark override ----------------------------------------
     Same pattern as CtaBanner. TODO: DS — replace with `is-on-dark` variant
     on the Eyebrow primitive so this scoped override retires. */
  .c-hero :global(.c-eyebrow.is-default) {
    border-color: rgba(255, 255, 255, 0.4);
    color: var(--color-white);
  }
  /* Squares: gradient fill + gray border — hero eyebrows only (lead
     2026-09-30). */
  .c-hero :global(.c-eyebrow.is-default::before),
  .c-hero :global(.c-eyebrow.is-default::after) {
    background: var(--gradient-primary);
    border: 0.5px solid var(--color-gray);
    border-radius: 1.5px;
  }
</style>
