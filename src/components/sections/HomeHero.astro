---
/**
 * HomeHero — top-of-fold hero for the Home page.
 *
 * Static copy. Hero renders on the blue gradient with white type and
 * white / glass button variants. Two decorative line PNGs sit absolutely
 * inside `.c-hero__lines`, aria-hidden.
 *
 * Content stack (2 outer blocks, 116px gap):
 *   Block 1 (24px internal gap)
 *     - title sub-block (eyebrow + h1 + subtitle, 24px gap)
 *     - buttons sub-block
 *   Block 2
 *     - stats
 *
 * No animations wired — `data-anim="..."` hooks are placed for Phase 6.
 *
 * The "Get in Touch" button opens the ContactModal via the shared
 * `.js-open-contact` hook (Button doesn't spread unknown attrs — Nav / Cta
 * use the same fallback).
 */
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Stat from "../ui/Stat.astro";
---

<section class="c-hero">
  <div class="c-hero__lines" aria-hidden="true">
    <img
      class="c-hero__lines-img is-left"
      src="/images/home/hero-lines-left.png"
      alt=""
      data-anim="hero-lines"
      loading="eager"
      decoding="async"
    />
    <img
      class="c-hero__lines-img is-right"
      src="/images/home/hero-lines-right.png"
      alt=""
      data-anim="hero-lines"
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="c-hero__container">
    <div class="c-hero__block">
      <div class="c-hero__title-block">
        <Eyebrow variant="default" class="c-hero__eyebrow">
          6+ YEARS AS A WEBFLOW PROFESSIONAL PARTNER
        </Eyebrow>

        <h1 class="c-hero__title" data-anim="hero-headline">
          We turn your website into a revenue engine.
        </h1>

        <p class="c-paragraph_m c-hero__desc">
          Your website should be your hardest working asset. We accelerate B2B
          growth through website strategy and execution, AEO, and SEO.
        </p>
      </div>

      <div class="c-hero__buttons">
        <Button variant="white" class="js-open-contact">Get in Touch</Button>
        <Button variant="glass" href="/work">See Our Work</Button>
      </div>
    </div>

    <div class="c-hero__stats">
      <Stat value="$700M+" label="Money raised by our clients" animate />
      <Stat value="100+" label="Successful site launches" animate />
    </div>
  </div>
</section>

<style>
  /* --- Section shell ---------------------------------------------------- */
  .c-hero {
    position: relative;
    overflow: hidden;
    margin: 0 1.429rem 5.714rem;
    border-radius: 15px;
    /* Base gradient (101deg, blue → blue-light). Solid white behind it as a
       fallback for very old renderers, per spec. */
    background:
      linear-gradient(
        101deg,
        var(--color-blue) 6.56%,
        var(--color-blue-light) 93.44%
      ),
      var(--color-white);
    color: var(--color-white);
  }

  /* --- Decorative lines ------------------------------------------------- */
  .c-hero__lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
  }
  .c-hero__lines-img {
    position: absolute;
    top: 0;
    bottom: 0;
    height: auto;
    margin-top: auto;
    margin-bottom: auto;
    width: 35%;
    max-width: none;
    display: block;
    object-fit: cover;
  }
  .c-hero__lines-img.is-left { left: 0; }
  .c-hero__lines-img.is-right { right: 0; }

  /* --- Container -------------------------------------------------------- */
  .c-hero__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    max-width: 1440px;
    margin: 0 auto;
    padding: 7.8rem 0 5em;
    gap: 8.286rem; /* 116px between the two outer blocks */
  }

  /* --- Block 1: title stack + buttons ---------------------------------- */
  .c-hero__block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.25rem;
    width: 100%;
    max-width: 60%;
  }

  @media (max-width: 767px) {
    .c-hero__block {
      max-width: 90%;
    }
  }

  .c-hero__title-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.15rem;
    width: 100%;
  }

  /* --- Title (gradient text) ------------------------------------------- */
  .c-hero__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 6.286rem;      /* 88px */
    font-weight: 400;
    font-style: normal;
    line-height: 1;           /* 100% */
    letter-spacing: -0.126rem; /* -1.76px */
    text-align: center;
    /* TODO: DS — secondary gradient stop (#8BC1F9) is not in tokens yet.
       Kept inline with white so the title reads as spec on the blue bg. */
    background: linear-gradient(108deg, #FFFFFF 59.9%, #8BC1F9 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    /* Fallback for browsers without background-clip: text */
    color: var(--color-white);
  }

  .c-hero__desc {
    color: var(--color-white);
    margin: 0;
    max-width: 42rem;
    text-align: center;
  }

  /* --- Buttons row ----------------------------------------------------- */
  .c-hero__buttons {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    /* TODO: DS gap between hero CTAs. */
    gap: 1rem;
  }

  @media (max-width: 991px) {
    .c-hero__buttons {
      flex-direction: column;
      width: 100%;
    }
    .c-hero__buttons :global(.c-button) {
      width: 100%;
    }
  }

  /* --- Block 2: stats row ---------------------------------------------- */
  .c-hero__stats {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    /* TODO: DS gap between hero stats — tuned to hero.jpg. */
    gap: 4rem;
    width: 100%;
  }

  @media (max-width: 767px) {
    .c-hero__stats {
      gap: 2.5rem;
      max-width: 90%;
      flex-wrap: wrap;
    }
  }

  /* --- Stat overrides (hero context) -----------------------------------
     Spec: value at 88px Brulia white, label as c-paragraph @ 60% opacity.
     The Stat primitive is shared, so we scope hero-specific look here. */
  .c-hero__stats :global(.c-stat__value) {
    color: var(--color-white);
    text-align: center;
    font-family: var(--font-heading);
    font-size: 5.25rem;
    font-weight: 400;
    font-style: normal;
    line-height: 1.2;
    letter-spacing: -0.126rem;
  }
  .c-hero__stats :global(.c-stat__label) {
    /* Match c-paragraph (Acumin, ~1.04rem desktop, 1.5 line-height) then dim. */
    font-family: var(--font-body);
    font-size: var(--fs-p);
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-white);
    opacity: 0.6;
  }

  /* --- Eyebrow on-dark override ----------------------------------------
     Same pattern as CtaBanner. TODO: DS — replace with `is-on-dark` variant
     on the Eyebrow primitive so this scoped override retires. */
  .c-hero :global(.c-eyebrow.is-default) {
    border-color: rgba(255, 255, 255, 0.4);
    color: var(--color-white);
  }
  .c-hero :global(.c-eyebrow.is-default::before),
  .c-hero :global(.c-eyebrow.is-default::after) {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.6);
  }
</style>
