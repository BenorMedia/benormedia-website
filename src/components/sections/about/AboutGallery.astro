---
/**
 * AboutGallery — c-about-gallery
 * The hero photo strip (Figma 3815:27357): six 420px cards in one row,
 * wider than the viewport (2600px at the Figma frame); the section clips the
 * overflow, so the page never scrolls sideways. Each photo is bottom-aligned
 * at its Figma height.
 *
 * Motion (lead 2026-10-22): a slow, continuous right → left loop that reads
 * as an endless scroll. CSS only, same technique as `LogoStrip`: the set is
 * rendered twice and the track moves 0 → -50%, so the loop wraps
 * seamlessly. Each card carries its own 16px right margin (not a flex gap)
 * so both halves are exactly the same width. The copy is `aria-hidden` with
 * empty alt text: screen readers get the photos once. With
 * `prefers-reduced-motion: reduce` the strip stays still.
 *
 * TODO: ASSET (replace before release) — third-party placeholder photos.
 */
import { photoSrc, figmaRem, type AboutPhoto } from "./content";

interface Props {
  items: readonly { photo: AboutPhoto; height: number }[];
}

const { items } = Astro.props;
const loop = [false, true].flatMap((dup) => items.map((item) => ({ ...item, dup })));
---

<div class="c-about-gallery">
  <ul class="c-about-gallery__track" role="list">
    {loop.map(({ photo, height, dup }) => (
      <li class="c-about-gallery__card" aria-hidden={dup ? "true" : undefined}>
        {/* TODO: ASSET (replace before release) */}
        <img
          class="c-about-gallery__img"
          src={photoSrc(photo)}
          alt={dup ? "" : photo.alt}
          width={photo.w}
          height={photo.h}
          style={`--c-about-gallery-h: ${figmaRem(height)}`}
          loading="eager"
          decoding="async"
        />
      </li>
    ))}
  </ul>
</div>

<style>
  /* Figma: 60px below the hero text, 110px below the strip. */
  .c-about-gallery {
    margin-top: 4.286rem;
    padding-bottom: 7.857rem;
    overflow: hidden;
  }
  /* Two sets of six 420px cards, each followed by a 16px margin. */
  .c-about-gallery__track {
    display: flex;
    align-items: flex-end;
    width: max-content;
    height: 38.143rem; /* 534px */
    margin: 0;
    padding: 0;
    list-style: none;
    animation: c-about-gallery-scroll 90s linear infinite;
  }
  .c-about-gallery__card {
    flex: 0 0 30rem; /* 420px */
    display: flex;
    align-items: flex-end;
    height: 100%;
    margin-right: 1.143rem; /* 16px */
  }
  .c-about-gallery__img {
    display: block;
    width: 100%;
    height: var(--c-about-gallery-h);
    object-fit: cover;
    border-radius: 8px;
  }

  @keyframes c-about-gallery-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .c-about-gallery__track { animation: none; }
  }

  /* TODO: DS mobile (991px, 767px) — no design. The strip keeps its desktop
     layout (scaled by the root size) and stays clipped by the section. */
</style>
