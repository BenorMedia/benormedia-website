---
/**
 * Services — four service cards with 3D artwork (Figma 4092:5784 neutral,
 * 4092:6378 hover, 4092:6469 mobile; lead 2026-10-30). Used on Home and
 * the commercial pages (`NpCommercialPage`).
 *
 * Grid (≥992): 12 columns, two rows. Websites + Support span 6 each,
 * Growth 8, Rebrands 4. ≤991: one column (desktop card layout); ≤767: the
 * mobile cards (copy on top, artwork below it).
 *
 * The whole card is the link ("Learn more" stretched over it). Hover gets
 * the site's card hover (lift, accent border, shadow; lead 2026-10-30).
 *
 * Hover / focus (pointer devices ≥768) = the hover frame: "Learn more"
 * opens under the copy and each card runs its motion:
 *   1. Websites: the small shapes flow from the card's edges into the
 *      shield icon on an endless loop (lead 2026-10-30, as the blog's
 *      ThImageConverge); leaving stops them where they are (paused).
 *   2. Support: four more icons fade in, rising a little, one after the
 *      other; reverses on leave.
 *   3. Growth: each bar rises in turn (the bar image cut into its six
 *      columns with `clip-path`); reverses on leave.
 *   4. Rebrands: the cube columns rise in turn and three stars come up from
 *      below with one bounce; reverses on leave.
 * Touch devices and ≤767: "Learn more" always shows and the motion runs
 * while the card is in view (`src/scripts/animations/services-cards.ts`).
 * There the end state is the mobile frame. No JS on touch: the end state.
 * Reduced motion: the shapes stay still; states switch without movement.
 *
 * Artwork: Figma positions in Figma px (`--u` = one Figma px: 1/19.2 rem on
 * desktop, so the 1680px Figma grid fills the container; 1/10.8 rem on
 * phones, the 484px mobile frame at a 390px phone). Each piece is placed by
 * its centre from an anchor (0 / 50 / 100% of the card), so the artwork
 * keeps to its edge when the card is wider or narrower than in Figma.
 *
 * Links: the Websites, Support and Growth service pages. Full Rebrands has
 * no page yet, so its "Learn more" opens the contact modal (TODO: COPY —
 * lead to confirm, see the PR). Copy and titles are Figma's, not Sanity's.
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { ARROW_RIGHT } from "../new-pages/blog-icons";
import { streamPaths, type StreamBox } from "../ui/stream-shapes";

const IMG = "/images/home/services";

type Anchor = 0 | 50 | 100;
/** Centre of a piece in Figma px from its anchor (% of the card), its size and rotation. */
interface Place {
  ax: Anchor;
  x: number;
  ay: Anchor;
  y: number;
  w: number;
  h: number;
  r?: number;
  flip?: boolean;
}
interface Art {
  src: string;
  /** Desktop / mobile placement; a missing one hides the piece there. */
  d?: Place;
  m?: Place;
  /** Figma image crop inside the piece: width, height, left, top (%). */
  crop?: readonly [number, number, number, number];
  /** Extra custom properties (stagger index, clip edges). */
  vars?: Record<string, string | number>;
}

const artStyle = ({ d, m, crop, vars = {} }: Art): string => {
  const out: string[] = [];
  for (const [k, p] of [["d", d], ["m", m]] as const) {
    if (!p) continue;
    out.push(
      `--${k}-ax:${p.ax}`, `--${k}-x:${p.x}`, `--${k}-ay:${p.ay}`, `--${k}-y:${p.y}`,
      `--${k}-w:${p.w}`, `--${k}-h:${p.h}`, `--${k}-r:${p.r ?? 0}deg`, `--${k}-fy:${p.flip ? -1 : 1}`,
    );
  }
  if (crop) out.push(`--cw:${crop[0]}%`, `--ch:${crop[1]}%`, `--cl:${crop[2]}%`, `--ct:${crop[3]}%`);
  for (const [k, v] of Object.entries(vars)) out.push(`--${k}:${v}`);
  return out.join(";");
};
const artClass = (a: Art, ...extra: (string | false)[]) => [
  "c-services__art",
  { "is-crop": !!a.crop, "is-d-only": !a.m, "is-m-only": !a.d },
  ...extra.filter(Boolean),
];

// Background glows (Figma "Frame 2147237499 / 2147237500").
const BLOB_A_D: Place = { ax: 100, x: -139.77, ay: 0, y: 25.23, w: 681.88, h: 771.265 };
const BLOB_A_M: Place = { ax: 100, x: 60, ay: 0, y: 72.23, w: 681.88, h: 771.265 };
const BLOB_B_D: Place = { ax: 0, x: -1, ay: 0, y: 460.91, w: 681.88, h: 771.265 };
const blobA = (d: Place | undefined, m: Place = BLOB_A_M): Art => ({ src: `${IMG}/blob-a.svg`, m, ...(d && { d }) });
const blobB: Art = { src: `${IMG}/blob-b.svg`, d: BLOB_B_D };

// 1. Websites: Figma's two shapes streams, cut into their shapes, each
// flowing from beyond the card's edge into the glass icon on an endless loop
// (`stream-shapes.ts`). Desktop: from the card's top / right edges;
// mobile: from its left and right edges only, below the copy. A second set runs half a loop
// behind and only shows while the card is active, so the still frame is
// Figma's.
const STREAM_D: StreamBox[] = [
  { x: -400.06, y: 79.71, w: 604.055, h: 585.673, r: 29.57 },
  { x: -69.54, y: 280.6, w: 604.055, h: 585.673, r: -145.52, flip: true },
];
const STREAM_M: StreamBox[] = [
  { x: -198.83, y: -100.83, w: 604.055, h: 585.673, r: -1.02 },
  { x: 187.93, y: -96.06, w: 604.055, h: 585.673, r: -176.1, flip: true },
];
/* TODO: DS motion: no spec; Figma px per second, tuned by eye. */
const SHAPE_SPEED = 14;
const websitesShapes = (phase: number): Art[] => {
  const d = streamPaths(STREAM_D, { x: -252.6, y: 173.92 }, { x0: -822.77, y0: 0, x1: 0, y1: 388.81 }, SHAPE_SPEED, phase);
  const m = streamPaths(STREAM_M, { x: 0, y: -100.83 }, { x0: -212, y0: -482.4, x1: 212, y1: 0 }, SHAPE_SPEED, phase, "sides");
  return d.map((pd, i) => {
    const pm = m[i]!;
    const vars: Record<string, number> = {};
    for (const [k, p] of [["d", pd], ["m", pm]] as const) {
      Object.assign(vars, { [`${k}-sx`]: p.sx, [`${k}-sy`]: p.sy, [`${k}-ex`]: p.ex, [`${k}-ey`]: p.ey, [`${k}-dur`]: p.dur, [`${k}-delay`]: p.delay });
    }
    return {
      src: pd.src,
      d: { ax: 100, x: pd.x, ay: 0, y: pd.y, w: pd.w, h: pd.h, r: pd.r, flip: pd.flip },
      m: { ax: 50, x: pm.x, ay: 100, y: pm.y, w: pm.w, h: pm.h, r: pm.r, flip: pm.flip },
      vars,
    };
  });
};
const websitesShapesMain = websitesShapes(0);
const websitesShapesLate = websitesShapes(0.5);
const websitesGlass: Art = {
  src: `${IMG}/websites-icon.webp`,
  d: { ax: 100, x: -252.6, ay: 0, y: 173.92, w: 282.426, h: 282.421 },
  m: { ax: 50, x: 0, ay: 100, y: -100.83, w: 146.41, h: 146.407 },
};

// 2. Support: base icons + people; `reveal` pieces show on hover / in view.
const supportBase: Art[] = [
  {
    src: `${IMG}/support-pencil.webp`,
    d: { ax: 100, x: -424.08, ay: 0, y: 75.57, w: 87.8, h: 75.044, r: -4.74 },
    m: { ax: 50, x: -155.42, ay: 100, y: -144.8, w: 61.46, h: 52.531, r: -4.74 },
  },
  {
    src: `${IMG}/support-shield.webp`,
    d: { ax: 100, x: -265.39, ay: 0, y: 74.24, w: 103, h: 111.339, r: 5.16 },
    m: { ax: 50, x: -44.33, ay: 100, y: -145.73, w: 72.1, h: 77.938, r: 5.16 },
  },
  {
    src: `${IMG}/support-code.webp`,
    crop: [145.71, 158.73, -22.85, -29.36],
    d: { ax: 100, x: -194.34, ay: 0, y: 188.82, w: 87.8, h: 80.598, r: -11.77 },
    m: { ax: 50, x: 5.4, ay: 100, y: -65.53, w: 61.46, h: 56.419, r: -11.77 },
  },
  {
    src: `${IMG}/support-palette.webp`,
    crop: [162.04, 143.8, -31.02, -27.05],
    d: { ax: 100, x: -41.69, ay: 0, y: 95.22, w: 100, h: 112.685, r: -17.15 },
    m: { ax: 50, x: 112.25, ay: 100, y: -131.04, w: 70, h: 78.88, r: -17.15 },
  },
  blobA(BLOB_A_D),
  blobB,
  {
    src: `${IMG}/support-people.webp`,
    crop: [141.54, 137.73, -21.01, -22.3],
    d: { ax: 100, x: -193.35, ay: 0, y: 308.8, w: 434.079, h: 446.089 },
    m: { ax: 50, x: 0, ay: 100, y: -17.38, w: 303.855, h: 312.262 },
  },
];
// Behind everything (Figma layer order).
const supportRevealBack: Art = {
  src: `${IMG}/support-access.webp`,
  d: { ax: 100, x: -179.69, ay: 0, y: 369.26, w: 76.68, h: 76.8, r: 10.88 },
  vars: { i: 2 },
};
// Above the copy.
const supportRevealFront: Art[] = [
  {
    src: `${IMG}/support-plugs.webp`,
    crop: [151.96, 168.21, -25.98, -34.1],
    d: { ax: 0, x: 125.09, ay: 0, y: 33.54, w: 106.263, h: 96, r: -4.85 },
    vars: { i: 0 },
  },
  {
    src: `${IMG}/support-pin.webp`,
    crop: [175.93, 150.08, -39.29, -25.04],
    d: { ax: 0, x: 273.03, ay: 0, y: 21.35, w: 65.516, h: 76.8, r: 6.35 },
    m: { ax: 50, x: 199.31, ay: 100, y: -42.79, w: 65.516, h: 76.8, r: 6.35 },
    vars: { i: 1 },
  },
  {
    src: `${IMG}/support-layers.webp`,
    crop: [161.71, 153.31, -30.86, -22.49],
    d: { ax: 0, x: 324.51, ay: 0, y: 365.35, w: 91.014, h: 96, r: -7.63 },
    vars: { i: 3 },
  },
];

// 3. Growth: one bar image, drawn once per column (clip edges in % of the
// piece, from the image's column edges). Mobile sits 28px low and rises to
// the mobile frame's position.
const BAR_EDGES = [0, 16.97, 33.3, 49.5, 65.6, 81.59, 100];
const growthBars: Art[] = BAR_EDGES.slice(0, -1).map((left, i) => ({
  src: `${IMG}/growth-bars.webp`,
  crop: [114.46, 111.83, -7.28, -5.74],
  d: { ax: 100, x: -385.47, ay: 0, y: 235.9, w: 772.936, h: 745.541 },
  m: { ax: 50, x: 40.65, ay: 100, y: -36.5, w: 541.055, h: 521.879 },
  vars: { i, "clip-l": `${left}%`, "clip-r": `${100 - BAR_EDGES[i + 1]!}%` },
}));

// 4. Rebrands: the cube cluster in three columns (cut at the front cube's
// edges) + three stars, left to right. Mobile cubes sit 8px low.
const rebrandBlobA = blobA({ ...BLOB_A_D, ax: 50, x: 272.25 }, { ...BLOB_A_M, y: 49.23 });
const CUBE_EDGES = [0, 34.97, 63.3, 100];
const rebrandCubes: Art[] = CUBE_EDGES.slice(0, -1).map((left, i) => ({
  src: `${IMG}/rebrand-cubes.webp`,
  crop: [133.02, 141.29, -16.51, -17.54],
  d: { ax: 50, x: 0, ay: 0, y: 617.31, w: 893.963, h: 841.616 },
  m: { ax: 50, x: 3.81, ay: 100, y: 83.24, w: 536.378, h: 504.97 },
  vars: { i, "clip-l": `${left}%`, "clip-r": `${100 - CUBE_EDGES[i + 1]!}%` },
}));
const STAR_CROP = [130.68, 129.18, -15.62, -14.56] as const;
const rebrandStars: Art[] = [
  { d: [-159.16, 272.55, -22.63], m: [-91.69, -131.61] },
  { d: [-15.67, 282.09, 15.59], m: [-5.59, -125.9] },
  { d: [158.65, 257.54, 21.43], m: [99, -140.62] },
].map(({ d, m }, i) => ({
  src: `${IMG}/rebrand-star.webp`,
  crop: STAR_CROP,
  d: { ax: 50, x: d[0]!, ay: 0, y: d[1]!, w: 94.034, h: 89.64, r: d[2]! },
  m: { ax: 50, x: m[0]!, ay: 100, y: m[1]!, w: 56.42, h: 53.784, r: d[2]! },
  vars: { i },
}));

interface Card {
  key: "websites" | "support" | "growth" | "rebrand";
  /** `\n` = Figma's line break. */
  title: string;
  body: string;
  /** Service page; none = "Learn more" opens the contact modal. */
  href?: string;
}
const CARDS: Card[] = [
  {
    key: "websites",
    title: "Custom Websites\n& Migrations.",
    body: "Scalable, high-converting, and SEO/AEO optimized websites built using the right technologies for your business.",
    href: "/custom-websites-migrations",
  },
  {
    key: "support",
    title: "Ongoing Design and\nDevelopment Support.",
    body: "The strategy, design, development, and support needed to keep your website improving and scaling.",
    href: "/ongoing-website-support",
  },
  {
    key: "growth",
    title: "Website Growth\n(SEO/GEO + CRO).",
    body: "Drive revenue to your website through SEO, AEO, content strategy, and ongoing CRO improvements.",
    href: "/growth",
  },
  {
    key: "rebrand",
    title: "Full Rebrands.",
    body: "Positioning, messaging, and brand identity, live on your new site and all your marketing assets.",
  },
];
---

<section class="c-services" data-c-services>
  <Container>
    <SectionHeader
      eyebrow="Services"
      title="A site your team can run, and growth that keeps pipeline coming."
    />

    <div class="c-services__grid">
      {CARDS.map((card) => (
        <article class:list={["c-services__card", `is-${card.key}`]} data-c-services-card>
          <div class="c-services__media" aria-hidden="true">
            {card.key === "websites" && (
              <>
                <img class:list={artClass(blobA(BLOB_A_D))} style={artStyle(blobA(BLOB_A_D))} src={`${IMG}/blob-a.svg`} alt="" />
                {websitesShapesMain.map((a) => (
                  <img class:list={artClass(a, "is-shape")} style={artStyle(a)} src={a.src} alt="" loading="lazy" decoding="async" />
                ))}
                <span class="c-services__shapes-late">
                  {websitesShapesLate.map((a) => (
                    <img class:list={artClass(a, "is-shape")} style={artStyle(a)} src={a.src} alt="" loading="lazy" decoding="async" />
                  ))}
                </span>
                <span class:list={artClass(websitesGlass, "c-services__glass")} style={artStyle(websitesGlass)}>
                  <span class="c-services__glass-icon">
                    <img src={websitesGlass.src} alt="" loading="lazy" decoding="async" />
                  </span>
                </span>
              </>
            )}

            {card.key === "support" && (
              <>
                <span class:list={artClass(supportRevealBack, "is-reveal")} style={artStyle(supportRevealBack)}>
                  <img src={supportRevealBack.src} alt="" loading="lazy" decoding="async" />
                </span>
                {supportBase.map((a) => (
                  <span class:list={artClass(a)} style={artStyle(a)}>
                    <img src={a.src} alt="" loading="lazy" decoding="async" />
                  </span>
                ))}
              </>
            )}

            {card.key === "growth" && (
              <>
                <img class:list={artClass(blobB)} style={artStyle(blobB)} src={blobB.src} alt="" />
                <img class:list={artClass(blobA(undefined))} style={artStyle(blobA(undefined))} src={`${IMG}/blob-a.svg`} alt="" />
                {growthBars.map((a) => (
                  <span class:list={artClass(a, "is-rise", "is-bar")} style={artStyle(a)}>
                    <img src={a.src} alt="" loading="lazy" decoding="async" />
                  </span>
                ))}
              </>
            )}

            {card.key === "rebrand" && (
              <>
                <img class:list={artClass(rebrandBlobA)} style={artStyle(rebrandBlobA)} src={rebrandBlobA.src} alt="" />
                <img class:list={artClass(blobB)} style={artStyle(blobB)} src={blobB.src} alt="" />
                {rebrandCubes.map((a) => (
                  <span class:list={artClass(a, "is-rise", "is-cube")} style={artStyle(a)}>
                    <img src={a.src} alt="" loading="lazy" decoding="async" />
                  </span>
                ))}
              </>
            )}
          </div>

          <div class="c-services__copy">
            <h3 class="c-services__title c-text_m">{card.title}</h3>
            <p class="c-services__body c-paragraph">{card.body}</p>
            <div class="c-services__more-row">
              {card.href ? (
                <a class="c-services__more" href={card.href} aria-label={`Learn more about ${card.title.replace("\n", " ")}`}>
                  Learn more
                  <span class="c-services__arrow" set:html={ARROW_RIGHT} />
                </a>
              ) : (
                <button type="button" class="c-services__more" data-open-contact aria-label={`Learn more about ${card.title}`}>
                  Learn more
                  <span class="c-services__arrow" set:html={ARROW_RIGHT} />
                </button>
              )}
            </div>
          </div>

          {/* Artwork drawn over the copy (Figma layer order). */}
          {card.key === "support" && (
            <div class="c-services__media is-front" aria-hidden="true">
              {supportRevealFront.map((a) => (
                <span class:list={artClass(a, "is-reveal")} style={artStyle(a)}>
                  <img src={a.src} alt="" loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          )}
          {card.key === "rebrand" && (
            <div class="c-services__media is-front" aria-hidden="true">
              {rebrandStars.map((a) => (
                <span class:list={artClass(a, "is-star")} style={artStyle(a)}>
                  <img src={a.src} alt="" loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .c-services {
    /* One Figma px (see the header comment). */
    --u: calc(1rem / 19.2);
    /* TODO: DS motion: no spec for these; tuned by eye. */
    --c-services-stagger: 80ms;
    --c-services-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
    background: var(--color-white);
  }
  @media (max-width: 767px) {
    .c-services {
      --u: calc(1rem / 10.8);
    }
  }

  /* Breaks after "growth" as in Figma (that line is ≈64rem; with "that",
     ≈71rem); narrower screens wrap on their own. */
  .c-services :global(.c-section-header__title) {
    max-width: 67rem;
  }

  .c-services__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: calc(388.81 * var(--u));
    gap: calc(45.08 * var(--u));
    margin-top: calc(80 * var(--u));
  }
  .c-services__card.is-websites { grid-column: 1 / span 6; }
  .c-services__card.is-support { grid-column: 7 / span 6; }
  .c-services__card.is-growth { grid-column: 1 / span 8; }
  .c-services__card.is-rebrand { grid-column: 9 / span 4; }

  @media (max-width: 991px) {
    .c-services__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .c-services__grid .c-services__card {
      grid-column: 1;
    }
  }
  @media (max-width: 767px) {
    .c-services__grid {
      grid-auto-rows: auto;
      gap: calc(30 * var(--u));
    }
  }

  /* --- Card ----------------------------------------------------------- */
  .c-services__card {
    /* 1 while the card shows its hover / in-view state, else 0. */
    --on: 0;
    position: relative;
    /* Own stacking context: the artwork sits under the copy at z -1. */
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-white);
    transition:
      transform var(--duration-hover) var(--ease-smooth),
      border-color var(--duration-hover) var(--ease-smooth),
      box-shadow var(--duration-hover) var(--ease-smooth);
  }
  /* The site's card hover (ClientCard, lead 2026-09-30): lift, accent
     border, c-button's hover shadow. Pointer devices only. */
  @media (hover: hover) and (min-width: 768px) {
    .c-services__card:hover {
      transform: translateY(-3%);
      border-color: var(--color-accent);
      box-shadow: 0 0 20px #2223;
    }
  }
  .c-services__card.is-websites,
  .c-services__card.is-support {
    justify-content: flex-end;
  }
  @media (max-width: 767px) {
    .c-services__card.is-websites,
    .c-services__card.is-support {
      justify-content: flex-start;
    }
  }

  .c-services__card.is-active,
  .c-services__card:has(:focus-visible) {
    --on: 1;
  }
  @media (hover: hover) and (min-width: 768px) {
    .c-services__card:hover {
      --on: 1;
    }
  }
  /* Touch, no JS: the end state. */
  @media (hover: none), (max-width: 767px) {
    .c-services:not(.is-enhanced) .c-services__card {
      --on: 1;
    }
  }

  .c-services__card:has(.c-services__more:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* --- Copy ------------------------------------------------------------- */
  /* As wide as its lines: Figma's body boxes are a little wider than the
     padded text frame, so a fixed frame width would wrap them early. */
  /* Not positioned, so the "Learn more" hit area (::after) spans the card. */
  .c-services__copy {
    width: fit-content;
    max-width: 100%;
    padding: calc(40 * var(--u));
  }
  /* Lines follow Figma's breaks (`\n`); the DS title size is a little larger
     than Figma's, so no width cap on desktop. */
  .c-services__title {
    margin: 0;
    color: var(--color-black-secondary);
    white-space: pre-line;
  }
  /* Figma's body widths, a few px wider so Acumin breaks on Figma's lines. */
  .c-services__body {
    max-width: calc(372 * var(--u));
    margin: calc(14 * var(--u)) 0 0;
    color: var(--color-text);
  }
  @media (min-width: 768px) {
    .c-services__card.is-support .c-services__body { max-width: calc(326 * var(--u)); }
    .c-services__card.is-growth .c-services__body { max-width: calc(336 * var(--u)); }
    .c-services__card.is-rebrand .c-services__body { max-width: calc(334 * var(--u)); }
  }

  /* "Learn more": a fixed-height row that opens with the card state, so the
     bottom-aligned copy slides up as it opens. */
  .c-services__more-row {
    --more-fs: var(--fs-p-s);
