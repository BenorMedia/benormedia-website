---
/**
 * OurWork — Home "Our Work" section.
 *
 *   1. Header + 3×2 card grid — one `ClientCard variant="grid"` per `clients`.
 *   2. Client list — shared `ClientList` fed by `listClients`.
 *   3. "View All" CTA → /work.
 *
 * Order is preserved by the `getClientsByIds` fetcher in `src/pages/index.astro`.
 *
 * `title` (optional): replaces the H2 (the new pages pass their own section
 * heading). Without it the Home title renders unchanged.
 */
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import ClientCard from "../ui/ClientCard.astro";
import ClientList from "../ui/ClientList.astro";
import Button from "../ui/Button.astro";
import { ARROW_RIGHT } from "../new-pages/blog-icons";
import type { Client } from "../../lib/sanity/types";

interface Props {
  clients: Client[];
  listClients: Client[];
  title?: string;
  /** Button text under the list (Home says "See", lead 2026-11-04). */
  ctaLabel?: string;
}

const { clients, listClients, title, ctaLabel = "View All 100+ Projects" } = Astro.props;

// Full-height wordmarks read larger than icon + text logos at the same box
// height — render them one step smaller (lead visual QA 2026-09-28).
const COMPACT_LOGOS = new Set(["client-surfe", "client-arrows"]);
---

<section class="c-work">
  <Container>
    <SectionHeader
      eyebrow="Our Work"
      title={title ?? "Trusted by 100+ growing B2B\ncompanies and enterprises."}
      class="c-work__header"
    />

    <div class="c-work__grid">
      {clients.map((client) => (
        <ClientCard
          variant="grid"
          client={client}
          logoSize={COMPACT_LOGOS.has(client._id) ? "compact" : "default"}
        />
      ))}
    </div>

    <div class="c-work__list">
      <ClientList clients={listClients} limit={9} />
    </div>

    <div class="c-work__cta">
      <Button variant="gradient" href="/work">
        {ctaLabel}
        <span slot="icon" class="c-work__cta-icon" set:html={ARROW_RIGHT} />
      </Button>
    </div>
  </Container>
</section>

<style>
  .c-work {
    background: var(--color-white);
  }

  .c-work__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 1.3rem;
    row-gap: 1.3rem;
    /* TODO: DS space between section header and grid. */
    margin-top: 3rem;
  }

  @media (max-width: 991px) {
    .c-work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Wrapper for the shared ClientList (width is capped by the list's own
     max-width). */
  .c-work__list {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .c-work__cta {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 2.5em; /* lead request 2026-09-28 (em, not rem) */
  }

  /* The site's arrow (lead 2026-11-03), in the old 24px slot. */
  .c-work__cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem; /* 24px */
    height: 1.5rem;
    transition: transform var(--duration-hover) var(--ease-smooth);
  }
  .c-work__cta-icon :global(svg) {
    width: 1.143rem;
    height: 1.177rem;
  }
  /* Hover: the arrow tilts up like every other arrow icon (ClientCard,
     ClientList: −30.963deg). Lead 2026-09-30. */
  .c-work__cta :global(.c-button:hover) .c-work__cta-icon,
  .c-work__cta :global(.c-button:focus-visible) .c-work__cta-icon {
    transform: rotate(-30.963deg);
  }

  @media (max-width: 767px) {
    .c-work__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
