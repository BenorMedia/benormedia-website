---
/**
 * JsonLd — one `application/ld+json` script. `<` is escaped so the JSON can
 * never close the script element (same as Breadcrumbs / FaqSection).
 */
interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;
const json = JSON.stringify(data).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />
