---
/**
 * CookieConsent — c-cookie-consent (every page, BaseLayout; lead 2026-09-30).
 *
 * Consent banner for Google Tag Manager. GTM loads only after "Accept all"
 * (lead 2026-09-30; logic in src/scripts/ui/cookie-consent.ts):
 *   - Shows on every page load until the visitor accepts.
 *   - "Accept all": sets the `bm_consent=granted` cookie (180 days) and loads
 *     GTM right away (production only; BaseLayout).
 *   - "Reject all": hides it for this page view; nothing is stored, so it
 *     shows again on the next page load.
 *   - Any `.js-open-cookie-consent` element reopens it (hook only: the
 *     footer "Cookie Settings" link was removed, lead 2026-09-30).
 *
 * Non-modal (a fixed card at the bottom, no focus trap): the page stays
 * usable. Reject is as easy to reach as accept (one click, same size).
 * Look (lead 2026-09-30): frosted glass + the nav dropdown panel's shadow.
 * The 5% `--color-surface-glass` made it unreadable over the blue hero
 * (grey text and "Reject all" disappeared), so it uses the nav's scrolled
 * glass (white 80% + 10px blur) instead.
 * No JS: never shown, and GTM never loads.
 *
 * No design in Figma: built with DS tokens and the existing Button
 * variants. TODO: DS (layout / sizes), TODO: COPY (text).
 */
import Button from "../ui/Button.astro";
---

<section class="c-cookie-consent" aria-label="Cookie consent" hidden data-cookie-consent>
  <p class="c-cookie-consent__text c-paragraph_s">
    {/* TODO: COPY */}
    We use cookies to understand how visitors use our site and to improve it.
    You can accept or reject analytics and marketing cookies. Read our{" "}
    <a href="/cookie-policy">Cookie Policy</a>.
  </p>
  <div class="c-cookie-consent__buttons">
    <Button variant="gradient-outline" class="js-cookie-reject">Reject all</Button>
    <Button variant="gradient" class="js-cookie-accept">Accept all</Button>
  </div>
</section>

<script>
  import { acceptConsent, hasConsent, rejectConsent } from "../../scripts/ui/cookie-consent";

  const banner = document.querySelector<HTMLElement>("[data-cookie-consent]");
  if (banner) {
    const open = (): void => {
      banner.hidden = false;
    };
    const close = (): void => {
      banner.hidden = true;
    };

    if (!hasConsent()) open();
    banner.querySelector(".js-cookie-accept")?.addEventListener("click", () => {
      acceptConsent();
      close();
    });
    banner.querySelector(".js-cookie-reject")?.addEventListener("click", () => {
      rejectConsent();
      close();
    });
    document.querySelectorAll(".js-open-cookie-consent").forEach((el) => {
      el.addEventListener("click", open);
    });
  }
</script>

<style>
  .c-cookie-consent {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 90; /* below the nav (100); the contact modal is in the top layer */
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: min(30rem, calc(100% - 3rem));
    padding: 1.5rem;
    border: var(--border-default);
    border-radius: 8px;
    /* Glass + shadow (lead 2026-09-30): the nav's scrolled glass (white 80%
       + blur; the 5% glass token was unreadable over the blue hero);
       shadow = the nav dropdown panel's. */
    background-color: rgba(255, 255, 255, 0.8);
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    box-shadow: 0 0 30px 0 rgba(0, 0, 0, 0.15);
  }
  .c-cookie-consent[hidden] {
    display: none;
  }

  .c-cookie-consent__text {
    margin: 0;
    color: var(--color-text);
  }
  .c-cookie-consent__text a {
    color: inherit;
    text-decoration: underline;
  }

  /* Two equal buttons side by side. */
  .c-cookie-consent__buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .c-cookie-consent__buttons :global(.c-button) {
    width: 100%;
  }

  /* TODO: DS mobile — full width at the bottom. */
  @media (max-width: 767px) {
    .c-cookie-consent {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      width: auto;
    }
  }
</style>
