---
/**
 * Seo — resolves meta from (pageSeo) → (component props) → (siteSettings defaults).
 * Applies siteSettings.titleTemplate to the resolved title unless the title
 * equals defaultMetaTitle (avoids double-templating the site name on Home).
 * Emits robots noindex when noIndex OR pageSeo.noIndex OR PUBLIC_SITE_ENV !== 'production'.
 */
import type { Seo, SiteSettings, SanityImage } from "../../lib/sanity/types";
import { urlFor } from "../../lib/sanity/image";

type OgImage = SanityImage | string;

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: OgImage | undefined;
  noIndex?: boolean | undefined;
  canonicalUrl?: string | undefined;
  pageSeo?: Seo | null | undefined;
  siteSettings?: SiteSettings | null | undefined;
}

const {
  title: titleProp,
  description: descriptionProp,
  ogImage: ogImageProp,
  noIndex: noIndexProp = false,
  canonicalUrl: canonicalUrlProp,
  pageSeo,
  siteSettings,
} = Astro.props;

// --- Resolution chain -------------------------------------------------------
const rawTitle =
  pageSeo?.metaTitle ?? titleProp ?? siteSettings?.defaultMetaTitle ?? siteSettings?.siteName ?? "BenorMedia";

const description =
  pageSeo?.metaDescription ?? descriptionProp ?? siteSettings?.defaultMetaDescription ?? undefined;

// Last fallback: the static brand image (docs/refs/benor/open-graph.png as a
// 1200×630 JPEG, lead 2026-10-01).
const DEFAULT_OG_IMAGE = "/images/og-default.jpg";
const ogImageResolved: OgImage =
  pageSeo?.ogImage ?? ogImageProp ?? siteSettings?.defaultOgImage ?? DEFAULT_OG_IMAGE;

// Title template ------------------------------------------------------------
const template = siteSettings?.titleTemplate ?? "%s | BenorMedia";
// Template only applies to a page-specific title. A fallback to the default
// title or the site name is used as-is (avoids "BenorMedia | BenorMedia").
const titleFromPage = !!(pageSeo?.metaTitle ?? titleProp);
const isDefaultTitle =
  !!siteSettings?.defaultMetaTitle && rawTitle === siteSettings.defaultMetaTitle;
const title = titleFromPage && !isDefaultTitle ? template.replace("%s", rawTitle) : rawTitle;

// Robots --------------------------------------------------------------------
const envIsProd = import.meta.env["PUBLIC_SITE_ENV"] === "production";
const shouldNoIndex = noIndexProp || pageSeo?.noIndex === true || !envIsProd;
const robots = shouldNoIndex ? "noindex, nofollow" : "index, follow";

// Canonical URL -------------------------------------------------------------
// Base = siteSettings.siteUrl, else Astro `site` (PUBLIC_SITE_URL env). With
// neither, canonical + og:url are omitted rather than pointing at localhost.
// No trailing slash (`trailingSlash: 'never'`); the build still reports
// `/work/` (directory format), so strip it. Home stays `/`.
const siteUrl = siteSettings?.siteUrl?.replace(/\/$/, "");
const pathname = Astro.url.pathname.replace(/(.)\/$/, "$1");
const canonical = canonicalUrlProp
  ?? pageSeo?.canonicalUrl
  ?? (siteUrl
    ? `${siteUrl}${pathname}`
    : Astro.site
      ? new URL(pathname, Astro.site).toString()
      : undefined);

// OG image URL --------------------------------------------------------------
// Every source is 1200×630 (Sanity crops to it). Site paths ("/images/…")
// need an absolute URL: same base as the canonical; without one they are
// omitted (no localhost URLs), like the canonical.
const siteBase = siteUrl ?? (Astro.site ? Astro.site.toString().replace(/\/$/, "") : undefined);
function resolveOgImage(img: OgImage): string | undefined {
  if (typeof img === "string") {
    if (/^https?:\/\//.test(img)) return img;
    return siteBase ? `${siteBase}${img.startsWith("/") ? "" : "/"}${img}` : undefined;
  }
  if (!img.asset) return resolveOgImage(DEFAULT_OG_IMAGE);
  return urlFor(img).width(1200).height(630).fit("crop").url();
}
const ogImageUrl = resolveOgImage(ogImageResolved);

const ogType = "website";
const siteName = siteSettings?.siteName ?? "BenorMedia";
const twitterHandle = siteSettings?.twitterHandle;
const googleSiteVerification = siteSettings?.googleSiteVerification;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{canonical && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />

<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && <meta property="og:image:width" content="1200" />}
{ogImageUrl && <meta property="og:image:height" content="630" />}
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />

<meta name="twitter:card" content="summary_large_image" />
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

{googleSiteVerification && (
  <meta name="google-site-verification" content={googleSiteVerification} />
)}
