---
/**
 * CtaBanner — c-cta
 * Global gradient CTA rendered above the footer (BaseLayout, every page
 * unless `showCtaBanner={false}`).
 *
 * Structure: <section class="c-cta-section"> → <Container> → .c-cta.
 *
 * Content: siteSettings.ctaBanner when it has a title; otherwise the approved
 * design copy below (docs/refs/cta-banner.png), so the banner always renders.
 *
 * Trusted badge (below the buttons, docs/refs/trusted-badge.png): text left,
 * circles right = 6 client `badge` images + the static "+" circle. All badge
 * URLs ship in `data-cta-badges`; `src/scripts/animations/cta-badges.ts`
 * (initialized from BaseLayout) rotates the 6 client circles every 5s.
 *
 * Eyebrow needs an on-dark override — the default eyebrow has a gray
 * border + dark text that are unreadable on the gradient. Overridden
 * scoped to `.c-cta` here; flagged in DECISIONS as a possible DS gap.
 */
import type { SiteSettings, Link, Button as ButtonType } from "../../lib/sanity/types";
import type { CtaBanner as CtaBannerData } from "../../lib/sanity/types";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Container from "../ui/Container.astro";
import { getClientBadgesCached } from "../../lib/sanity/site";
import { urlFor, type Source } from "../../lib/sanity/image";

interface Props {
  siteSettings?: SiteSettings | null | undefined;
}

const { siteSettings } = Astro.props;
// Approved design copy — used until siteSettings.ctaBanner is filled in Sanity.
const FALLBACK: CtaBannerData = {
  title: "Ready to build your website? Let's chat.",
  buttons: [
    { variant: "white", link: { label: "Get in Touch", type: "contact" } },
    {
      variant: "glass",
      link: {
        label: "See Pricing",
        type: "internal",
        internalRef: { _id: "pricingPage", _type: "pricingPage", title: "Pricing" },
      },
    },
  ],
};

const cta = siteSettings?.ctaBanner?.title ? siteSettings.ctaBanner : FALLBACK;
const shouldRender = !!cta.title;

// --- Helpers --------------------------------------------------------------
const pageTypeToPath: Record<string, string> = {
  homePage: "/",
  workPage: "/work",
  pricingPage: "/pricing",
  testimonialsPage: "/testimonials",
  blogPage: "/blog",
};

function hrefFromLink(link: Link | undefined): string | undefined {
  if (!link) return undefined;
  if (link.type === "external") return link.externalUrl;
  if (link.type === "contact") return "#";
  if (link.type === "internal" && link.internalRef) {
    const ref = link.internalRef;
    if (ref._type === "post" && ref.slug?.current) return `/blog/${ref.slug.current}`;
    return pageTypeToPath[ref._type];
  }
  return undefined;
}

const buttons = cta?.buttons ?? [];

// --- Trusted badge ----------------------------------------------------------
const BADGES_SHOWN = 6;
const trustedText = cta.socialProofText?.trim() || "Trusted by +100 companies";
const badgePool = (await getClientBadgesCached())
  .filter((c) => c.badge?.asset)
  // 31.68px circle at 2x density.
  .map((c) => urlFor(c.badge as Source).width(64).height(64).fit("crop").auto("format").url());
const badgesInitial = badgePool.slice(0, BADGES_SHOWN);
---

{shouldRender && cta && (
<section class="c-cta-section" aria-labelledby="cta-banner-title">
  <Container>
  <div class="c-cta">
    <div class="c-cta__inner">
      <Eyebrow variant="default" class="c-cta__eyebrow">GET IN TOUCH</Eyebrow>
      <h2 id="cta-banner-title" class="c-text_xl c-cta__title">{cta.title}</h2>

      <div class="c-cta__actions">
      {buttons.length > 0 && (
        <div class="c-cta__buttons">
          {buttons.map((b: ButtonType) => {
            const href = hrefFromLink(b.link);
            const isContact = b.link?.type === "contact";
            const target = b.link?.openInNewTab ? "_blank" : undefined;
            return isContact ? (
              <Button variant={b.variant} class="js-open-contact">{b.link.label}</Button>
            ) : (
              <a
                href={href ?? "#"}
                class={`c-button is-${b.variant}`}
                target={target}
                rel={target === "_blank" ? "noopener" : undefined}
              >
                <span class="c-button__text">{b.link?.label}</span>
              </a>
            );
          })}
        </div>
      )}

      <div class="c-cta__badge" data-cta-badges={JSON.stringify(badgePool)}>
        <div class="c-cta__badge-row">
          <p class="c-cta__badge-text c-paragraph">
            <span class="c-cta__badge-star" aria-hidden="true">★</span>{" "}{trustedText}
          </p>
          <span class="c-cta__badge-circles" aria-hidden="true">
            {badgesInitial.length > 0 && (
              <span class="c-cta__badge-group" data-cta-badges-group>
                {badgesInitial.map((src) => (
                  <img class="c-cta__badge-circle" src={src} alt="" width="32" height="32" loading="lazy" decoding="async" data-cta-badge />
                ))}
              </span>
            )}
            <img class="c-cta__badge-circle" src="/images/more-badge.png" alt="" width="32" height="32" loading="lazy" decoding="async" />
          </span>
        </div>
      </div>
      </div>
    </div>

    <img
      src="/images/cta-banner-vector.svg"
      alt=""
      aria-hidden="true"
      class="c-cta__vector"
    />
  </div>
  </Container>
</section>
)}

<style>
  /* Section spacing: no top padding (the section above already provides
     it); bottom padding stays the container default. */
  .c-cta-section :global(.c-container) {
    padding-top: 0;
  }

  .c-cta {
    position: relative;
    overflow: hidden;
    border-radius: 0.455rem;
    background: linear-gradient(290deg, var(--color-blue-light) 8.49%, var(--color-blue) 91.51%);
    color: var(--color-white);
    display: flex;
    padding: 5rem 2.625rem 0 2.625rem;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.875rem;
    align-self: stretch;
  }
  .c-cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .c-cta__title {
    color: var(--color-white);
    max-width: 60%;
  }
  /* Buttons + trusted badge share one width: the wrapper shrinks to its
     widest child (the badge) and the buttons stretch to fill it. */
  .c-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: fit-content;
    max-width: 100%;
    gap: 1.5rem; /* same spacing as before (c-cta__inner gap) */
    margin-top: 0.5rem;
  }
  /* Equal-width columns (one per button, however many Sanity sends),
     stretched to the wrapper width. Grid keeps them identical even when
     only one variant has a border. */
  .c-cta__buttons {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1rem;
  }

  /* --- Trusted badge (docs/refs/trusted-badge.png) ------------------- */
  .c-cta__badge {
    display: flex;
    padding: 0.4946rem 0.8902rem; /* 7.913px 14.243px */
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.5341rem; /* 8.546px */
    border-radius: 0.2576rem; /* 4.121px */
    /* rgba(255,255,255,0.10) expressed from the white token. */
    background: color-mix(in srgb, var(--color-white) 10%, transparent);
    /* Lead-approved shadow exception (2026-09-28), see DECISIONS.md.
       7.121px 2.849px 28.486px 0 rgba(0,0,0,0.05) */
    box-shadow: 0.445rem 0.178rem 1.7804rem 0 rgba(0, 0, 0, 0.05);
  }

  .c-cta__badge-row {
    display: flex;
    align-items: center;
    /* TODO: DS gap text → circles (ref ≈ 14px). */
    gap: 0.875rem;
  }

  .c-cta__badge-text {
    margin: 0;
    color: var(--color-white);
    white-space: nowrap;
  }

  .c-cta__badge-star {
    font-size: 0.75em;
    vertical-align: 0.1em;
  }

  .c-cta__badge-circles,
  .c-cta__badge-group {
    display: flex;
    align-items: center;
  }

  .c-cta__badge-group {
    opacity: 1;
    transition: opacity var(--duration-hover) var(--ease-smooth);
  }

  /* Set by cta-badges.ts while the 6 client circles are swapped. */
  .c-cta__badge-group.is-fading {
    opacity: 0;
  }

  .c-cta__badge-circle {
    flex: 0 0 auto;
    display: block;
    width: 1.98rem; /* 31.68px */
    height: 1.98rem;
    border-radius: 999px;
    object-fit: cover;
  }

  /* Circles overlap like a stack. TODO: DS overlap (ref ≈ 20%). */
  .c-cta__badge-circle + .c-cta__badge-circle,
  .c-cta__badge-group + .c-cta__badge-circle {
    margin-left: -0.4rem;
  }

  /* Decorative vector */
  .c-cta__vector {
    position: relative;
    z-index: 0;
    width: min(60rem, 90%);
    height: auto;
    pointer-events: none;
    display: block;
  }

  /* --- Eyebrow on-dark override -----------------------------------------
     TODO: DS eyebrow on-dark variant — default eyebrow uses --color-gray border
     + --color-text; unreadable on gradient. Scoped override until DS confirms. */
  .c-cta :global(.c-eyebrow.is-default) {
    border-color: rgba(255, 255, 255, 0.4);
    color: var(--color-white);
  }
  .c-cta :global(.c-eyebrow.is-default::before),
  .c-cta :global(.c-eyebrow.is-default::after) {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 991px) {
    .c-cta { padding: 4rem 2rem 0; }
  }
  @media (max-width: 767px) {
    .c-cta { padding: 3rem 1.25rem 0; }
    .c-cta__inner { gap: 1.25rem; }
    .c-cta__actions { gap: 1.25rem; }
    .c-cta__title { max-width: 100%; }
  }
</style>
