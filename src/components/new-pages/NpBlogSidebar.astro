---
/**
 * NpBlogSidebar — the blog article template's left column. Table of
 * Contents in the 2026-10-08 style (Figma 3718:7504): a bordered box with
 * the label as a tab on its top border, one-line uppercase items (cut with
 * an ellipsis), the item in view led by an arrow. Then a full-width Get in
 * Touch (the header's contact trigger) and the Share row (copy link,
 * LinkedIn, X, Facebook). Sticky on desktop. A few lines of vanilla JS: the
 * active item and copy link.
 */
import Button from "../ui/Button.astro";
import copy from "../../lib/new-pages/copy.json";
import { SHARE_FACEBOOK, SHARE_LINK, SHARE_LINKEDIN, SHARE_X, TOC_ARROW } from "./blog-icons";

interface Props {
  items: readonly { id: string; html: string }[];
  url: string;
}

const { items, url } = Astro.props;
const enc = encodeURIComponent(url);
const shares = [
  { label: copy.blog.shareLinkedin, href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc}`, icon: SHARE_LINKEDIN },
  { label: copy.blog.shareX, href: `https://x.com/intent/post?url=${enc}`, icon: SHARE_X },
  { label: copy.blog.shareFacebook, href: `https://www.facebook.com/sharer/sharer.php?u=${enc}`, icon: SHARE_FACEBOOK },
];
---

<div class="c-np-sidebar" data-np-sidebar>
  <nav class="c-np-sidebar__toc" aria-label={copy.accessibleNames.toc}>
    <p class="c-np-sidebar__title">{copy.tocLabel}</p>
    <ol class="c-np-sidebar__list">
      {items.map((item) => (
        <li>
          <a class="c-np-sidebar__link" href={`#${item.id}`} data-np-toc={item.id}>
            <span class="c-np-sidebar__arrow" set:html={TOC_ARROW} />
            <span class="c-np-sidebar__label" set:html={item.html} />
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="c-np-sidebar__cta-wrap">
    <Button variant="gradient" class="js-open-contact c-np-sidebar__cta">{copy.buttons.contact}</Button>
  </div>
  <div class="c-np-sidebar__share">
    <span class="c-np-sidebar__share-label c-paragraph_s">{copy.blog.share}</span>
    <span class="c-np-sidebar__share-line" aria-hidden="true"></span>
    <span class="c-np-sidebar__share-buttons">
      <button type="button" class="c-np-sidebar__share-btn" aria-label={copy.blog.copyLink} data-np-copy={url} set:html={SHARE_LINK} />
      {shares.map((s) => (
        <a class="c-np-sidebar__share-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label} set:html={s.icon} />
      ))}
    </span>
  </div>
</div>

<script>
  // Active table of contents item: the last heading above the upper third.
  document.querySelectorAll<HTMLElement>("[data-np-sidebar]").forEach((bar) => {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>("[data-np-toc]")];
    const heads = links
      .map((a) => document.getElementById(a.dataset["npToc"] ?? ""))
      .filter((h): h is HTMLElement => h !== null);
    const update = (): void => {
      const line = window.innerHeight / 3;
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top <= line) current = h;
      links.forEach((a) => a.classList.toggle("is-active", a.dataset["npToc"] === current?.id));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    bar.querySelector<HTMLButtonElement>("[data-np-copy]")?.addEventListener("click", (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      void navigator.clipboard?.writeText(btn.dataset["npCopy"] ?? location.href);
      btn.classList.add("is-done");
      window.setTimeout(() => btn.classList.remove("is-done"), 1500);
    });
  });
</script>

<style>
  .c-np-sidebar {
    position: sticky;
    top: calc(var(--c-nav-height, 0px) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.857rem; /* 12px */
    /* Room for the label tab, which sits on the box's top border. */
    padding-top: 1.429rem;
  }
  /* Figma 3718:7504: 1px border, 8px radius. Left padding = right (lead
     2026-10-09). */
  .c-np-sidebar__toc {
    position: relative;
    padding: 3.214rem 1.786rem 2.857rem;
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-white);
  }
  /* The label: an eyebrow-style tab centred on the top border. */
  .c-np-sidebar__title {
    position: absolute;
    top: 0;
    left: 1.071rem;
    margin: 0;
    padding: 0.5em 1.05em;
    transform: translateY(-50%);
    border: var(--border-default);
    border-radius: 3px;
    background: var(--color-white);
    color: var(--color-text-secondary);
    font-size: var(--fs-p);
    line-height: normal;
    letter-spacing: 0.064em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Max 60vh with its own scroll (lead 2026-10-07). */
  .c-np-sidebar__list {
    display: flex;
    flex-direction: column;
    gap: 1.786rem; /* 25px */
    max-height: 60vh;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
  }
  .c-np-sidebar__link {
    display: flex;
    align-items: center;
    min-width: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-p-s);
    line-height: 1.4;
    letter-spacing: 0.064em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-smooth);
  }
  .c-np-sidebar__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Active item: the arrow slides in before the label. */
  .c-np-sidebar__arrow {
    display: inline-flex;
    flex: 0 0 auto;
    width: 0;
    height: 1.429rem;
    margin-right: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      width var(--duration-hover) var(--ease-smooth),
      margin-right var(--duration-hover) var(--ease-smooth),
      opacity var(--duration-hover) var(--ease-smooth);
  }
  .c-np-sidebar__arrow :global(svg) {
    flex: 0 0 auto;
    width: 1.429rem;
    height: 1.429rem;
  }
  .c-np-sidebar__link.is-active .c-np-sidebar__arrow {
    width: 1.429rem;
    margin-right: 0.857rem;
    opacity: 1;
  }
  .c-np-sidebar__link:hover {
    color: var(--color-accent);
  }
  .c-np-sidebar__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-np-sidebar :global(.c-np-sidebar__cta) {
    width: 100%;
  }
  .c-np-sidebar__share {
    display: flex;
    align-items: center;
    gap: 0.571rem;
  }
  .c-np-sidebar__share-label {
    color: var(--color-black-secondary);
  }
  .c-np-sidebar__share-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .c-np-sidebar__share-buttons {
    display: flex;
    gap: 0.571rem;
  }
  .c-np-sidebar__share-btn {
    display: grid;
    place-items: center;
    width: 2.286rem;
    height: 2.286rem;
    padding: 0.286rem;
    border: 0;
    background: none;
    color: var(--color-black-secondary);
    cursor: pointer;
  }
  .c-np-sidebar__share-btn :global(svg) {
    width: 100%;
    height: 100%;
  }
  .c-np-sidebar__share-btn:hover,
  .c-np-sidebar__share-btn.is-done {
    color: var(--color-accent);
  }
  .c-np-sidebar__share-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .c-np-sidebar__arrow {
      transition: none;
    }
  }
  @media (max-width: 991px) {
    .c-np-sidebar {
      position: static;
    }
  }
  @media (max-width: 767px) {
    .c-np-sidebar__toc {
      padding: 2.857rem 1.429rem 2.143rem;
    }
    .c-np-sidebar__title {
      left: 0.714rem;
    }
    /* Half the previous mobile size (lead 2026-10-08). */
    .c-np-sidebar__share-btn {
      width: 2.222rem;
      height: 2.222rem;
    }
  }
</style>
