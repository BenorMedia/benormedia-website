---
/**
 * NpBlogSidebar — the blog article template's left column (Figma
 * 3142:1618038): "Table of Contents" (the body H2s and the FAQ; the item
 * in view is boxed), a full-width Get in Touch (the header's contact
 * trigger) and the Share row (copy link, LinkedIn, X, Facebook). Sticky
 * on desktop. A few lines of vanilla JS: the active item and copy link.
 */
import Button from "../ui/Button.astro";
import copy from "../../lib/new-pages/copy.json";
import { SHARE_FACEBOOK, SHARE_LINK, SHARE_LINKEDIN, SHARE_X } from "./blog-icons";

interface Props {
  items: readonly { id: string; html: string }[];
  url: string;
}

const { items, url } = Astro.props;
const enc = encodeURIComponent(url);
const shares = [
  { label: copy.blog.shareLinkedin, href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc}`, icon: SHARE_LINKEDIN },
  { label: copy.blog.shareX, href: `https://x.com/intent/post?url=${enc}`, icon: SHARE_X },
  { label: copy.blog.shareFacebook, href: `https://www.facebook.com/sharer/sharer.php?u=${enc}`, icon: SHARE_FACEBOOK },
];
---

<div class="c-np-sidebar" data-np-sidebar>
  <nav class="c-np-sidebar__toc" aria-label={copy.accessibleNames.toc}>
    <p class="c-np-sidebar__title c-text_m">{copy.tocLabel}</p>
    <ol class="c-np-sidebar__list">
      {items.map((item) => (
        <li><a class="c-np-sidebar__link c-paragraph" href={`#${item.id}`} data-np-toc={item.id} set:html={item.html} /></li>
      ))}
    </ol>
  </nav>
  <div class="c-np-sidebar__cta-wrap">
    <Button variant="gradient" class="js-open-contact c-np-sidebar__cta">{copy.buttons.contact}</Button>
  </div>
  <div class="c-np-sidebar__share">
    <span class="c-np-sidebar__share-label c-paragraph_s">{copy.blog.share}</span>
    <span class="c-np-sidebar__share-line" aria-hidden="true"></span>
    <span class="c-np-sidebar__share-buttons">
      <button type="button" class="c-np-sidebar__share-btn" aria-label={copy.blog.copyLink} data-np-copy={url} set:html={SHARE_LINK} />
      {shares.map((s) => (
        <a class="c-np-sidebar__share-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label} set:html={s.icon} />
      ))}
    </span>
  </div>
</div>

<script>
  // Active table of contents item: the last heading above the upper third.
  document.querySelectorAll<HTMLElement>("[data-np-sidebar]").forEach((bar) => {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>("[data-np-toc]")];
    const heads = links
      .map((a) => document.getElementById(a.dataset["npToc"] ?? ""))
      .filter((h): h is HTMLElement => h !== null);
    const update = (): void => {
      const line = window.innerHeight / 3;
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top <= line) current = h;
      links.forEach((a) => a.classList.toggle("is-active", a.dataset["npToc"] === current?.id));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    bar.querySelector<HTMLButtonElement>("[data-np-copy]")?.addEventListener("click", (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      void navigator.clipboard?.writeText(btn.dataset["npCopy"] ?? location.href);
      btn.classList.add("is-done");
      window.setTimeout(() => btn.classList.remove("is-done"), 1500);
    });
  });
</script>

<style>
  .c-np-sidebar {
    position: sticky;
    top: calc(var(--c-nav-height, 0px) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 2.143rem; /* 30px */
    padding: 1.714rem; /* 24px */
    border-radius: 8px;
  }
  .c-np-sidebar__title {
    margin: 0;
    padding-bottom: 1.071rem;
    border-bottom: var(--border-default);
    color: var(--color-black-secondary);
  }
  .c-np-sidebar__list {
    display: flex;
    flex-direction: column;
    gap: 1.071rem;
    margin: 1.071rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Item box: 16px padding, 4px radius; the active one gets the 0.5px
     brand border (Figma). */
  .c-np-sidebar__link {
    display: block;
    padding: 1.143rem 1.143rem 0.929rem;
    border: 0.5px solid transparent;
    border-radius: 4px;
    color: var(--color-black-secondary);
    text-decoration: none;
    transition: border-color var(--duration-hover) var(--ease-smooth);
  }
  .c-np-sidebar__link:hover,
  .c-np-sidebar__link.is-active {
    border-color: var(--color-blue);
  }
  .c-np-sidebar__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-np-sidebar__cta-wrap {
    padding-top: 2.143rem;
    border-top: var(--border-default);
  }
  .c-np-sidebar :global(.c-np-sidebar__cta) {
    width: 100%;
  }
  .c-np-sidebar__share {
    display: flex;
    align-items: center;
    gap: 0.571rem;
  }
  .c-np-sidebar__share-label {
    color: var(--color-black-secondary);
  }
  .c-np-sidebar__share-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .c-np-sidebar__share-buttons {
    display: flex;
    gap: 0.571rem;
  }
  .c-np-sidebar__share-btn {
    display: grid;
    place-items: center;
    width: 2.286rem;
    height: 2.286rem;
    padding: 0.286rem;
    border: 0;
    background: none;
    color: var(--color-black-secondary);
    cursor: pointer;
  }
  .c-np-sidebar__share-btn :global(svg) {
    width: 100%;
    height: 100%;
  }
  .c-np-sidebar__share-btn:hover,
  .c-np-sidebar__share-btn.is-done {
    color: var(--color-accent);
  }
  .c-np-sidebar__share-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (max-width: 991px) {
    .c-np-sidebar {
      position: static;
      padding: 0;
    }
  }
  @media (max-width: 767px) {
    .c-np-sidebar__share-btn {
      width: 4.444rem;
      height: 4.444rem;
    }
  }
</style>
