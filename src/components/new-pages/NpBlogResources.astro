---
/**
 * NpBlogResources — the blog article template's "Resources" section
 * (Figma 3142:1618180): eyebrow, heading, a contact button, then up to
 * three cards (screenshot thumbnail, tag, title, description, Learn more)
 * for the related pack pages built in this mode. The author pages reuse it
 * for the author's guides (own eyebrow and heading, every card, each
 * guide's header illustration as its thumbnail, static: lead 2026-10-09).
 * The /blog and /guides indexes reuse it as the card grid under their hero:
 * every article, the heading visually hidden (`headingHidden`), Work's
 * spacing. Article cards (lead 2026-10-17): category tag (`categories.ts`)
 * and "Published on" tag, then the author row, title, description, link;
 * service cards keep the "Services" tag only.
 * Thumbnails (lead 2026-10-18): each article's card thumbnail (`THUMBS`,
 * Figma 3736:7123), else its header illustration (`HEROES`), else the
 * screenshot collage. Animated on the article pages; `still` (the /blog and
 * /guides indexes, the author pages) stops every thumbnail's motion. Hover = Our Work's grid cards:
 * the card lifts, the thumbnail gets the accent border and a soft shadow;
 * no text changes color.
 * Search + pagination (`searchable`, the /blog index; lead 2026-10-30): a
 * keyword search bar above the grid and 12-card pagination below it
 * (`src/scripts/ui/blog-listing.ts`). Without JS every card shows and both
 * stay hidden.
 */
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import copy from "../../lib/new-pages/copy.json";
import type { Card } from "../../lib/new-pages/loader";
import { ARROW_RIGHT, TOC_ARROW } from "./blog-icons";
import { HEROES } from "../../lib/new-pages/visuals";
import { THUMBS } from "../../lib/new-pages/thumbs";
import { categoryOf } from "../../lib/new-pages/categories";
import { findAuthor } from "../../lib/new-pages/authors";
import { fill, formatShortDate, withPeriod } from "../../lib/new-pages/html";

interface Props {
  cards: readonly Card[];
  shots: readonly { src: string; srcset: string }[];
  eyebrow?: string;
  heading?: string;
  /** Max cards; the article Resources show three. */
  limit?: number;
  /** Static thumbnails, no motion (index and author pages). */
  still?: boolean;
  /** Screen-reader heading only, no section header (the /blog index). */
  headingHidden?: boolean;
  /** Keyword search above the grid, pagination below (the /blog index). */
  searchable?: boolean;
  /** Cards per page when `searchable`. */
  perPage?: number;
}

const {
  cards,
  shots,
  eyebrow = copy.resources.eyebrow,
  heading = copy.resources.heading,
  limit = 3,
  still = false,
  headingHidden = false,
  searchable = false,
  perPage = 12,
} = Astro.props;
const list = cards.slice(0, limit);
const nameOf = (author: string): string => author.split(",")[0]?.trim() ?? author;
---

{list.length > 0 && (
  <section
    class={["c-np-res", headingHidden && "is-heading-hidden", still && "is-still"].filter(Boolean).join(" ")}
    aria-labelledby="np-resources"
    data-blog-listing={searchable ? "" : undefined}
    data-per-page={searchable ? perPage : undefined}
  >
    <Container>
      {headingHidden ? (
        <h2 id="np-resources" class="c-np-res__sr-only">{heading}</h2>
      ) : (
        <header class="c-section-header">
          <Eyebrow>{eyebrow}</Eyebrow>
          <div class="c-section-header__text">
            <h2 id="np-resources" class="c-section-header__title c-text_xl">{heading}</h2>
          </div>
        </header>
      )}
      {searchable && (
        <form class="c-blog-search" role="search" data-blog-search hidden>
          <img class="c-blog-search__icon" src="/images/new-pages/il-icons/seo.webp" width="110" height="110" alt="" />
          <input
            class="c-blog-search__input"
            type="search"
            name="q"
            placeholder="Search by keyword..."
            aria-label="Search articles"
            autocomplete="off"
            data-blog-search-input
          />
        </form>
      )}
      <ul class="c-np-res__grid">
        {list.map((card, i) => {
          const thumb = card.slug ? THUMBS[card.slug] : undefined;
          const Thumb = thumb?.component as ((props: Record<string, unknown>) => unknown) | undefined;
          const hero = !thumb && card.slug && card.family !== "commercial" ? HEROES[card.slug] : undefined;
          const Hero = hero?.component;
          const profile = card.author ? findAuthor(card.author) : undefined;
          return (
          <li
            class="c-np-res__card"
            data-search={searchable ? [card.title, card.description, categoryOf(card.slug, card.family), card.author ? profile?.name ?? nameOf(card.author) : ""].join(" ") : undefined}
          >
            {thumb && Thumb ? (
              <span class="c-np-res__thumb is-thumb" aria-hidden="true">
                <Thumb {...thumb.props} />
              </span>
            ) : Hero ? (
              <span class="c-np-res__thumb is-illustration" aria-hidden="true" data-np-illustration>
                <Hero {...hero.props} />
              </span>
            ) : (
            <span class={["c-np-res__thumb", i === 0 && "is-gradient"].filter(Boolean).join(" ")} aria-hidden="true">
              {[0, 1].map((k) => {
                const s = shots[(i * 2 + k) % Math.max(shots.length, 1)];
                return s ? <img class={`c-np-res__shot is-${k}`} src={s.src} srcset={s.srcset} width="423" height="300" alt="" loading="lazy" decoding="async" /> : null;
              })}
            </span>
            )}
            <span class="c-np-res__texts">
              <span class="c-np-res__tags">
                <Eyebrow variant="accent">{categoryOf(card.slug, card.family)}</Eyebrow>
                {card.publishedAt && (
                  <Eyebrow>
                    {fill(copy.card.published, { date: formatShortDate(card.publishedAt) })}
                  </Eyebrow>
                )}
              </span>
              {card.author && (
                <span class="c-np-res__author">
                  {profile && (
                    <img class="c-np-res__author-photo" src={profile.photo.src} width={profile.photo.w} height={profile.photo.h} alt="" loading="lazy" decoding="async" />
                  )}
                  <span class="c-paragraph">{profile?.name ?? nameOf(card.author)}</span>
                </span>
              )}
              <span class="c-np-res__title c-text_m">{withPeriod(card.title)}</span>
              <span class="c-np-res__desc c-paragraph">{card.description}</span>
              <a class="c-np-res__more c-paragraph" href={card.href} {...card.data}>
                {copy.resources.learnMore}
                <span class="c-np-res__arrow" set:html={ARROW_RIGHT} />
              </a>
            </span>
          </li>
          );
        })}
      </ul>
      {searchable && (
        <>
          {/* TODO: COPY — empty state when no article matches the search. */}
          <p class="c-blog-empty c-paragraph" data-blog-empty hidden>No articles match your search.</p>
          <p class="c-np-res__sr-only" aria-live="polite" data-blog-status></p>
          <nav class="c-blog-pager" aria-label="Pagination" data-blog-pager hidden>
            <button class="c-blog-pager__arrow is-prev" type="button" aria-label="Previous page" data-blog-prev set:html={TOC_ARROW} />
            <span class="c-blog-pager__pages" data-blog-pages></span>
            <button class="c-blog-pager__arrow" type="button" aria-label="Next page" data-blog-next set:html={TOC_ARROW} />
          </nav>
        </>
      )}
    </Container>
  </section>
)}

<script>
  import { initBlogListing } from "../../scripts/ui/blog-listing";

  document.querySelectorAll<HTMLElement>("[data-blog-listing]").forEach((root) => initBlogListing(root));
</script>

<style>
  /* Accent tag tint at 5% (the live 8% measures 4.48:1 with accent text). */
  .c-np-res__texts :global(.c-eyebrow.is-accent) {
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-white));
  }
  .c-np-res :global(.c-container) {
    padding-top: 7.857rem;
    padding-bottom: 7.857rem;
  }
  .c-np-res :global(.c-section-header) {
    gap: 1.714rem;
  }
  /* /blog index: hero → grid spacing as Work's hero → listing. */
  .c-np-res.is-heading-hidden :global(.c-container) {
    padding-top: 7.5rem;
  }
  .c-np-res.is-heading-hidden .c-np-res__grid {
    margin-top: 0;
  }
  .c-np-res__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  /* Three columns; fewer cards stay centered. */
  .c-np-res__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4.286rem 2.857rem; /* 60px rows (author pages), 40px columns */
    margin: 2.857rem 0 0;
    padding: 0;
    list-style: none;
  }
  .c-np-res__card[hidden] {
    display: none;
  }
  .c-np-res__card {
    flex: 0 1 calc((100% - 5.714rem) / 3);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.786rem;
    transition: transform var(--duration-hover) var(--ease-smooth);
  }
  /* Hover (lead 2026-10-18): Our Work's grid cards (ClientCard `.is-grid`):
     the card lifts 3%, the thumbnail's border turns accent with the
     c-button hover shadow. No text changes color. Keyboard focus too. */
  .c-np-res__card:hover,
  .c-np-res__card:has(.c-np-res__more:focus-visible) {
    transform: translateY(-3%);
  }
  .c-np-res__card:hover .c-np-res__thumb,
  .c-np-res__card:has(.c-np-res__more:focus-visible) .c-np-res__thumb {
    border-color: var(--color-accent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-black-secondary) 20%, transparent);
  }
  .c-np-res__thumb {
    position: relative;
    display: block;
    aspect-ratio: 544 / 362;
    overflow: hidden;
    border: var(--border-default);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-white));
    transition:
      border-color var(--duration-hover) var(--ease-smooth),
      box-shadow var(--duration-hover) var(--ease-smooth);
  }
  .c-np-res__thumb.is-thumb {
    background: var(--color-white);
  }
  /* Header illustration as the thumbnail: centered on white, its own
     frame border dropped (the thumb has one). */
  .c-np-res__thumb.is-illustration {
    display: flex;
    align-items: center;
    background: var(--color-white);
  }
  .c-np-res__thumb.is-illustration :global(.np-il) {
    border: 0;
    border-radius: 0;
  }
  /* Index and author pages: still pictures (lead 2026-10-18). */
  .c-np-res.is-still .c-np-res__thumb :global(*) {
    animation: none !important;
  }
  /* Centered header (SectionHeader's rules, also in new-pages.css): here
     too, so pages without new-pages.css (author pages) match. */
  .c-np-res :global(.c-section-header),
  .c-np-res :global(.c-section-header__text) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .c-np-res :global(.c-section-header__title) {
    margin: 0 auto;
    text-align: center;
    /* Even lines, no lone last word (lead 2026-10-26). */
    text-wrap: balance;
  }
  .c-np-res__thumb.is-gradient {
    background: linear-gradient(113deg, var(--color-blue) 2.88%, var(--color-blue-light) 96.84%);
  }
  .c-np-res__shot {
    position: absolute;
    left: 11.1%;
    width: 77.8%;
    max-width: none;
    object-fit: cover;
    border-radius: 2px;
  }
  .c-np-res__shot.is-0 {
    top: -69.9%;
    height: 107.8%;
    object-position: bottom;
  }
  .c-np-res__shot.is-1 {
    top: 43.5%;
    height: 61.2%;
    object-position: top;
  }
  .c-np-res__texts {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.143rem;
    padding: 0; /* lead 2026-10-17 */
  }
  .c-np-res__title {
    color: var(--color-black-secondary);
  }
  /* Category + published tags on one row; they wrap on narrow cards. */
  .c-np-res__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.571rem 0.857rem;
  }
  /* Author row: photo + name in a bordered box across the card. */
  .c-np-res__author {
    display: flex;
    align-items: center;
    gap: 0.857rem;
    align-self: stretch;
    padding: 0.571rem 0.857rem;
    border: var(--border-default);
    border-radius: 8px;
    color: var(--color-black-secondary);
  }
  .c-np-res__author-photo {
    width: 2.286rem;
    height: 2.286rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .c-np-res__desc {
    color: var(--color-text);
  }
  .c-np-res__more {
    display: inline-flex;
    align-items: center;
    gap: 0.571rem;
    padding: 0.571rem 0;
    color: var(--color-black-secondary);
    text-decoration: none;
  }
  /* The whole card is the link's hit area. */
  .c-np-res__more::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .c-np-res__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-np-res__arrow {
    display: inline-flex;
    width: 1.714rem;
    height: 1.714rem;
    align-items: center;
    justify-content: center;
  }
  .c-np-res__arrow :global(svg) {
    width: 0.82rem;
    height: 1.24rem;
  }
  /* Search bar (lead 2026-10-30 screenshot): full width, 1px border, 8px
     radius, the il-icons magnifier, uppercase tracked placeholder (the
     eyebrow's tracking), brand squares on two corners (the eyebrow's). */
  .c-blog-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.857rem;
    margin: 0 0 3.214rem; /* ~45px to the grid. TODO: DS */
    padding: 0 1.143rem;
    min-height: 3.143rem;
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-white);
    scroll-margin-top: 8rem; /* clears the sticky nav on page change */
    transition: border-color var(--duration-hover) var(--ease-smooth);
  }
  .c-blog-search[hidden] {
    display: none;
  }
  .c-blog-search:focus-within {
    border-color: var(--color-accent);
  }
  .c-blog-search::before,
  .c-blog-search::after {
    content: "";
    position: absolute;
    width: 0.625rem;
    height: 0.625rem;
    background: var(--color-white);
    border: 0.5px solid var(--color-gray);
    border-radius: 1.5px;
  }
  .c-blog-search::before {
    top: -0.3125rem;
    left: -0.3125rem;
  }
  .c-blog-search::after {
    right: -0.3125rem;
    bottom: -0.3125rem;
  }
  .c-blog-search__icon {
    flex: 0 0 auto;
    width: 1.857rem;
    height: 1.857rem;
  }
  .c-blog-search__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.857rem 0;
    border: 0;
    background: transparent;
    color: var(--color-heading);
    font-family: var(--font-body);
    font-size: var(--fs-p);
    letter-spacing: 0.064em;
    outline: none;
    appearance: none;
  }
  .c-blog-search__input::placeholder {
    color: var(--color-text);
    opacity: 1;
    text-transform: uppercase;
  }
  .c-blog-search__input::-webkit-search-cancel-button {
    cursor: pointer;
  }
  .c-blog-empty {
    margin: 0;
    color: var(--color-text);
    text-align: center;
  }
  .c-blog-empty[hidden] {
    display: none;
  }
  /* Pagination (lead 2026-10-30 screenshot): thin arrows, 44px bordered
     squares, the current page on gray, "…" on the baseline. Page buttons are
     built by the script, so their rules are `:global`. */
  .c-blog-pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 5rem;
  }
  .c-blog-pager[hidden] {
    display: none;
  }
  .c-blog-pager__pages {
    display: flex;
    align-items: center;
    gap: 0.714rem;
  }
  .c-blog-pager :global(.c-blog-pager__page),
  .c-blog-pager__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    cursor: pointer;
  }
  .c-blog-pager :global(.c-blog-pager__page) {
    width: 3.143rem;
    height: 3.143rem;
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-white);
    transition:
      border-color var(--duration-hover) var(--ease-smooth),
      background-color var(--duration-hover) var(--ease-smooth);
  }
  .c-blog-pager :global(.c-blog-pager__page:hover) {
    border-color: var(--color-gray);
  }
  .c-blog-pager :global(.c-blog-pager__page.is-active) {
    background: var(--color-gray-light);
    cursor: default;
  }
  .c-blog-pager :global(.c-blog-pager__gap) {
    align-self: flex-end;
    color: var(--color-text);
    line-height: 1;
  }
  .c-blog-pager__arrow {
    width: 2.286rem;
    height: 2.286rem;
    transition: transform var(--duration-hover) var(--ease-smooth);
  }
  .c-blog-pager__arrow.is-prev {
    transform: scaleX(-1);
  }
  .c-blog-pager__arrow:not(:disabled):hover {
    transform: translateX(0.214rem);
  }
  .c-blog-pager__arrow.is-prev:not(:disabled):hover {
    transform: scaleX(-1) translateX(0.214rem);
  }
  .c-blog-pager__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .c-blog-pager__arrow :global(svg) {
    width: 1.714rem;
    height: 1.714rem;
  }
  .c-blog-pager :global(.c-blog-pager__page:focus-visible),
  .c-blog-pager__arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (max-width: 991px) {
    .c-np-res__card {
      flex-basis: 100%;
    }
  }
  @media (max-width: 767px) {
    .c-np-res :global(.c-container),
    .c-np-res.is-heading-hidden :global(.c-container) {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .c-blog-search {
      min-height: 4.889rem;
    }
    .c-blog-search__icon {
      width: 2.667rem;
      height: 2.667rem;
    }
    .c-blog-pager :global(.c-blog-pager__page) {
      width: 4.889rem;
      height: 4.889rem;
    }
    .c-blog-pager {
      gap: 1rem;
    }
  }
</style>
