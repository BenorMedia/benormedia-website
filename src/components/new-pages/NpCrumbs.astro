---
/**
 * NpCrumbs — the visible breadcrumb trail of the blog templates (articles
 * and author pages): chevron-separated, the last item is the current page.
 */
import copy from "../../lib/new-pages/copy.json";
import type { VisibleCrumb } from "../../lib/new-pages/links";
import { CHEVRON } from "./blog-icons";

interface Props {
  items: readonly VisibleCrumb[];
}

const { items } = Astro.props;
---

<nav class="c-np-crumbs" aria-label={copy.accessibleNames.breadcrumb}>
  <ol class="c-np-crumbs__list">
    {items.map((c, i) => (
      <li class="c-np-crumbs__item c-paragraph_s">
        {i > 0 && <span class="c-np-crumbs__chevron" set:html={CHEVRON} />}
        {i === items.length - 1 ? (
          <span aria-current="page" {...c.attrs}>{c.label}</span>
        ) : c.href ? (
          <a href={c.href} {...c.attrs}>{c.label}</a>
        ) : (
          <span {...c.attrs}>{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .c-np-crumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.571rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .c-np-crumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.571rem;
    color: var(--color-text-secondary);
  }
  .c-np-crumbs__item a {
    color: inherit;
    text-decoration: none;
  }
  .c-np-crumbs__item a:hover {
    color: var(--color-accent);
  }
  .c-np-crumbs__item a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-np-crumbs__chevron {
    display: inline-flex;
    width: 1.143rem;
    height: 1.143rem;
    color: var(--color-text-secondary);
  }
  .c-np-crumbs__chevron :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
