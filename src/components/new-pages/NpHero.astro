---
/**
 * NpHero — commercial page hero (brief 6.1 row 1, rung 3 sibling of
 * `PageHero` / `ServiceHero`): eyebrow, H1, lead paragraphs, two buttons.
 * Reuses the global `SectionHeader` classes and the live `Eyebrow`, so it
 * matches the service hero without its Services breadcrumb, its "Get In
 * Touch" label or its Trusted badge. No script measures or animates it.
 */
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import NpActions from "./NpActions.astro";

interface Props {
  eyebrowHtml: string;
  h1: string;
  lead: readonly string[];
  second: { label: string; href: string };
}

const { eyebrowHtml, h1, lead, second } = Astro.props;
---

<section class="c-np-hero">
  <Container>
    <header class="c-section-header c-np-hero__header">
      {eyebrowHtml && <Eyebrow><span data-np-src="eyebrow" set:html={eyebrowHtml} /></Eyebrow>}
      <div class="c-section-header__text">
        <h1 class="c-section-header__title c-text_xxl cc-mobile-lands_text-l" data-np-src="h1">{h1}</h1>
        <div class="c-np-hero__lead" set:html={lead.join("")} />
      </div>
    </header>
    <div class="c-np-hero__actions">
      <NpActions second={second} />
    </div>
  </Container>
</section>

<style>
  /* PageHero spacing: nav → eyebrow 7.5rem (5rem on phones), no bottom
     padding (the proof strip below owns it). */
  .c-np-hero :global(.c-container) {
    padding-top: 7.5rem;
    padding-bottom: 0;
  }
  .c-np-hero__header .c-section-header__title {
    max-width: 75rem;
  }
  .c-np-hero__lead {
    display: flex;
    flex-direction: column;
    gap: 0.714rem;
  }
  /* Lead = the live `.c-section-header__description` style. */
  .c-np-hero__lead :global(p) {
    max-width: 42rem;
    margin: 0 auto;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--fs-p-m);
    line-height: 1.6;
    text-align: center;
  }
  /* Subtitle → buttons ≈ 40px (ServiceHero). */
  .c-np-hero__actions {
    display: flex;
    justify-content: center;
    margin-top: 2.857rem;
  }
  @media (max-width: 767px) {
    .c-np-hero :global(.c-container) {
      padding-top: 5rem;
    }
    .c-np-hero__actions {
      margin-top: 3.333rem;
    }
  }
</style>
