---
/**
 * NpBlogAuthor — the blog article template's author card, in the header
 * right below the image (Figma 3718:7504, lead 2026-10-12): one row with
 * the author's photo (`authors.ts`, else the BenorMedia mark), name and
 * position on the left, and the published date led by an icon tile on the
 * right; side squares as on the eyebrows. Name and position come from the
 * front matter `author` ("Name, Role"). A registered
 * author's name links to their page (lead 2026-10-08); the whole card is
 * the hit area.
 */
import copy from "../../lib/new-pages/copy.json";
import { formatDate } from "../../lib/new-pages/html";
import { authorPath, findAuthor } from "../../lib/new-pages/authors";
import type { NpPage } from "../../lib/new-pages/loader";
import { ICON } from "./illustrations/assets";

interface Props {
  page: NpPage;
}

const { page } = Astro.props;
const [pubBefore = "", pubAfter = ""] = copy.byline.published.split("{date}");
const profile = page.author.hasGap ? undefined : findAuthor(page.author.text);
const photo = profile?.photo;
// "Name, Role" (front matter `author`): the role goes on its own line.
const comma = page.author.hasGap ? -1 : page.author.text.indexOf(",");
const name = comma >= 0 ? page.author.text.slice(0, comma).trim() : "";
const role = comma >= 0 ? page.author.text.slice(comma + 1).trim() : "";
const icon = ICON.docPencil;
---

<aside class="c-np-author" data-np-byline>
  <div class="c-np-author__head">
    {photo ? (
      <img class="c-np-author__photo" src={photo.src} width={photo.w} height={photo.h} alt="" loading="lazy" decoding="async" />
    ) : (
      <span class="c-np-author__avatar" aria-hidden="true"></span>
    )}
    <span class="c-np-author__who">
      {name ? (
        <>
          {profile ? (
            <a class="c-np-author__name c-np-author__link c-paragraph_m" href={authorPath(profile)} rel="author" data-np-src="byline.author">{name}</a>
          ) : (
            <span class="c-np-author__name c-paragraph_m" data-np-src="byline.author">{name}</span>
          )}
          <span class="c-np-author__role c-paragraph" data-np-src="byline.role">{role}</span>
        </>
      ) : (
        <span class="c-np-author__name c-paragraph_m" data-np-src="byline.author" set:html={page.author.html} />
      )}
    </span>
  </div>
  <p class="c-np-author__date c-paragraph" data-np-src="byline.published">
    <span class="c-np-author__tile" aria-hidden="true"><img src={icon.src} width={icon.w} height={icon.h} alt="" loading="lazy" decoding="async" /></span>
    <span>{pubBefore}<time datetime={page.publishedAt}>{formatDate(page.publishedAt)}</time>{pubAfter}</span>
  </p>
  <span class="c-np-author__sq is-left" aria-hidden="true"></span>
  <span class="c-np-author__sq is-right" aria-hidden="true"></span>
</aside>

<style>
  .c-np-author {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.429rem;
    padding: 2rem 2.286rem; /* 28px 32px */
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-white);
  }
  .c-np-author__head {
    display: flex;
    align-items: center;
    gap: 1.429rem; /* 20px */
    min-width: 0;
  }
  .c-np-author__photo {
    flex: 0 0 auto;
    width: 3.857rem; /* 54px */
    height: 3.857rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-gray-light);
  }
  .c-np-author__avatar {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 3.857rem; /* 54px */
    height: 3.857rem;
    border-radius: 50%;
    background: var(--gradient-primary);
  }
  .c-np-author__avatar::after {
    content: "";
    width: 55%;
    height: 55%;
    background: var(--color-white);
    -webkit-mask: url("/images/home/services-diagram/center-bottom-icon.webp") center / contain no-repeat;
            mask: url("/images/home/services-diagram/center-bottom-icon.webp") center / contain no-repeat;
  }
  .c-np-author__who {
    display: flex;
    flex-direction: column;
    gap: 0; /* lead 2026-10-19 */
  }
  .c-np-author__name {
    color: var(--color-black-secondary);
  }
  .c-np-author__link {
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-smooth);
  }
  .c-np-author__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }
  .c-np-author:hover .c-np-author__link {
    color: var(--color-accent);
  }
  .c-np-author__link:focus-visible {
    outline: none;
  }
  .c-np-author__link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-np-author__role {
    margin: 0;
    color: var(--color-text);
  }
  .c-np-author__date {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 1.071rem; /* 15px */
    margin: 0;
    color: var(--color-text);
    white-space: nowrap;
  }
  /* Icon tile (the illustration chip tile, Figma #F3F3F3). */
  .c-np-author__tile {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 3rem; /* 42px */
    height: 3rem;
    border-radius: 4px;
    background: var(--color-gray-light);
  }
  .c-np-author__tile img {
    width: auto;
    height: 1.857rem; /* 26px */
  }
  /* Side squares (Figma: 15px, the eyebrow square style). */
  .c-np-author__sq {
    position: absolute;
    top: 50%;
    width: 1.071rem;
    height: 1.071rem;
    transform: translateY(-50%);
    border: 0.5px solid var(--color-gray);
    border-radius: 1.5px;
    background: var(--color-white);
  }
  .c-np-author__sq.is-left { left: -0.6rem; }
  .c-np-author__sq.is-right { right: -0.6rem; }
  @media (max-width: 767px) {
    .c-np-author {
      flex-wrap: wrap;
      justify-content: flex-start;
      padding: 1.786rem 1.429rem;
    }
  }
</style>
