---
/**
 * TimelineDiagram — a line with milestones (brief 7.3), as separate steps.
 * Horizontal on wide figures, vertical under 440px. No dates or durations.
 */
interface Props {
  milestones: readonly string[];
}

const { milestones } = Astro.props;
---

<div class="c-np-timeline">
  <ol class="c-np-timeline__list" style={`--np-tl-cols: ${milestones.length};`}>
    {milestones.map((m, i) => (
      <li class={["c-np-timeline__item", i === milestones.length - 1 && "is-last"].filter(Boolean).join(" ")}>
        <span class="c-np-timeline__dot" />
        <span class="c-np-timeline__label">{m}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .c-np-timeline {
    container-type: inline-size;
    font-family: var(--font-body);
    font-size: var(--fs-p);
    line-height: 1.35;
    color: var(--color-heading);
  }
  .c-np-timeline__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--np-tl-cols), minmax(0, 1fr));
    gap: 1.143rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .c-np-timeline__list::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    right: 0.5rem;
    height: 1px;
    background: var(--color-gray);
  }
  .c-np-timeline__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.143rem;
  }
  .c-np-timeline__dot {
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-white);
  }
  .c-np-timeline__item.is-last .c-np-timeline__dot {
    background: var(--color-accent);
  }
  @container (max-width: 440px) {
    .c-np-timeline__list {
      grid-template-columns: 1fr;
      gap: 1.714rem;
    }
    .c-np-timeline__list::before {
      top: 0.5rem;
      bottom: 0.5rem;
      left: 0.5rem;
      right: auto;
      width: 1px;
      height: auto;
    }
    .c-np-timeline__item {
      flex-direction: row;
      align-items: center;
    }
  }
  @media (max-width: 767px) {
    .c-np-timeline { font-size: 1.556rem; }
    .c-np-timeline__dot { width: 1.556rem; height: 1.556rem; }
    .c-np-timeline__list::before { top: 0.778rem; left: 0.778rem; }
  }
  @media (max-width: 767px) {
    @container (max-width: 440px) {
      .c-np-timeline__list::before { bottom: 0.778rem; }
    }
  }
</style>
