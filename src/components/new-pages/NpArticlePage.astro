---
/**
 * NpArticlePage — the article template (guides, comparisons, data studies
 * at /guides/<slug>), following the blog article template in Figma
 * (BenorMedia 3142:1617991, lead 2026-10-07):
 *   header (breadcrumbs, tag, updated date, read time, H1, lead, screenshot
 *   collage, the author card below it) → two columns (sticky table of
 *   contents with Get in Touch and Share; the article: key takeaways, body
 *   with tables and figures, the FAQ (lead 2026-10-26: in the body, H2 and
 *   text at the body sizes), sources) → the global CTA banner (lead
 *   2026-10-07) → Related resources. The author card
 *   moved from a third column into the header and the article took its
 *   width (Figma 3718:7504, lead 2026-10-12).
 * Draft banner and gaps panel in previews.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../layout/JsonLd.astro";
import Container from "../ui/Container.astro";
import NpDraftBanner from "./NpDraftBanner.astro";
import NpBlogHero from "./NpBlogHero.astro";
import NpBlogSidebar from "./NpBlogSidebar.astro";
import NpBlogResources from "./NpBlogResources.astro";
import NpKeyTakeaways from "./NpKeyTakeaways.astro";
import NpVisual from "./NpVisual.astro";
import FaqAccordion from "../ui/FaqAccordion.astro";
import NpSources from "./NpSources.astro";
import NpGapsPanel from "./NpGapsPanel.astro";
import CtaBanner from "../layout/CtaBanner.astro";
import { getSiteSettingsCached } from "../../lib/sanity/site";
import { pageJsonLd } from "../../lib/new-pages/jsonld";
import type { NpPage } from "../../lib/new-pages/loader";
import { resolveVisual } from "../../lib/new-pages/visuals";
import { clientShots } from "../../lib/new-pages/shots";
import { SITE } from "../../lib/content/entity";
import { CHECK_MASK } from "./blog-icons";
import "./new-pages.css";

interface Props {
  page: NpPage;
}

const { page } = Astro.props;
const siteSettings = await getSiteSettingsCached();
const toc = [
  ...page.sections.map((s) => ({ id: s.id, html: s.titleHtml })),
  ...(page.faq.length > 0 ? [{ id: page.faqId, html: page.faqHeadingHtml }] : []),
];

const faqItems = page.faq.map((item) => ({
  question: item.q,
  answer: item.a,
  questionHtml: item.qHtml,
  answerHtml: item.aHtml,
}));

// Client site screenshots (Our Work) for the header collage and the cards.
const shots = await clientShots();
---

<BaseLayout title={page.title} description={page.description} noIndex={page.draft} showCtaBanner={false} titleTemplate={false}>
  {pageJsonLd(page).map((data) => <JsonLd data={data} />)}
  {page.includeDrafts && page.draft && <NpDraftBanner view={page.view} gaps={page.gaps.length} />}
  <article class="c-np-article">
    <NpBlogHero page={page} shots={shots} />
    <Container class="c-np-article__body">
      <div class="c-np-article__grid">
        <div class="c-np-article__toc">
          <NpBlogSidebar items={toc} url={`${SITE}${page.url}`} />
        </div>
        <div class="c-np-article__main">
          <NpKeyTakeaways items={page.takeaways} />
          <div class="c-np-prose is-blog" style={`--np-check: ${CHECK_MASK};`}>
            <Fragment set:html={page.intro.join("")} />
            {page.sections.map((section) => {
              const visual = resolveVisual(section.visual, page.includeDrafts) ? section.visual : undefined;
              // `place: top` puts the visual under the section's first paragraph (lead 2026-10-25).
              const cut = visual?.place === "top" ? section.html.indexOf("</p>") + 4 : -1;
              const [before, after] = cut > 3 ? [section.html.slice(0, cut), section.html.slice(cut)] : [section.html, ""];
              const figure = visual && (
                <figure class="c-np-article__figure">
                  <NpVisual visual={visual} includeDrafts={page.includeDrafts} layout="full" />
                </figure>
              );
              return (
                <>
                  <h2 id={section.id} data-np-src="h2" set:html={section.titleHtml} />
                  <Fragment set:html={before} />
                  {cut > 3 && figure}
                  <Fragment set:html={after} />
                  {cut <= 3 && figure}
                </>
              );
            })}
            {/* The FAQ sits in the body, after the last section (lead 2026-10-26). */}
            {faqItems.length > 0 && (
              <>
                <h2 id={page.faqId} data-np-src="faqHeading" set:html={page.faqHeadingHtml} />
                <FaqAccordion items={faqItems} name={`${page.faqId}-items`} npSrc class="c-np-article__faq" />
              </>
            )}
          </div>
          <NpSources items={page.sources} />
        </div>
      </div>
    </Container>
  </article>
  {/* The global CTA banner, right below the article (lead 2026-10-07). */}
  <div data-np-live="cta-banner" class="c-np-live-banner">
    <CtaBanner siteSettings={siteSettings} />
  </div>
  <NpBlogResources cards={page.relatedCards} shots={[...shots.slice(1), ...shots.slice(0, 1)]} />
  {page.includeDrafts && page.view === "review" && <NpGapsPanel gaps={page.gaps} />}
</BaseLayout>

<style>
  .c-np-live-banner {
    display: contents;
  }
  /* Figma: 369 | 1201 columns (the former 800 | 110 gap | 291 author
     column), 110px gap, in the 1680 container. */
  .c-np-article :global(.c-np-article__body) {
    padding-top: 7.143rem;
  }
  .c-np-article__grid {
    display: grid;
    grid-template-columns: minmax(0, 369fr) minmax(0, 1201fr);
    align-items: start;
    column-gap: 6.55%;
  }
  /* Stretches the column so the sidebar inside can stick; min-width 0 so
     the one-line TOC items cut instead of widening the grid. */
  .c-np-article__toc {
    align-self: stretch;
    min-width: 0;
  }
  .c-np-article__main {
    display: flex;
    flex-direction: column;
    gap: 3.571rem;
    min-width: 0;
  }
  .c-np-article__figure {
    margin: 2.143rem 0 0;
  }
  /* FAQ in the body (lead 2026-10-26): the column's full width, questions
     and answers at the body text size (`c-paragraph_ms`). */
  .c-np-article__main :global(.c-np-article__faq) {
    max-width: none;
  }
  .c-np-article__main :global(.c-np-article__faq .c-paragraph_m) {
    font-size: calc(var(--fs-p-m) * 0.85);
  }
  @media (max-width: 1199px) {
    .c-np-article__grid {
      grid-template-columns: minmax(0, 300fr) minmax(0, 800fr);
      row-gap: 3.571rem;
    }
  }
  @media (max-width: 991px) {
    .c-np-article__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .c-np-article :global(.c-np-article__body) {
      padding-top: 4.444rem;
    }
  }
</style>
