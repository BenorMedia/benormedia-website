---
/**
 * IlSiteMap — the home page card on top and the page types under it, in
 * two rows of three, wired from a bus.
 */
import IlFrame from "./IlFrame.astro";
import IlNode from "./IlNode.astro";
import type { IconName } from "./assets";

interface Props {
  root: string;
  pages: readonly { icon: IconName; label: string }[];
}

const { root, pages } = Astro.props;
const H = 440;
const xs = [96, 280, 464];
const r1 = 214;
const r2 = 346;
const bus = 168;
---

<IlFrame h={H} glow={{ x: 280, y: 250, w: 660, h: 420 }}>
  <svg class="np-il__lines" viewBox={`0 0 560 ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <path d={`M280 132 V${bus}`} />
    <path class="np-il-flow" d={`M280 132 V${bus}`} />
    <path d={`M${xs[0]} ${r1 - 21} V${bus + 14} Q${xs[0]} ${bus} ${xs[0]! + 14} ${bus} H${xs[2]! - 14} Q${xs[2]} ${bus} ${xs[2]} ${bus + 14} V${r1 - 21}`} />
    <path class="np-il-flow" d={`M${xs[0]} ${r1 - 21} V${bus + 14} Q${xs[0]} ${bus} ${xs[0]! + 14} ${bus} H${xs[2]! - 14} Q${xs[2]} ${bus} ${xs[2]} ${bus + 14} V${r1 - 21}`} />
    <path d={`M280 ${bus} V${r1 - 21}`} />
    <path class="np-il-flow" d={`M280 ${bus} V${r1 - 21}`} />
    {xs.map((x) => <path class="is-dashed" d={`M${x} ${r1 + 52} V${r2 - 21}`} />)}
    <rect x="277" y={bus - 3} width="6" height="6" rx="1" />
    {xs.map((x) => <rect x={x - 3} y={r2 - 36} width="6" height="6" rx="1" />)}
  </svg>
  <div class="np-il-card" style="--x: 190; --y: 22; --w: 180; height: 11em; align-items: stretch; gap: 0.8em;">
    <span class="np-il-tag is-accent">{root}</span>
    <span class="np-il-bar is-strong" style="width: 75%; margin-top: 0.3em;"></span>
    <span class="np-il-bar" style="width: 92%;"></span>
    <span class="np-il-bar is-accent" style="width: 34%; height: 1.4em; border-radius: 0.3em;"></span>
  </div>
  {pages.map((p, i) => (
    <IlNode x={xs[i % 3]!} y={i < 3 ? r1 : r2} icon={p.icon} label={p.label} w={140} />
  ))}
</IlFrame>
