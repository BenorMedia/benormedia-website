---
/**
 * IlJourney — handoff steps along a curved path, then the ongoing support
 * card with its chips underneath.
 */
import IlFrame from "./IlFrame.astro";
import IlNode from "./IlNode.astro";
import IlChip from "./IlChip.astro";
import type { IconName } from "./assets";

interface Props {
  tag: string;
  steps: readonly { icon: IconName; label: string }[];
  cardTag: string;
  chips: readonly { icon: IconName; label: string }[];
}

const { tag, steps, cardTag, chips } = Astro.props;
const H = 470;
const pts = [
  { x: 76, y: 150 },
  { x: 208, y: 112 },
  { x: 352, y: 150 },
  { x: 484, y: 112 },
];
---

<IlFrame h={H} glow={{ x: 280, y: 170, w: 660, h: 360 }}>
  <svg class="np-il__lines" viewBox={`0 0 560 ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <path class="is-dashed" d="M14 162 C40 158, 52 150, 76 150 C130 150, 150 112, 208 112 C266 112, 296 150, 352 150 C408 150, 430 112, 484 112 C512 112, 530 104, 548 98" />
    <path d={`M280 214 V262`} />
    <path class="np-il-flow" d={`M280 214 V262`} />
    <rect x="277" y="232" width="6" height="6" rx="1" />
    <rect x="11" y="159" width="6" height="6" rx="1" />
  </svg>
  <span class="np-il-at np-il-tag is-accent" style="--x: 280; --y: 38;">{tag}</span>
  {steps.map((s, i) => <IlNode x={pts[i]!.x} y={pts[i]!.y} icon={s.icon} label={s.label} w={112} />)}
  <div class="np-il-card" style={`--x: 24; --y: 262; --w: 512; gap: 1.3em; padding: 1.6em 1.2em;`}>
    <span class="np-il-tag">{cardTag}</span>
    <span class="np-il-row is-wrap" style="gap: 0.8em;">
      {chips.map((c) => <IlChip icon={c.icon} label={c.label} />)}
    </span>
  </div>
</IlFrame>
