---
/**
 * IlRedirectMap — "map every URL": two cards of example URLs (old
 * WordPress, new Webflow) joined row by row through a 301 badge, converging
 * into the BenorMedia mark, with the planning steps as chips below. URLs
 * are generic examples.
 */
import IlFrame from "./IlFrame.astro";
import IlChip from "./IlChip.astro";
import type { IconName } from "./assets";

interface Props {
  fromTag: string;
  toTag: string;
  rows: readonly { from: string; to: string; badge: string }[];
  chips: readonly { icon: IconName; label: string }[];
}

const { fromTag, toTag, rows, chips } = Astro.props;
const H = 486;
const top = 24;
const rowY = (i: number) => top + 12 + 30 + 11 + 17 + i * 45;
const cardBottom = rowY(rows.length - 1) + 17 + 12;
const markY = cardBottom + 70;
---

<IlFrame h={H} glow={{ x: 280, y: 200, w: 640, h: 420 }}>
  <svg class="np-il__lines" viewBox={`0 0 560 ${H}`} preserveAspectRatio="none" aria-hidden="true">
    {rows.map((_, i) => (
      <path class="is-accent" d={`M236 ${rowY(i)} H324`} />
    ))}
    <path d={`M130 ${cardBottom} V${cardBottom + 10} Q130 ${cardBottom + 24} 146 ${cardBottom + 24} H264 Q280 ${cardBottom + 24} 280 ${cardBottom + 40} V${markY - 42}`} />
    <path d={`M430 ${cardBottom} V${cardBottom + 10} Q430 ${cardBottom + 24} 414 ${cardBottom + 24} H296 Q280 ${cardBottom + 24} 280 ${cardBottom + 40}`} />
    <path d={`M280 ${markY + 42} V${H - 92}`} />
    <rect x="200" y={cardBottom + 21} width="6" height="6" rx="1" />
    <rect x="354" y={cardBottom + 21} width="6" height="6" rx="1" />
  </svg>
  <div class="np-il-card" style={`--x: 24; --y: ${top}; --w: 212; align-items: stretch;`}>
    <span class="np-il-tag is-fixed">{fromTag}</span>
    {rows.map((r) => <span class="np-il-pill"><span>{r.from}</span></span>)}
  </div>
  <div class="np-il-card" style={`--x: 324; --y: ${top}; --w: 212; align-items: stretch;`}>
    <span class="np-il-tag is-accent is-fixed">{toTag}</span>
    {rows.map((r) => <span class="np-il-pill is-tint"><span>{r.to}</span></span>)}
  </div>
  {rows.map((r, i) => (
    <span class="np-il-at np-il-badge" style={`--x: 280; --y: ${rowY(i)};`}>{r.badge}</span>
  ))}
  <span class="np-il-mark" style={`--x: 280; --y: ${markY}; --d: 84;`}></span>
  <div class="np-il-chips" style={`--x: 12; --r: 12; --y: ${H - 84};`}>
    {chips.map((c) => <IlChip icon={c.icon} label={c.label} />)}
  </div>
</IlFrame>
