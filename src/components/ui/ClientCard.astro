---
/**
 * ClientCard — client showcase card.
 *
 * Variants:
 *   - `featured` — Home Featured Work (screenshot + testimonial block).
 *   - `grid`     — Home Our Work cards (card thumbnail + logo/tags footer).
 * A `'list'` variant can be added later without changing the caller API.
 *
 * Grid layout:
 *   [ card thumbnail ]
 *   [ logo ........ funds raised tag · category tag ]
 * Funds tag renders only when `fundsRaised` is set; category tag only when
 * a category is referenced. Missing thumbnail → empty gray tile.
 *
 * Featured layout (≥992):
 *   [ screenshot / video ][ testimonial block ]
 *
 * Media: `websiteVideo` (MP4) when set — plays (muted, looping, inline) when
 * the card enters the viewport and pauses when it leaves, on every device
 * (lead 2026-09-30, QA S3/S4). `preload="none"`: nothing downloads until the
 * card is on screen. The video's native `poster` (`websiteVideoPoster`, else
 * the screenshot, cropped to 16:9) shows until the first frame, and stays
 * under reduced motion or Data Saver (no autoplay there). The media box takes
 * the video's own ratio (16:9 by default, updated from the file's metadata),
 * so the video is never cropped. Without a video the screenshot image
 * renders as before.
 * The body keeps its hover state (lift, accent border, arrow); it no longer
 * drives the video.
 *
 * Links (lead 2026-09-30, same pattern as ClientList rows): with
 * `websiteUrl` set, the featured `__body` and the whole grid card are `<a>`
 * to the client's website in a new tab (screen-reader note appended);
 * without it they stay a `<div>` / `<article>`. Grid cards get a hover state:
 * lift + the thumbnail's border → accent + the c-button hover shadow.
 *
 * Testimonial block: quote → author row (photo + name + role) → up to 2 KPIs.
 * Any missing field degrades gracefully (see fallbacks below).
 *
 * Motion is deferred: root gets `data-anim="card-reveal"` only.
 */
import type { Client, Kpi } from "../../lib/sanity/types";
import { urlFor, type Source } from "../../lib/sanity/image";
import Tag from "./Tag.astro";

type Variant = "featured" | "grid";

interface Props {
  client: Client;
  variant: Variant;
  /** Grid only. `compact` for full-height wordmarks (e.g. Surfe) that read
   *  larger than icon + text logos at the same box height. */
  logoSize?: "default" | "compact";
  class?: string;
}

const { client, variant, logoSize = "default", class: className } = Astro.props;

const rootClass = ["c-client-card", `is-${variant}`, className]
  .filter(Boolean)
  .join(" ");

const testimonial = client.testimonial;
const kpis: Kpi[] = (testimonial?.kpis ?? []).slice(0, 2);

// Screenshot URL (desktop). Falls through to the empty state when the asset is missing.
const screenshotAsset = client.websiteScreenshot?.asset;
const screenshotUrl = screenshotAsset
  ? urlFor(client.websiteScreenshot as Source).width(960).auto("format").url()
  : undefined;
const screenshotAlt = client.websiteScreenshot?.alt ?? client.name;
const videoUrl = client.websiteVideo?.asset?.url;
// Poster at the video's 16:9 (both featured videos are 1920×1080), so it
// fills the media box like the video does. Screenshot fallback keeps the top
// of the page (logo + headline) unless the Studio hotspot says otherwise.
const posterSource = client.websiteVideoPoster?.asset
  ? client.websiteVideoPoster
  : client.websiteScreenshot?.asset
    ? client.websiteScreenshot
    : undefined;
const posterUrl = posterSource
  ? urlFor(posterSource as Source).width(1280).height(720).fit("crop").crop("top").auto("format").url()
  : undefined;

// Author avatar (96px). If missing we render the first initial in a circle.
const authorPhotoAsset = testimonial?.authorPhoto?.asset;
const authorPhotoUrl = authorPhotoAsset
  ? urlFor(testimonial!.authorPhoto as Source)
      .width(96)
      .height(96)
      .fit("crop")
      .auto("format")
      .url()
  : undefined;
const authorInitial = testimonial?.authorName?.trim().charAt(0).toUpperCase() ?? "";

// Header logo — the card head shows the client's full logo, not their name.
const headLogoAsset = client.logo?.asset;
const headLogoUrl = headLogoAsset
  ? urlFor(client.logo as Source).height(100).auto("format").url()
  : undefined;
const headLogoAlt = client.logo?.alt ?? client.name;

// --- Grid variant ----------------------------------------------------------
// Thumbnail assets are authored at 547×360 (the card's Figma size); crops
// honour the Studio hotspot.
const THUMB_RATIO = 360 / 547;
const thumbAsset = client.cardThumbnail?.asset;
const thumbUrlAt = (w: number) =>
  urlFor(client.cardThumbnail as Source)
    .width(w)
    .height(Math.round(w * THUMB_RATIO))
    .fit("crop")
    .auto("format")
    .url();
const thumbSrc = thumbAsset ? thumbUrlAt(547) : undefined;
const thumbSrcset = thumbAsset
  ? [547, 820, 1094].map((w) => `${thumbUrlAt(w)} ${w}w`).join(", ")
  : undefined;
const thumbAlt = client.cardThumbnail?.alt ?? client.name;
const fundsLabel = client.fundsRaised?.trim()
  ? `${client.fundsRaised.trim()} Raised`
  : undefined;
const categoryLabel = client.category?.title;

// --- Links ------------------------------------------------------------------
const websiteUrl = client.websiteUrl?.trim() || undefined;
const linkAttrs = websiteUrl
  ? { href: websiteUrl, target: "_blank", rel: "noopener noreferrer" }
  : {};
const GridTag = websiteUrl ? "a" : "article";
const BodyTag = websiteUrl ? "a" : "div";
---

{variant === "grid" && (
<GridTag class:list={[rootClass, { "is-link": !!websiteUrl }]} data-anim="card-reveal" {...linkAttrs}>
  {
    thumbSrc ? (
      <div class="c-client-card__thumb">
        <img
          src={thumbSrc}
          srcset={thumbSrcset}
          sizes="(max-width: 767px) 100vw, (max-width: 991px) 50vw, 33vw"
          alt={thumbAlt}
          width="547"
          height="360"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class="c-client-card__thumb is-empty" aria-hidden="true" />
    )
  }

  <div class="c-client-card__footer">
    <h3 class:list={["c-client-card__logo", { "is-compact": logoSize === "compact" }]}>
      {headLogoUrl ? (
        <img src={headLogoUrl} alt={headLogoAlt} loading="lazy" decoding="async" />
      ) : (
        <span class="c-text_m">{client.name}</span>
      )}
      {/* TODO: COPY — screen-reader note on linked cards. */}
      {websiteUrl && <span class="c-client-card__sr-only"> (opens in a new tab)</span>}
    </h3>

    {(fundsLabel || categoryLabel) && (
      <div class="c-client-card__tags">
        {fundsLabel && <Tag>{fundsLabel}</Tag>}
        {categoryLabel && <Tag variant="accent">{categoryLabel}</Tag>}
      </div>
    )}
  </div>
</GridTag>
)}

{variant === "featured" && (
<article class={rootClass} data-anim="card-reveal">
  {
    videoUrl ? (
      <div class="c-client-card__screenshot is-video">
        <video
          class="c-client-card__video"
          src={videoUrl}
          poster={posterUrl}
          aria-label={screenshotAlt}
          muted
          loop
          playsinline
          preload="none"
          data-client-video
        />
      </div>
    ) : screenshotUrl ? (
      <div class="c-client-card__screenshot">
        <img src={screenshotUrl} alt={screenshotAlt} loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="c-client-card__screenshot is-empty" aria-hidden="true" />
    )
  }

  {
    testimonial ? (
      <BodyTag class:list={["c-client-card__body", { "is-link": !!websiteUrl }]} {...linkAttrs}>
        <div class="c-client-card__intro">
          <header class="c-client-card__head">
            {headLogoUrl ? (
              <img
                class="c-client-card__name"
                src={headLogoUrl}
                alt={headLogoAlt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="c-client-card__name c-text_m">{client.name}</span>
            )}
            {websiteUrl && <span class="c-client-card__sr-only"> (opens in a new tab)</span>}
            <svg
              class="c-client-card__arrow"
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 15 15"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M0.000296913 6.53399H11.6643C10.0983 5.20199 7.2543 2.51999 5.4903 0.917993L6.3543 -6.67572e-06L14.0583 7.16399V7.21799L6.3543 14.472L5.4903 13.536C7.2723 11.898 10.0803 9.28799 11.6643 7.84799H0.000296913V6.53399Z" fill="var(--color-text)" />
            </svg>
          </header>

          <blockquote class="c-client-card__quote c-paragraph">
            &ldquo;{testimonial.quote}&rdquo;
          </blockquote>

          <div class="c-client-card__author">
            {
              authorPhotoUrl ? (
                <img
                  class="c-client-card__author-photo"
                  src={authorPhotoUrl}
                  alt={testimonial.authorPhoto?.alt ?? testimonial.authorName}
                  loading="lazy"
                  decoding="async"
                  width="48"
                  height="48"
                />
              ) : (
                <span class="c-client-card__author-photo is-empty" aria-hidden="true">
                  {authorInitial}
                </span>
              )
            }
            <span class="c-client-card__author-meta">
              <span class="c-client-card__author-name c-text_s">
                {testimonial.authorName}
              </span>
              {testimonial.authorRole && (
                <span class="c-client-card__author-role c-paragraph_s">
                  {testimonial.authorRole}
                </span>
              )}
            </span>
          </div>
        </div>

        {
          kpis.length > 0 && (
            <ul class="c-client-card__kpis">
              {kpis.map((kpi) => (
                <li class="c-client-card__kpi">
                  <span class="c-client-card__kpi-value c-text_l">{kpi.value}</span>
                  <span class="c-client-card__kpi-desc c-paragraph_s">
                    {kpi.description}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </BodyTag>
    ) : (
      // TODO: COPY testimonial missing — card renders without quote/author/kpi block.
      <div class="c-client-card__body is-empty">
        <span class="c-client-card__name c-text_m">{client.name}</span>
      </div>
    )
  }
</article>
)}

<script>
  // Featured card videos: play while the card is on screen, pause when it
  // leaves (resumes where it stopped). Muted + playsinline, so autoplay is
  // allowed on touch devices too. Never under reduced motion or Data Saver:
  // the native poster stays. `preload="none"` in the markup: play() is the
  // first request. The media box follows the file's real ratio once known.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>("[data-client-video]"));

  videos.forEach((video) => {
    video.addEventListener("loadedmetadata", () => {
      if (video.videoWidth > 0 && video.videoHeight > 0) {
        video.parentElement?.style.setProperty(
          "--c-client-card-ratio",
          `${video.videoWidth} / ${video.videoHeight}`,
        );
      }
    });
  });

  if (videos.length > 0 && !saveData) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reduced.matches) {
            void video.play().catch(() => {});
          } else if (!video.paused) {
            video.pause();
          }
        });
      },
      { threshold: 0.25 },
    );
    videos.forEach((video) => observer.observe(video));
  }
</script>

<style>
  .c-client-card {
    display: grid;
    /* Column ratio is set by the parent section (FeaturedWork) since it
       differs per card. Default falls back to 1fr 1fr. */
    grid-template-columns: 1fr 1fr;
    gap: 1.3rem;
  }

  

  @media (max-width: 991px) {
    .c-client-card {
      grid-template-columns: 1fr;
    }
  }

  /* --- Screenshot ------------------------------------------------------ */
  .c-client-card__screenshot {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: var(--color-gray-light);
    height: 32.5rem;
  }

  @media (max-width: 991px) {
    .c-client-card__screenshot {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }

  /* Video (lead 2026-09-30, QA S3): the box takes the video's own ratio at
     the column width, at every breakpoint and on both sides (media left on
     the 1st card, right on the 2nd), so no frame is ever cropped. The body
     stretches to the row; if its content is taller, the video box stays
     at its ratio, centered. `--c-client-card-ratio` is updated from the
     file's metadata (ClientCard script). */
  .c-client-card__screenshot.is-video {
    height: auto;
    aspect-ratio: var(--c-client-card-ratio, 16 / 9);
    align-self: center;
  }

  .c-client-card__screenshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the site's logo + headline (top-left) when the 4:3 crop kicks in. */
    object-position: left top;
    display: block;
  }

  .c-client-card__video {
    width: 100%;
    height: 100%;
    /* The box already has the video's ratio; contain is a no-crop guard. */
    object-fit: contain;
    display: block;
  }

  .c-client-card__screenshot.is-empty {
    background: var(--color-gray-light);
  }

  /* Visually hidden link note (same 1px clip pattern as ClientList). */
  .c-client-card__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* --- Body (the real visible card) ----------------------------------- */
  a.c-client-card__body {
    color: inherit;
    text-decoration: none;
  }
  .c-client-card__body.is-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-client-card__body {
    display: flex;
    width: 100%;
    padding: 1.714rem; /* 24px */
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    align-self: stretch;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    height: 100%;
    /* TODO: DS body internal spacing between quote / author / KPIs. */
    gap: 1.25rem;
    transition:
      transform var(--duration-hover) var(--ease-smooth),
      border-color var(--duration-hover) var(--ease-smooth),
      box-shadow var(--duration-hover) var(--ease-smooth);
  }

  /* Hover (lead 2026-09-30): lift + c-button's hover shadow, accent border,
     arrow turns accent + rotates like ClientList's. */
  .c-client-card__body:hover {
    transform: translateY(-3%);
    border-color: var(--color-accent);
    box-shadow: 0 0 20px #2223;
  }
  .c-client-card__body:hover .c-client-card__arrow {
    transform: rotate(-30.963deg);
  }
  .c-client-card__body:hover .c-client-card__arrow path {
    fill: var(--color-accent);
  }


  /* Intro block wraps head / quote / author so the body's space-between
     pushes the KPIs to the bottom. Internal 24px rhythm. */
  .c-client-card__intro {
    display: flex;
    flex-direction: column;
    gap: 1.714rem; /* 24px */
    width: 100%;
  }

  .c-client-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .c-client-card__name {
    color: var(--color-heading);
  }
  /* When the head renders the client logo image (default), constrain it. */
  img.c-client-card__name {
    display: block;
    max-height: 2.25rem;
    width: auto;
    object-fit: contain;
  }

  .c-client-card__arrow {
    width: 1.143rem; /* 16px */
    height: 1.143rem;
    flex: 0 0 auto;
    display: block;
    transition: transform var(--duration-hover) var(--ease-smooth);
  }
  .c-client-card__arrow path {
    transition: fill var(--duration-hover) var(--ease-smooth);
  }

  .c-client-card__quote {
    color: var(--color-text);
    margin: 0;
  }

  /* --- Author ---------------------------------------------------------- */
  .c-client-card__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .c-client-card__author-photo {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: cover;
    display: block;
  }

  .c-client-card__author-photo.is-empty {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-gray-light);
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1;
  }

  .c-client-card__author-meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .c-client-card__author-name {
    color: var(--color-heading);
  }

  .c-client-card__author-role {
    color: var(--color-text);
  }

  /* --- KPIs ------------------------------------------------------------ */
  .c-client-card__kpis {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* TODO: DS gap between KPIs — matches featured-work ref spacing. */
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .c-client-card__kpi {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    /* KPI description sits inside a faint bordered pill in the ref. */
    text-align: center;
  }

  .c-client-card__kpi-value {
    color: var(--color-blue);
  }

  .c-client-card__kpi-desc {
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.064em;
    border: var(--border-default);
    border-radius: 3px;
    padding: 0.35em 0.9em;
    width: 100%;
  }
  /* Scoped size (lead visual QA 2026-09-30). ≥768 only, like the grid tags:
     at the 9px mobile root 0.8rem would be 7.2px. */
  @media (min-width: 768px) {
    .c-client-card__kpi-desc {
      font-size: 0.8rem;
    }
  }

  /* ===================================================================== */
  /* Grid variant (Home Our Work)                                           */
  /* ===================================================================== */
  .c-client-card.is-grid {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    color: inherit;
    text-decoration: none;
    transition: transform var(--duration-hover) var(--ease-smooth);
  }

  /* Hover (lead 2026-09-30, every clients grid): the featured body's lift
     and the c-button hover shadow on the thumbnail, border → accent.
     TODO: DS — no hover spec for grid cards; values reused from the
     featured card. */
  .c-client-card.is-grid.is-link:hover {
    transform: translateY(-3%);
  }
  .c-client-card.is-grid.is-link:hover .c-client-card__thumb {
    border-color: var(--color-accent);
    box-shadow: 0 0 20px #2223;
  }
  .c-client-card.is-grid.is-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 0.625rem;
  }

  .c-client-card__thumb {
    overflow: hidden;
    border-radius: 0.625rem; /* 10px — rem per lead request 2026-09-28 */
    border: var(--border-default);
    background: var(--color-gray-light);
    aspect-ratio: 547 / 360;
    transition:
      border-color var(--duration-hover) var(--ease-smooth),
      box-shadow var(--duration-hover) var(--ease-smooth);
  }

  .c-client-card__thumb img {
    display: block;
    border-radius: 0.625rem;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-client-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    /* Logo and tags sit inset from the thumbnail edges in the ref (≈20px). */
    padding-inline: 1.25rem;
    padding-bottom: 1.3rem;
  }

  .c-client-card__logo {
    margin: 0;
    color: var(--color-heading);
    line-height: 0;
  }
  .c-client-card__logo > span {
    line-height: 1.4;
  }

  /* Logo exports vary in intrinsic height; a single box height keeps the
     row aligned. `is-compact` optically balances full-height wordmarks
     against icon + text logos. */
  .c-client-card__logo img {
    display: block;
    height: 2.35rem;
    width: auto;
    max-width: 11.2rem;
    object-fit: contain;
    object-position: left center;
  }

  .c-client-card__logo.is-compact img {
    height: 1.4rem;
    max-width: 6.3rem;
  }

  .c-client-card__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    /* TODO: DS gap between tags (ref ≈ 6px). */
    gap: 0.375rem;
  }

  /* Grid cards only (every page with a clients grid) — lead 2026-09-30.
     Desktop only: mobile keeps the global 12px c-tag size (.8rem = 7.2px). */
  @media (min-width: 768px) {
    .c-client-card.is-grid :global(.c-tag) {
      font-size: 0.8rem;
    }
  }
</style>
