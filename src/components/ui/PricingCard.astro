---
/**
 * PricingCard — plan name, description, gradient price, feature list and a
 * full-width "Get In Touch" button that opens the contact modal.
 * Ref: `docs/refs/pricing/pricing-cards.jpg`.
 *
 * Price: `price` (+ optional `period`, e.g. "/mo") or `priceLabel` (e.g.
 * "Let's chat", same gradient style, no period). `price` wins if both are set.
 *
 * Layout contract: the card uses CSS subgrid (4 rows: header, price, features,
 * CTA) so prices and buttons line up across cards. Place cards directly in a
 * grid parent, e.g. `display: grid; grid-template-columns: repeat(3, 1fr);`.
 * Outside a grid the card still renders correctly, just without cross-card
 * alignment.
 *
 * The plan name is an `<h3>`: the page needs an `<h1>` and a section `<h2>`
 * (visible or visually hidden) above the cards.
 */
import Button from "./Button.astro";

interface Props {
  name: string;
  description: string;
  price?: string;
  period?: string;
  priceLabel?: string;
  features: string[];
  ctaLabel?: string;
  class?: string;
}

const {
  name,
  description,
  price,
  period,
  priceLabel,
  features,
  ctaLabel = "Get In Touch",
  class: className,
} = Astro.props;

const amount = price ?? priceLabel;
const showPeriod = Boolean(price && period);
const rootClass = ["c-pricing-card", className].filter(Boolean).join(" ");
---

<article class={rootClass} data-anim="pricing-card">
  <div class="c-pricing-card__header">
    <h3 class="c-pricing-card__name c-text_l">{name}</h3>
    <p class="c-pricing-card__description c-paragraph">{description}</p>
  </div>

  <p class="c-pricing-card__price">
    {amount && <span class="c-pricing-card__amount c-text_xxl" data-anim="pricing-amount">{amount}</span>}
    {showPeriod && <span class="c-pricing-card__period c-paragraph">{period}</span>}
  </p>

  <ul class="c-pricing-card__features" role="list">
    {features.map((feature) => (
      <li class="c-pricing-card__feature c-paragraph">
        <span class="c-pricing-card__check" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="20" height="20" fill="none">
            <path
              d="M6 10.4l2.6 2.6L14 7.6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <div class="c-pricing-card__cta">
    <Button variant="gradient" class="c-pricing-card__button js-open-contact">{ctaLabel}</Button>
  </div>
</article>

<style>
  /* Lead visual QA 2026-09-29 (ref px → rem at 1/14). The subgrid is kept so
     prices, feature lists and buttons line up across cards; `row-gap` is the
     28px between blocks. Glass surface over the page line art. */
  .c-pricing-card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: 2rem; /* 28px */
    align-self: stretch;
    padding: 1.5rem; /* 21px */
    border: 0.8px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface-glass);
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    /* TODO: DS — the faint lavender glow in the ref (top-left on card 1,
       top-right on card 3, none on card 2) is not built. */
  }

  .c-pricing-card__header {
    display: flex;
    flex-direction: column;
    gap: 1rem; /* 14px */
  }

  /* Name: `c-text_l` (Brulia, 140%) with a scoped 1.8rem size (lead visual QA
     2026-09-29; not a DS token); 2.7rem at ≤767 (media query below).
     Ref text is #222222; closest token is --color-black-secondary (lead). */
  .c-pricing-card__name {
    font-size: 1.8rem;
  }

  .c-pricing-card__name,
  .c-pricing-card__description,
  .c-pricing-card__period,
  .c-pricing-card__feature {
    color: var(--color-black-secondary);
  }

  /* The period always sits right of the amount (no wrapping). */
  .c-pricing-card__price {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 0;
    margin: 0;
  }

  /* Amount: `c-text_xxl` (Brulia, 120%) with a scoped 4.6rem size (lead
     visual QA 2026-09-29; not a DS token, same at every breakpoint).
     Gradient from the lead's spec (290deg, #6BB0F7 8.49% → #6275F6 91.51%),
     written with the brand color tokens. Same technique as the `is-white`
     button text (§7.3). */
  .c-pricing-card__amount {
    font-size: 4.6rem;
    color: var(--color-blue); /* fallback without background-clip: text */
  }
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .c-pricing-card__amount {
      background: linear-gradient(290deg, var(--color-blue-light) 8.49%, var(--color-blue) 91.51%);
      -webkit-background-clip: text;
              background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  }

  .c-pricing-card__features {
    display: flex;
    flex-direction: column;
    gap: 1rem; /* 14px */
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Font size of `c-text_s` (lead); the body font of `c-paragraph` is kept. */
  .c-pricing-card__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.714rem; /* 10px icon → text — TODO: DS */
    font-size: var(--fs-text-s);
  }

  /* Gradient circle + white check. The circle is a CSS background so the
     gradient comes straight from --gradient-primary (no SVG gradient ids). */
  .c-pricing-card__check {
    display: inline-flex;
    flex: 0 0 auto;
    width: 1.429rem; /* 20px — TODO: DS icon sizes (§9) */
    height: 1.429rem;
    /* Center the icon on the first text line (line-height 1.5). */
    margin-top: calc((var(--fs-text-s) * 1.5 - 1.429rem) / 2);
    border-radius: 50%;
    background: var(--gradient-primary);
    color: var(--color-white);
  }
  .c-pricing-card__check svg {
    width: 100%;
    height: 100%;
  }

  .c-pricing-card__cta {
    align-self: end;
  }
  /* 0.75rem vertical padding on this button only (lead); `.c-button` keeps
     its em side padding. */
  .c-pricing-card__cta :global(.c-button.c-pricing-card__button) {
    width: 100%;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  /* TODO: DS mobile — no mobile refs; a little more side padding. */
  @media (max-width: 767px) {
    .c-pricing-card {
      padding: 2rem;
    }
    /* Lead visual QA 2026-09-29: 2.7rem on mobile (≈24px at the 9px root). */
    .c-pricing-card__name {
      font-size: 2.7rem;
    }
  }
</style>
