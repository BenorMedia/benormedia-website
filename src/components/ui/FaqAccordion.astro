---
/**
 * FaqAccordion — bordered question rows with a blue + / × icon; the open
 * answer sits below its row as a gray paragraph. Ref: `docs/refs/pricing/FAQs.jpg`.
 *
 * Native `<details name>` + `<summary>`: exclusive (one open at a time in
 * supporting browsers), keyboard accessible and fully working without JS.
 *
 * With JS, `initAccordion` (`src/scripts/ui/accordion.ts`) animates open /
 * close (height + answer fade) and keeps one item open at a time; the icon
 * rotates with a CSS transition. Reduced motion → instant toggle.
 *
 * Rows are glass (`--color-surface-glass` + blur) so section line art shows
 * through (lead visual QA 2026-09-29).
 *
 * `answer` is plain text; a blank line (`\n\n`) starts a new paragraph.
 *
 * New pages (optional, default output unchanged): `npSrc` adds the
 * `data-np-src` source attributes the new-page checks read, and an item's
 * `questionHtml` / `answerHtml` (escaped by the loader, with preview gap
 * highlights) replace the plain text.
 * Empty `items` → renders nothing.
 */
interface FaqItem {
  question: string;
  answer: string;
  questionHtml?: string;
  answerHtml?: string;
}

interface Props {
  items: FaqItem[];
  /** Group name shared by the `<details>` elements (exclusive accordion). Unique per accordion. */
  name: string;
  /** Open the first item on load. Default: all closed. */
  openFirst?: boolean;
  /** New pages: `data-np-src` on the question and the answer. Default false. */
  npSrc?: boolean;
  class?: string;
}

const { items, name, openFirst = false, npSrc = false, class: className } = Astro.props;

const rootClass = ["c-faq", className].filter(Boolean).join(" ");
const toParagraphs = (text: string): string[] =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
---

{
  items.length > 0 && (
    <div class={rootClass}>
      {items.map((item, i) => (
        <details class="c-faq__item" name={name} open={openFirst && i === 0} data-anim="faq-item">
          <summary class="c-faq__summary">
            {item.questionHtml !== undefined ? (
              <span class="c-faq__question c-paragraph_m" data-np-src={npSrc ? "faq.q" : undefined} set:html={item.questionHtml} />
            ) : (
              <span class="c-faq__question c-paragraph_m" data-np-src={npSrc ? "faq.q" : undefined}>{item.question}</span>
            )}
            <span class="c-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 12 12" width="12" height="12" fill="none">
                <path d="M6 0.75v10.5M0.75 6h10.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <div class="c-faq__answer" data-anim="faq-answer">
            {item.answerHtml !== undefined ? (
              <p class="c-paragraph_m" data-np-src={npSrc ? "faq.a" : undefined} set:html={item.answerHtml} />
            ) : (
              toParagraphs(item.answer).map((p) => (
                <p class="c-paragraph_m" data-np-src={npSrc ? "faq.a" : undefined}>{p}</p>
              ))
            )}
          </div>
        </details>
      ))}
    </div>
  )
}

<script>
  import { initAccordion } from "../../scripts/ui/accordion";

  document.querySelectorAll<HTMLElement>(".c-faq").forEach((root) => {
    initAccordion(root);
  });
</script>

<style>
  /* Lead visual QA 2026-09-29 (ref px → rem at 1/14): width 70%, 77px rows,
     8px radius, glass surface. Other values measured from the 1920 ref.
     TODO: DS — gaps, side padding and icon size are not in DESIGN_SYSTEM. */
  .c-faq {
    display: flex;
    flex-direction: column;
    gap: 0.75rem; /* ≈10.5px between rows — TODO: DS */
    width: 100%;
    max-width: 70%;
    margin-inline: auto;
  }

  /* 77px (5.5rem) tall with one line of question: the height comes from the
     padding, so long questions grow instead of overflowing. `min-height`
     backs it up. Question left, icon right. */
  .c-faq__summary {
    display: flex;
    align-items: center;
    align-self: stretch;
    justify-content: space-between;
    gap: 1.714rem;
    min-height: 5.5rem; /* 77px */
    /* (5.5rem − 2px border − 1.6 × 1.3rem line) / 2 ≈ 1.639rem */
    padding: 1.639rem 2.286rem; /* 32px sides — TODO: DS */
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-surface-glass);
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    list-style: none;
    cursor: pointer;
  }
  .c-faq__summary::-webkit-details-marker {
    display: none;
  }
  .c-faq__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .c-faq__question {
    color: var(--color-heading);
    text-align: left;
  }

  .c-faq__icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 0.857rem; /* 12px — TODO: DS icon sizes (§9) */
    height: 0.857rem;
    color: var(--color-accent);
    transition: transform var(--duration-hover) var(--ease-smooth);
  }
  .c-faq__icon svg {
    width: 100%;
    height: 100%;
  }

  /* Open: the + turns into × (CSS transition). While the script collapses an
     item it is still `[open]`, so `is-closing` turns the icon back at once. */
  .c-faq__item[open]:not(.is-closing) .c-faq__icon {
    transform: rotate(45deg);
  }

  .c-faq__answer {
    display: flex;
    flex-direction: column;
    gap: 1rem; /* between paragraphs — TODO: DS */
    padding: 2.643rem 2.286rem 1.857rem; /* ≈37 / 32 / 26px — TODO: DS */
    color: var(--color-text);
  }

  /* TODO: DS mobile — no mobile refs; tighter side padding. */
  @media (max-width: 767px) {
    .c-faq {
      max-width: 100%;
    }
    .c-faq__summary {
      padding: 1.639rem 1.714rem;
    }
    .c-faq__answer {
      padding: 1.714rem 1.714rem 1.143rem;
    }
    /* 12px at the 9px mobile root (desktop size would render at ≈7.7px). */
    .c-faq__icon {
      width: 1.3333rem;
      height: 1.3333rem;
    }
  }
</style>
