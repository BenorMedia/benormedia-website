---
/**
 * CaseStack — "Stack and integrations" hub (Figma 4225:12579): the core
 * platform card (brand gradient, glow, a tilted glass tile with the 3D
 * logo, white chip) on the left; the integrations as four white cards with
 * a logo tile, chip, name and use, each with a soft glow (Figma ellipse
 * export) placed per slot.
 * ≤991: the core card goes full width above the integrations; ≤767: the
 * integrations stack (`TODO: DS mobile`).
 */
import CaseDecor from "./CaseDecor.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import type { CsStackCore, CsStackItem } from "../../lib/case-studies/types";
import glow from "../../assets/case-studies/shared/stack-glow.svg";
import ellipse from "../../assets/case-studies/shared/stack-ellipse.svg";

interface Props {
  core: CsStackCore;
  items: readonly CsStackItem[];
}

const { core, items } = Astro.props;
/** Glow position per card slot (Figma px from the card's top-left; the
 *  export is 557.86 px square, its circle 381.88 px). */
const GLOWS = [
  { x: -176.38, y: 84 },
  { x: 196, y: 84 },
  { x: 181, y: -307.31 },
  { x: -1, y: 126 },
];
---

<div class="c-case-stack">
  <div class="c-case-stack__core">
    <img class="c-case-stack__glow" src={glow.src} alt="" width="560" height="560" aria-hidden="true" />
    <div class="c-case-stack__tile" aria-hidden="true">
      <CaseDecor src={core.image.src} width={170} class="c-case-stack__tile-img" />
    </div>
    <Eyebrow class="c-case-stack__core-chip">{core.chip}</Eyebrow>
    <h3 class="c-text_m c-case-stack__core-name">{core.name}</h3>
    <p class="c-paragraph_m c-case-stack__core-text">{core.text}</p>
  </div>
  <ul class="c-case-stack__items">
    {items.map((item, i) => {
      const g = GLOWS[i % GLOWS.length]!;
      return (
        <li class="c-case-stack__item">
          <img
            class="c-case-stack__ellipse"
            src={ellipse.src}
            alt=""
            width="558"
            height="558"
            aria-hidden="true"
            style={`--x: ${g.x}; --y: ${g.y};`}
          />
          <div class="c-case-stack__head">
            <span class="c-case-stack__logo">
              <CaseDecor src={item.logo.src} width={36} class="c-case-stack__logo-img" />
            </span>
            <Eyebrow>{item.chip}</Eyebrow>
          </div>
          <h3 class="c-paragraph_m c-case-stack__name">{item.name}</h3>
          <p class="c-paragraph_m c-case-stack__text">{item.text}</p>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .c-case-stack {
    --u: calc(1rem / 19.2);
    display: grid;
    grid-template-columns: calc(460 * var(--u)) minmax(0, 1fr);
    gap: calc(16 * var(--u));
  }
  .c-case-stack__core {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: calc(20 * var(--u));
    min-height: calc(440 * var(--u));
    padding: calc(40 * var(--u));
    overflow: hidden;
    border-radius: 8px;
    background: var(--gradient-primary);
    color: var(--color-white);
  }
  .c-case-stack__glow {
    position: absolute;
    top: calc(-210 * var(--u));
    left: calc(50 * var(--u));
    width: calc(560 * var(--u));
    height: auto;
    pointer-events: none;
  }
  /* Glass tile, centred at +146 / -128.5 px from the card's middle. */
  .c-case-stack__tile {
    position: absolute;
    top: calc(50% - 128.52 * var(--u));
    left: calc(50% + 146.08 * var(--u));
    display: flex;
    justify-content: center;
    width: calc(198.2 * var(--u));
    padding: calc(23.29 * var(--u)) calc(36.6 * var(--u));
    border: 1px solid var(--color-border);
    border-radius: 13.3px;
    background: var(--color-surface-glass); /* Figma white 10%, TODO: DS */
    -webkit-backdrop-filter: blur(9.67px);
            backdrop-filter: blur(9.67px);
    transform: translate(-50%, -50%) rotate(-30.23deg);
  }
  .c-case-stack :global(.c-case-stack__tile-img) {
    width: calc(169.75 * var(--u));
    height: auto;
  }
  /* White chip on the gradient (CtaBanner's on-dark eyebrow, TODO: DS). */
  .c-case-stack :global(.c-case-stack__core-chip) {
    position: relative;
    border-color: var(--color-white);
    color: var(--color-white);
  }
  .c-case-stack :global(.c-case-stack__core-chip)::before,
  .c-case-stack :global(.c-case-stack__core-chip)::after {
    border-color: var(--color-white);
    background: color-mix(in srgb, var(--color-white) 10%, transparent);
  }
  .c-case-stack__core-name {
    position: relative;
    margin: 0;
    color: var(--color-white);
    line-height: 1.5;
    font-size: var(--cs-fs-h3);
  }
  .c-case-stack__core-text {
    position: relative;
    margin: 0;
    color: var(--color-gray-light); /* Figma Grey 200 #F3F3F3, TODO: DS */
    font-size: var(--cs-fs-body);
    line-height: 1.5;
  }

  .c-case-stack__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(16 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .c-case-stack__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: calc(16 * var(--u));
    min-width: 0;
    min-height: calc(212 * var(--u));
    padding: calc(24 * var(--u));
    overflow: hidden;
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-white);
  }
  .c-case-stack__ellipse {
    position: absolute;
    top: calc((var(--y) - 88) * var(--u));
    left: calc((var(--x) - 88) * var(--u));
    width: calc(557.86 * var(--u));
    height: auto;
    pointer-events: none;
  }
  .c-case-stack__head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(16 * var(--u));
  }
  .c-case-stack__logo {
    display: grid;
    flex: none;
    place-items: center;
    border: var(--border-default);
    border-radius: 8px;
    background: var(--color-gray-light); /* Figma #F7F7F7, TODO: DS */
    width: calc(44 * var(--u));
    height: calc(44 * var(--u));
  }
  .c-case-stack :global(.c-case-stack__logo-img) {
    width: 68%;
    height: auto;
  }
  .c-case-stack__name {
    position: relative;
    margin: 0;
    color: var(--color-black-secondary);
    font-size: var(--cs-fs-body);
    line-height: 1.2;
  }
  .c-case-stack__text {
    position: relative;
    margin: 0;
    color: var(--color-text);
    font-size: var(--cs-fs-body);
    line-height: 1.5;
  }
  @media (max-width: 991px) {
    .c-case-stack { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .c-case-stack__items { grid-template-columns: minmax(0, 1fr); }
    .c-case-stack__core { min-height: 36rem; padding: 2.4rem; }
    .c-case-stack__item { min-height: 0; padding: 2rem; }
    .c-case-stack__tile { top: 9rem; left: auto; right: -2rem; transform: rotate(-30.23deg); width: 14rem; }
    .c-case-stack :global(.c-case-stack__tile-img) { width: 11rem; }
  }
</style>
