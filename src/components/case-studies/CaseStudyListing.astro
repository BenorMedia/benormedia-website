---
/**
 * CaseStudyListing — c-cs-listing
 * The `/case-studies` card grid under the index hero
 * (`CaseStudiesIndexHero`), Figma 3790:36389 "container case studies":
 * 110px above and below the grid.
 * Every published case study, newest first, no pagination or filters
 * (lead 2026-10-20). Renders nothing when there are no cards.
 */
import Container from "../ui/Container.astro";
import CaseStudyGrid from "./CaseStudyGrid.astro";
import type { CaseStudyCard as CaseStudyCardData } from "../../lib/sanity/types";

interface Props {
  cards: readonly CaseStudyCardData[];
}

const { cards } = Astro.props;
---

{cards.length > 0 && (
  <div class="c-cs-listing">
    <Container>
      <CaseStudyGrid cards={cards} variant="index" />
    </Container>
  </div>
)}

<style>
  .c-cs-listing :global(.c-container) {
    padding-top: 7.857rem;
    padding-bottom: 7.857rem;
  }
  /* Mobile: the blog index's 5rem (NpBlogResources). */
  @media (max-width: 767px) {
    .c-cs-listing :global(.c-container) {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }
</style>
