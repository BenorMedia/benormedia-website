---
/**
 * CaseTable — the results table (Figma 4225:12500): a real `<table>` with a
 * visually hidden `<caption>` and `<th scope="col">`; the first cell of
 * each row is its `<th scope="row">`. Bordered box, gray header row,
 * a square on each side. Narrow screens scroll the table inside its
 * wrapper (focusable, labelled), never the page.
 */
import type { CsTable } from "../../lib/case-studies/types";

interface Props {
  table: CsTable;
}

const { table } = Astro.props;
---

<div class="c-case-table">
  <div class="c-case-table__scroll" tabindex="0" role="region" aria-label={table.caption}>
    <table class="c-paragraph c-case-table__table">
      <caption class="c-case-table__caption">{table.caption}</caption>
      <thead>
        <tr>{table.columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {table.rows.map(([metric, ...cells]) => (
          <tr>
            <th scope="row">{metric}</th>
            {cells.map((c) => <td>{c}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <span class="c-case-table__square is-left" aria-hidden="true"></span>
  <span class="c-case-table__square is-right" aria-hidden="true"></span>
</div>

<style>
  .c-case-table {
    --u: calc(1rem / 19.2);
    position: relative;
  }
  .c-case-table__scroll {
    overflow-x: auto;
    border: var(--border-default);
    border-radius: 8px;
  }
  .c-case-table__scroll:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .c-case-table__table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    color: var(--color-text);
    text-align: left;
  }
  .c-case-table__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Figma 4225:12500: rows 10px / header 16px vertical, 16px sides,
     40px between columns (20 + 20), columns 250 / 72 / 200 / rest, 18px
     text, line-height normal, a #E4E6EA rule under each row. */
  .c-case-table__table th,
  .c-case-table__table td {
    padding: calc(10 * var(--u)) calc(20 * var(--u));
    border-bottom: var(--border-default);
    font-size: var(--cs-fs-small);
    font-weight: 400;
    line-height: 1.2;
    vertical-align: middle;
  }
  .c-case-table__table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .c-case-table__table tr > :first-child {
    padding-left: calc(16 * var(--u));
  }
  .c-case-table__table tr > :last-child {
    padding-right: calc(16 * var(--u));
  }
  .c-case-table__table thead th {
    padding-block: calc(16 * var(--u));
    border-bottom: 0;
    background: var(--color-gray-light); /* Figma #F7F7F7, TODO: DS */
    color: var(--color-black-secondary); /* Figma Acumin Medium; 400 used, TODO: DS */
  }
  .c-case-table__table th[scope="row"] {
    color: var(--color-text);
  }
  .c-case-table__table tr > :nth-child(1) { width: calc((250 + 36) * var(--u)); }
  .c-case-table__table tr > :nth-child(2) { width: calc((72 + 40) * var(--u)); }
  .c-case-table__table tr > :nth-child(3) { width: calc((200 + 40) * var(--u)); }
  .c-case-table__square {
    position: absolute;
    top: 50%;
    width: calc(15 * var(--u));
    height: calc(15 * var(--u));
    border: 0.75px solid var(--color-gray);
    border-radius: 2.25px;
    background: var(--color-white);
    transform: translateY(-50%);
  }
  .c-case-table__square.is-left { left: calc(-7.5 * var(--u)); }
  .c-case-table__square.is-right { right: calc(-7.5 * var(--u)); }
  @media (max-width: 767px) {
    .c-case-table__table th,
    .c-case-table__table td { padding: 1.2rem; }
    .c-case-table__table tr > :first-child { padding-left: 1.2rem; }
    /* Phones: columns size to their content; the table scrolls. */
    .c-case-table__table { min-width: 64rem; }
    .c-case-table__table tr > :nth-child(n) { width: auto; }
    .c-case-table__square { display: none; }
  }
</style>
