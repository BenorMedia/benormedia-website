---
/**
 * CaseStudyBrowser — c-cs-browser
 * The hero's website frame (Figma 3842:40085): a browser window (three
 * window dots, the URL pill with the site's host) around the client's
 * `websiteScreenshot`, and the "Visit live site" button (`Button`
 * `is-white`) over the screenshot when the client has a `websiteUrl`.
 * Figma's hand cursor next to the button is a mock pointer and is left out.
 *
 * Renders nothing without a screenshot (no design for that state). The
 * window is 112.4% as wide as its box (Figma 1103 of 981px) and the hero
 * clips it at the viewport edge, as in Figma.
 */
import Button from "../ui/Button.astro";
import type { CaseStudy } from "../../lib/sanity/types";
import { clientImageAlt, isSvgAsset, urlFor, type Source } from "../../lib/sanity/image";
import { hasImage, type CaseStudyImageInput } from "./image";
import { CASE_STUDY_COPY } from "./copy";

interface Props {
  client: CaseStudy["client"];
}

const { client } = Astro.props;
const shot = client?.websiteScreenshot as CaseStudyImageInput;
const url = client?.websiteUrl?.trim() || undefined;

let src: string | undefined;
if (shot?.previewSrc) src = shot.previewSrc;
else if (shot?.asset) {
  const id = shot.asset._id ?? shot.asset._ref;
  // 1069px wide in Figma at 1920: fetched at 2x.
  src = isSvgAsset(id) ? urlFor(shot as Source).url() : urlFor(shot as Source).width(2138).fit("max").auto("format").url();
}
const alt = clientImageAlt(shot?.alt, client?.name, "website");

let host = "";
if (url) {
  try {
    host = new URL(url).hostname.replace(/^www\./, "");
  } catch {
    host = "";
  }
}
---

{hasImage(shot) && src && (
  <div class="c-cs-browser">
    <div class="c-cs-browser__window">
      <div class="c-cs-browser__bar" aria-hidden="true">
        <span class="c-cs-browser__dots"><span></span><span></span><span></span></span>
        <span class="c-cs-browser__url c-paragraph_s">{host}</span>
      </div>
      <img class="c-cs-browser__shot" src={src} alt={alt} width="1069" height="611" loading="eager" decoding="async" />
      {url && (
        <Button variant="white" href={url} target="_blank" rel="noopener" class="c-cs-browser__cta">
          {CASE_STUDY_COPY.visitSite}<span class="c-cs-browser__sr-only">{CASE_STUDY_COPY.newTab}</span>
          <svg slot="icon" class="c-cs-browser__icon" viewBox="0 0 16 16" width="16" height="16" fill="none" focusable="false">
            <path fill="currentColor" fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0z" />
          </svg>
        </Button>
      )}
    </div>
  </div>
)}

<style>
  /* The box the hero gives it; the window is wider and is clipped by the
     hero (Figma frame 3842:40084, 981px, overflow clip). */
  .c-cs-browser {
    position: relative;
    min-width: 0;
  }
  /* Figma: #F4F5F7, 8px radius, overflow clip. */
  .c-cs-browser__window {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 112.4%;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-browser-bg);
  }
  /* 63.7px bar: three 16.8px dots from 30px, 14.4px apart; the URL pill
     (287.7 × 28.8px, white, 1px border) centred. */
  .c-cs-browser__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 4.549rem;
  }
  .c-cs-browser__dots {
    position: absolute;
    top: 50%;
    left: 2.141rem;
    display: flex;
    gap: 1.028rem;
    transform: translateY(-50%);
  }
  /* Figma window dots (3842:40088–40090). */
  .c-cs-browser__dots span {
    width: 1.199rem;
    height: 1.199rem;
    border-radius: 50%;
    background: var(--color-browser-red);
  }
  .c-cs-browser__dots span:nth-child(2) {
    background: var(--color-browser-yellow);
  }
  .c-cs-browser__dots span:nth-child(3) {
    background: var(--color-browser-green);
  }
  /* URL text Figma 13.2px #8A909E: `c-paragraph_s` (12.6px). */
  .c-cs-browser__url {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26.1%;
    min-width: 8rem;
    height: 2.055rem;
    overflow: hidden;
    border: var(--border-default);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-browser-url);
    line-height: 1;
    white-space: nowrap;
  }
  /* Screenshot: 1069 of 1103px (16.9px each side), top corners 8px. */
  .c-cs-browser__shot {
    display: block;
    width: 96.94%;
    height: auto;
    aspect-ratio: 1069 / 611;
    object-fit: cover;
    object-position: top left;
    border-radius: 8px 8px 0 0;
    background: var(--color-white);
  }
  /* Button centre: 134px right of and 21.5px above the window's centre
     (Figma 3842:40094), as shares of the 1103 × 675 window. */
  .c-cs-browser :global(.c-cs-browser__cta) {
    position: absolute;
    top: 46.82%;
    left: 62.15%;
    white-space: nowrap;
    translate: -50% -50%;
  }
  .c-cs-browser__icon {
    display: block;
    width: 1em;
    height: 1em;
  }
  .c-cs-browser__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  /* Mobile: the button in the middle of the visible part of the screenshot. */
  @media (max-width: 767px) {
    .c-cs-browser :global(.c-cs-browser__cta) {
      top: 55%;
      left: 44.5%;
    }
  }
</style>
