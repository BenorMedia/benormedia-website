---
/**
 * CaseStudyHero — c-cs-hero
 * Case study header (Figma 3842:40061): left = breadcrumbs (Home › Case
 * studies › title, the blog's chevron trail `NpCrumbs`), the client logo in
 * a default `Eyebrow` box (its side squares) next to the accent "Case
 * study" `Eyebrow`, the H1 and the intro; right = the website frame
 * (`CaseStudyBrowser`), which runs past the container to the viewport's
 * right edge and is clipped there, as in Figma. The facts row
 * (`CaseStudyFacts`) follows as its own block.
 *
 * Figma has no date or read time in this hero any more (3842:40046).
 * `NpCrumbs` prints no JSON-LD: the page emits the BreadcrumbList.
 */
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import NpCrumbs from "../new-pages/NpCrumbs.astro";
import "../new-pages/new-pages.css";
import CaseStudyBrowser from "./CaseStudyBrowser.astro";
import type { CaseStudy } from "../../lib/sanity/types";
import { clientImageAlt } from "../../lib/sanity/image";
import { CASE_STUDIES_PATH, CASE_STUDY_COPY } from "./copy";
import { hasImage, imageSize, resolveImage } from "./image";

interface Props {
  caseStudy: Pick<CaseStudy, "title" | "intro" | "client">;
}

const { caseStudy } = Astro.props;
const { client } = caseStudy;
const crumbs = [
  { label: CASE_STUDY_COPY.breadcrumb.home, href: "/" },
  { label: CASE_STUDY_COPY.breadcrumb.index, href: CASE_STUDIES_PATH },
  { label: caseStudy.title },
];
const intro = caseStudy.intro?.trim();
// Logo 17.6px tall in Figma (3842:40075): fetched at 2x of the 18px line.
const logo = hasImage(client?.logo) ? resolveImage(client?.logo, 18) : null;
const logoDims = imageSize(logo, 18);
const logoAlt = clientImageAlt(client?.logo?.alt, client?.name, "logo");
const clientName = client?.name?.trim();
const hasMedia = hasImage(client?.websiteScreenshot);
---

<header class:list={["c-cs-hero", { "is-text-only": !hasMedia }]}>
  <Container>
    <div class="c-cs-hero__grid">
      <div class="c-cs-hero__text">
        <NpCrumbs items={crumbs} />
        <div class="c-cs-hero__head">
          <div class="c-cs-hero__tags">
            {(logo || clientName) && (
              <Eyebrow class="c-cs-hero__logo">
                {logo ? (
                  <img src={logo.src} alt={logoAlt} width={logoDims.width} height={logoDims.height} loading="eager" decoding="async" />
                ) : (
                  clientName
                )}
              </Eyebrow>
            )}
            <Eyebrow variant="accent">{CASE_STUDY_COPY.tag}</Eyebrow>
          </div>
          <div class="c-cs-hero__titles">
            <h1 class="c-cs-hero__title c-text_xl">{caseStudy.title}</h1>
            {intro && <p class="c-cs-hero__intro c-paragraph_m">{intro}</p>}
          </div>
        </div>
      </div>
      {hasMedia && (
        <div class="c-cs-hero__media">
          <CaseStudyBrowser client={client} />
        </div>
      )}
    </div>
  </Container>
</header>

<style>
  /* Top: Figma's 110px halved to 55px (lead feedback 2026-10-23). Bottom:
     110px (lead 2026-10-22; the facts row follows with no padding of its
     own). The website frame runs off the right edge: clip it there. */
  .c-cs-hero {
    overflow: hidden;
    overflow: clip;
  }
  .c-cs-hero :global(.c-container) {
    padding-top: 3.929rem;
    padding-bottom: 7.857rem;
  }
  /* Accent tag tint at 5% (the blog hero's contrast fix): new-pages.css's
     --np-surface-tint. */
  .c-cs-hero__tags :global(.c-eyebrow.is-accent) {
    background: var(--np-surface-tint);
  }
  /* Figma: text 769 of the 1680 row (45.8%), 50px gap, then the frame.
     `container-type` lets the frame measure the row (100cqw) to reach the
     viewport edge. */
  .c-cs-hero__grid {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 45.774%) minmax(0, 1fr);
    align-items: center;
    gap: 3.571rem;
  }
  .c-cs-hero.is-text-only .c-cs-hero__grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .c-cs-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.786rem; /* 25px */
    min-width: 0;
  }
  .c-cs-hero__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.714rem; /* 24px */
  }
  .c-cs-hero__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.143rem; /* 16px */
  }
  /* Figma logo chip (3842:40074): the default Eyebrow box and squares
     around the logo, one text line tall. */
  .c-cs-hero__tags :global(.c-cs-hero__logo img) {
    display: block;
    width: auto;
    height: 1lh;
    max-width: 10rem;
    object-fit: contain;
  }
  .c-cs-hero__titles {
    display: flex;
    flex-direction: column;
    gap: 0.714rem; /* 10px */
  }
  .c-cs-hero__title {
    margin: 0;
    color: var(--color-black-secondary);
  }
  /* Figma Paragraph M (25px / 1.5), 648px wide. */
  .c-cs-hero__intro {
    max-width: 46.3rem; /* 648px */
    margin: 0;
    color: var(--color-text);
  }
  /* The frame's box: from its column to the viewport's right edge. */
  .c-cs-hero__media {
    width: calc(100% + (100vw - 100cqw) / 2);
    min-width: 0;
  }
  /* Tablet / mobile: one column, the frame under the text, still running
     off the right edge. */
  @media (max-width: 991px) {
    .c-cs-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }
  @media (max-width: 767px) {
    .c-cs-hero :global(.c-container) {
      padding-top: 2.5rem; /* halved with desktop (lead 2026-10-23) */
      padding-bottom: 4.444rem;
    }
  }
</style>
