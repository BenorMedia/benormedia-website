---
/**
 * CaseStudyFacts — c-cs-facts
 * The facts row under the hero (Figma 3842:40102): up to six items spread
 * across the container, each a default `Eyebrow` label ("01 / Client",
 * "02 / Industry", "03 / Services delivered", "04 / Solution",
 * "05 / Timeline", "06 / Stack") over a centred `c-paragraph` value. Lists
 * (services, stack) are joined with " / " as in Figma. An item without a
 * value is left out and the rest renumber; nothing renders when all are
 * empty.
 */
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import type { CaseStudy } from "../../lib/sanity/types";
import { CASE_STUDY_COPY } from "./copy";

interface Props {
  caseStudy: Pick<CaseStudy, "client" | "industry" | "services" | "solution" | "timeline" | "stack">;
}

const { caseStudy } = Astro.props;
const labels = CASE_STUDY_COPY.facts;
const join = (list: readonly (string | null | undefined)[] | null | undefined): string =>
  (list ?? [])
    .map((s) => s?.trim())
    .filter((s): s is string => Boolean(s))
    .join(" / ");
const rows = [
  { label: labels.client, value: caseStudy.client?.name?.trim() ?? "" },
  { label: labels.industry, value: caseStudy.industry?.trim() ?? "" },
  { label: labels.services, value: join((caseStudy.services ?? []).map((s) => s?.name)) },
  { label: labels.solution, value: caseStudy.solution?.trim() ?? "" },
  { label: labels.timeline, value: caseStudy.timeline?.trim() ?? "" },
  { label: labels.stack, value: join(caseStudy.stack) },
]
  .filter((row) => row.value)
  .map((row, i) => ({ ...row, num: String(i + 1).padStart(2, "0") }));
---

{rows.length > 0 && (
  <section class="c-cs-facts" aria-label={CASE_STUDY_COPY.factsLabel}>
    <Container>
      <dl class="c-cs-facts__list">
        {rows.map((row) => (
          <div class="c-cs-facts__item">
            <dt><Eyebrow>{row.num} / {row.label}</Eyebrow></dt>
            <dd class="c-cs-facts__value c-paragraph">{row.value}</dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>
)}

<style>
  /* Figma: 40px above and below, items spread edge to edge. */
  .c-cs-facts :global(.c-container) {
    padding-top: 2.857rem;
    padding-bottom: 2.857rem;
  }
  .c-cs-facts__list {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin: 0;
  }
  /* Label → value 16px, both centred. */
  .c-cs-facts__item {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    align-items: center;
    gap: 1.143rem;
    min-width: 0;
  }
  .c-cs-facts__item dt {
    display: flex;
    justify-content: center;
    white-space: nowrap;
  }
  /* Values wrap (balanced) when the row runs out of room: one line each at
     1440+, as Figma; the fluid root between 992 and 1439 makes the text
     relatively wider than the container (QA round 1). */
  .c-cs-facts__value {
    margin: 0;
    color: var(--color-black-secondary);
    text-align: center;
    text-wrap: balance;
  }
  /* No tablet / mobile design: three, then two items per row. */
  @media (max-width: 991px) {
    .c-cs-facts__list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 2.857rem;
      column-gap: 2rem;
    }
  }
  @media (max-width: 767px) {
    .c-cs-facts :global(.c-container) {
      padding-top: 2.222rem;
      padding-bottom: 2.222rem;
    }
    .c-cs-facts__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.222rem;
    }
  }
</style>
