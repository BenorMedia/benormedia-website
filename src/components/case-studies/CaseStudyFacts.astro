---
/**
 * CaseStudyFacts — c-cs-facts
 * The facts row under the hero (Figma 3842:40102): up to four items, each a
 * default `Eyebrow` label ("Industry", "Services Delivered", "Timeline",
 * "Stack"; no numbers since round 4; Client and Solution removed, lead
 * feedback 2026-10-23, the fields stay in Sanity) centred over a
 * one-line `c-paragraph` value. Lists (services, stack) are joined with
 * " / " as in Figma. An item without a value is left out; nothing renders
 * when all are empty.
 *
 * ≥992: items at their natural width, spread with space-between (Figma:
 * equal 84.6px gaps at 1920), values never wrap. When the six do not fit,
 * whole items wrap and every row is centred with the same gaps
 * (`initRowWrap` sets `is-wrapped`; without JS the rows stay
 * space-between, still without overflow).
 */
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import type { CaseStudy } from "../../lib/sanity/types";
import { CASE_STUDY_COPY } from "./copy";

interface Props {
  caseStudy: Pick<CaseStudy, "industry" | "services" | "timeline" | "stack">;
}

const { caseStudy } = Astro.props;
const labels = CASE_STUDY_COPY.facts;
const clean = (list: readonly (string | null | undefined)[] | null | undefined): string[] =>
  (list ?? []).map((s) => s?.trim()).filter((s): s is string => Boolean(s));
// No-break space before the slash: where a value wraps (≤991), the line
// ends on "/" and the next starts with a word, never with "/".
const join = (list: readonly (string | null | undefined)[] | null | undefined): string =>
  clean(list).join("\u00A0/ ");
// Services: one per line (lead 2026-10-22), so the longest value takes less
// width and the row spreads better; each line but the last ends on " /".
const serviceLines = clean((caseStudy.services ?? []).map((s) => s?.name));
const rows: { label: string; value: string; lines?: string[] }[] = [
  { label: labels.industry, value: caseStudy.industry?.trim() ?? "" },
  { label: labels.services, value: serviceLines.join("\u00A0/ "), lines: serviceLines },
  { label: labels.timeline, value: caseStudy.timeline?.trim() ?? "" },
  { label: labels.stack, value: join(caseStudy.stack) },
]
  .filter((row) => row.value);
---

{rows.length > 0 && (
  <section class="c-cs-facts" aria-label={CASE_STUDY_COPY.factsLabel}>
    <Container>
      <dl class="c-cs-facts__list">
        {rows.map((row) => (
          <div class="c-cs-facts__item">
            <dt><Eyebrow>{row.label}</Eyebrow></dt>
            <dd class="c-cs-facts__value c-paragraph">
              {row.lines && row.lines.length > 1
                ? row.lines.map((line, i, all) => (
                    <span class="c-cs-facts__line">{line}{i < all.length - 1 && "\u00A0/"}</span>
                  ))
                : row.value}
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>
)}

<script>
  import { initRowWrap } from "../../scripts/ui/row-wrap";

  document.querySelectorAll<HTMLElement>(".c-cs-facts__list").forEach((row) => initRowWrap(row));
</script>

<style>
  /* Figma (lead 2026-10-22): no padding above or below; the hero's and
     the quote's 110px make the spacing. Items spread edge to edge. */
  .c-cs-facts :global(.c-container) {
    padding-top: 0;
    padding-bottom: 0;
  }
  /* Natural-width items, space-between: equal gaps on one line (Figma).
     The 2rem gap is the minimum before a whole item wraps (TODO: DS, no
     minimum in Figma, kept from round 1); wrapped rows sit 40px apart. */
  .c-cs-facts__list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.857rem 2rem;
    margin: 0;
  }
  .c-cs-facts__list.is-wrapped {
    justify-content: center;
  }
  /* Label → value 16px, both centred. */
  .c-cs-facts__item {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 1.143rem;
    max-width: 100%;
  }
  .c-cs-facts__item dt {
    display: flex;
    justify-content: center;
    white-space: nowrap;
  }
  /* One line per value (Figma). */
  .c-cs-facts__value {
    margin: 0;
    color: var(--color-black-secondary);
    text-align: center;
    white-space: nowrap;
  }
  .c-cs-facts__line {
    display: block;
  }
  /* No tablet / mobile design: three, then two items per row. */
  @media (max-width: 991px) {
    .c-cs-facts__list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 2.857rem;
      column-gap: 2rem;
    }
    .c-cs-facts__item {
      min-width: 0;
    }
    /* One value per cell; long values wrap inside it (balanced). */
    .c-cs-facts__value {
      white-space: normal;
      text-wrap: balance;
    }
  }
  @media (max-width: 767px) {
    .c-cs-facts__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.222rem;
    }
  }
</style>
