---
/**
 * CaseTeam — team credits (Figma 4225:12689): two columns of cards with
 * the person's photo, name (Brulia), role and an arrow; each card links to
 * the person's author page. Photos: the /about team card photos
 * (`/images/about/team/<slug>.webp`, 396 x 438; Figma has a placeholder
 * photo on every card); names and links from `authors.ts`; roles from the
 * entry.
 * ≤767 (`TODO: DS mobile`): one column.
 */
import { AUTHORS, authorPath } from "../../lib/new-pages/authors";
import type { CsMember } from "../../lib/case-studies/types";
import glow from "../../assets/case-studies/shared/team-glow.svg";
import arrow from "../../assets/case-studies/shared/team-arrow.svg";

interface Props {
  members: readonly CsMember[];
}

const { members } = Astro.props;
const people = members.map((m) => {
  const a = AUTHORS.find((x) => x.slug === m.author);
  if (!a) throw new Error(`CaseTeam: unknown author "${m.author}"`);
  return { ...a, role: m.role };
});
---

<ul class="c-case-team">
  {people.map((p) => (
    <li>
      <a class="c-case-team__card" href={authorPath(p)}>
        <img class="c-case-team__glow" src={glow.src} alt="" width="396" height="448" aria-hidden="true" />
        <img class="c-case-team__photo" src={`/images/about/team/${p.slug}.webp`} alt="" width="396" height="438" loading="lazy" decoding="async" />
        <span class="c-case-team__body">
          <span class="c-text_m c-case-team__name">{p.name}</span>
          <span class="c-paragraph_m c-case-team__role">{p.role}</span>
          <img class="c-case-team__arrow" src={arrow.src} alt="" width="36" height="37" aria-hidden="true" />
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .c-case-team {
    --u: calc(1rem / 19.2);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(16 * var(--u));
    margin: 0;
    padding: calc(24 * var(--u)) 0;
    list-style: none;
  }
  .c-case-team__card {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    overflow: hidden;
    border: var(--border-default);
    border-radius: 4.6px;
    background: var(--color-white);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--duration-hover) var(--ease-smooth);
  }
  .c-case-team__card:hover {
    border-color: var(--color-blue);
  }
  .c-case-team__card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* Figma: 370 px glow centred at +158.9 / -58.6 from the card's middle. */
  .c-case-team__glow {
    position: absolute;
    top: calc(-236.3 * var(--u));
    left: calc(261.5 * var(--u));
    width: calc(395.8 * var(--u));
    height: auto;
    pointer-events: none;
  }
  .c-case-team__photo {
    position: relative;
    flex: none;
    width: calc(180 * var(--u));
    height: auto;
    aspect-ratio: 180 / 168.77;
    object-fit: cover;
    object-position: top;
  }
  .c-case-team__body {
    position: relative;
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: calc(4.64 * var(--u));
    min-width: 0;
    padding: calc(11.6 * var(--u)) calc(64 * var(--u)) calc(11.6 * var(--u)) calc(24 * var(--u));
  }
  .c-case-team__name {
    color: var(--color-black-secondary);
    line-height: 1.5;
  }
  .c-case-team__role {
    color: var(--color-text);
  }
  .c-case-team__arrow {
    position: absolute;
    right: calc(20.26 * var(--u));
    bottom: calc(8.28 * var(--u));
    width: calc(36.28 * var(--u));
    height: auto;
    transition: transform var(--duration-hover) var(--ease-smooth);
  }
  .c-case-team__card:hover .c-case-team__arrow {
    transform: translateX(0.3rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .c-case-team__card,
    .c-case-team__arrow { transition: none; }
  }
  @media (max-width: 767px) {
    .c-case-team { grid-template-columns: minmax(0, 1fr); gap: 1.2rem; }
    .c-case-team__photo { width: 11rem; }
    .c-case-team__body { padding: 1.2rem 4.5rem 1.2rem 1.8rem; }
    .c-case-team__arrow { width: 3rem; right: 1rem; }
  }
</style>
