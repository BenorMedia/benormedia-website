---
/**
 * CaseStudyBody — c-cs-body
 * The case study's Portable Text body (Figma article column 3842:40186):
 * H2 sections (Text L, ids for the table of contents: `caseStudyToc` gives
 * the sidebar the same ids), paragraphs, bold / italic, links, quotes,
 * check-mark bullet lists (the blog body's check circle, `CHECK_MASK`),
 * numbered lists and callout boxes (`NpKeyTakeaways`, which needs
 * `new-pages.css`). From an H3 up to the next H2 the content sits in the
 * narrower phase column (3842:40216). The tree comes from
 * `parseCaseStudyBody` (`src/lib/sanity/case-study-body.ts`); the markup is
 * in `./body/`. Renders nothing when the body is empty.
 */
import CaseStudyNodes from "./body/CaseStudyNodes.astro";
import type { CaseStudyBodyItem } from "../../lib/sanity/types";
import { parseCaseStudyBody } from "../../lib/sanity/case-study-body";
import { CHECK_MASK } from "../new-pages/blog-icons";
import "../new-pages/new-pages.css";

interface Props {
  body: readonly CaseStudyBodyItem[] | null | undefined;
}

const nodes = parseCaseStudyBody(Astro.props.body);
---

{nodes.length > 0 && (
  <div class="c-cs-body" style={`--np-check: ${CHECK_MASK};`}>
    <CaseStudyNodes nodes={nodes} />
  </div>
)}

<style>
  /* Figma: Paragraph 20px #5B6170, line-height 1.5; 24px between blocks,
     48px between sections. Sizes follow the blog body's tokens. */
  .c-cs-body {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--fs-p);
    line-height: 1.5;
  }
  /* Margins reset at zero specificity so the spacing rules below win. */
  :global(:where(.c-cs-body__h2, .c-cs-body__h3, .c-cs-body__p, .c-cs-body__list, .c-cs-body__quote)) {
    margin: 0;
  }
  /* Headings: global so `CaseStudyResults` shares the H2 (QA round 1). */
  :global(.c-cs-body__h2),
  :global(.c-cs-body__h3) {
    color: var(--color-black-secondary);
    font-family: var(--font-heading);
    font-weight: 400;
    scroll-margin-top: calc(var(--c-nav-height, 0px) + 2rem);
  }
  /* Figma Text L 38px. */
  :global(.c-cs-body__h2) {
    font-size: var(--fs-text-l);
    line-height: 1.3;
  }
  /* Figma Text M 30px / 1.5. */
  :global(.c-cs-body__h3) {
    font-size: var(--fs-text-m);
    line-height: 1.5;
  }
  /* 24px between blocks. */
  .c-cs-body > :global(* + *),
  .c-cs-body :global(.c-cs-body__phase > * + *) {
    margin-top: 1.714rem;
  }
  /* 48px before each section and before the phase column (Figma 3842:40186
     "Content section" gaps); 24px under an H2. */
  .c-cs-body > :global(* + .c-cs-body__h2),
  .c-cs-body > :global(* + .c-cs-body__phase) {
    margin-top: 3.429rem;
  }
  .c-cs-body > :global(.c-cs-body__h2 + *) {
    margin-top: 1.714rem;
  }
  /* 40px between phases. */
  .c-cs-body :global(.c-cs-body__phase > * + .c-cs-body__h3) {
    margin-top: 2.857rem;
  }
  /* Phase column: 858px of the 1220px article (Figma 3842:40216), no rule
     (removed in 3842:40046). */
  .c-cs-body :global(.c-cs-body__phase > *) {
    max-width: 70.33%;
  }
  /* Figma: Acumin Pro Medium 500 20px #212427 (lead 2026-10-22). */
  .c-cs-body :global(strong) {
    color: var(--color-black-secondary);
    font-weight: 500;
  }
  .c-cs-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .c-cs-body :global(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Quote, variant B (lead feedback 2026-10-23, "improve the quotes"; the
     Figma 3842:40194 panel with the gradient bar is variant A): editorial
     pull quote between two 0.5px rules, each rule end marked with the
     Eyebrow's square (the site's marker motif), a gradient quote mark,
     centred Text M in the heading colour. TODO: DS (no Figma). */
  .c-cs-body :global(.c-cs-body__quote) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.714rem;
    margin-inline: 0;
    padding: 2.857rem 4.286rem;
    border-block: 0.5px solid var(--color-gray);
    color: var(--color-heading);
    line-height: 1.4;
    text-align: center;
  }
  .c-cs-body > :global(.c-cs-body__quote),
  .c-cs-body > :global(.c-cs-body__quote + *),
  .c-cs-body :global(.c-cs-body__phase > .c-cs-body__quote),
  .c-cs-body :global(.c-cs-body__phase > .c-cs-body__quote + *) {
    margin-top: 2.857rem;
  }
  /* Rule-end squares: the Eyebrow's (0.625rem, white, 0.5px gray, 1.5px
     radius), two on the top rule (::before / ::after), two on the bottom
     one (the paragraph's, placed against the blockquote). */
  .c-cs-body :global(.c-cs-body__quote)::before,
  .c-cs-body :global(.c-cs-body__quote)::after,
  .c-cs-body :global(.c-cs-body__quote p)::before,
  .c-cs-body :global(.c-cs-body__quote p)::after {
    content: "";
    position: absolute;
    width: 0.625rem;
    height: 0.625rem;
    border: 0.5px solid var(--color-gray);
    border-radius: 1.5px;
    background: var(--color-white);
  }
  .c-cs-body :global(.c-cs-body__quote)::before,
  .c-cs-body :global(.c-cs-body__quote)::after {
    top: 0;
    translate: 0 -50%;
  }
  .c-cs-body :global(.c-cs-body__quote p)::before,
  .c-cs-body :global(.c-cs-body__quote p)::after {
    bottom: 0;
    translate: 0 50%;
  }
  .c-cs-body :global(.c-cs-body__quote)::before,
  .c-cs-body :global(.c-cs-body__quote p)::before {
    left: 0;
  }
  .c-cs-body :global(.c-cs-body__quote)::after,
  .c-cs-body :global(.c-cs-body__quote p)::after {
    right: 0;
  }
  .c-cs-body :global(.c-cs-body__quote-mark) {
    display: block;
    width: 3.429rem;
    height: auto;
  }
  .c-cs-body :global(.c-cs-body__quote p) {
    max-width: 52rem;
    margin: 0;
    text-wrap: balance;
  }

  /* Lists: Figma 3842:40198. Top-level bullet lists get the blog body's
     check-circle bullets from `.c-np-prose.is-blog` (`CaseStudyList`
     wrapper, QA round 1); numbered and nested lists keep these rules. */
  .c-cs-body :global(ol.c-cs-body__list),
  .c-cs-body :global(.c-cs-body__list .c-cs-body__list) {
    padding-left: 2.143rem;
  }
  .c-cs-body :global(ol.c-cs-body__list) {
    list-style: decimal;
  }
  .c-cs-body :global(.c-cs-body__list .c-cs-body__list) {
    margin-top: 0.714rem;
    list-style: disc;
  }
  .c-cs-body :global(ol.c-cs-body__list > li + li),
  .c-cs-body :global(.c-cs-body__list .c-cs-body__list > li + li) {
    margin-top: 0.714rem;
  }

  /* Callout box: `NpKeyTakeaways` (Figma 3842:40220 matches its box, label
     and square bullets). Its items take the article's paragraph size here
     (the blog's prose is `--fs-p-m`; Figma 18.2px next to 20px body text). */
  .c-cs-body :global(.c-cs-body__callout .c-np-prose) {
    font-size: var(--fs-p);
    line-height: 1.5;
  }

  /* Framed image (lead 2026-10-23, "less flat"): the site's article figure
     frame (`.c-np-article__figure .c-np-visual`: gray-light border; radius
     8px like the rest of this page) filled with the blog thumbnails' 8% accent tint, the image
     inset like a product shot with the cards' hover shadow. TODO: DS (no
     Figma for this block). */
  .c-cs-body :global(.c-cs-body__figure) {
    margin: 0;
  }
  /* Same rhythm as the quote: 40px above and below. */
  .c-cs-body > :global(.c-cs-body__figure),
  .c-cs-body > :global(.c-cs-body__figure + *),
  .c-cs-body :global(.c-cs-body__phase > .c-cs-body__figure),
  .c-cs-body :global(.c-cs-body__phase > .c-cs-body__figure + *) {
    margin-top: 2.857rem;
  }
  .c-cs-body :global(.c-cs-body__figure-frame) {
    padding: 3.429rem 3.429rem 0;
    overflow: hidden;
    border: 1px solid var(--color-gray-light);
    border-radius: 8px; /* the page's radius: browser window, cards (lead 2026-10-23) */
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-white));
  }
  .c-cs-body :global(.c-cs-body__figure-frame img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-default);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-black-secondary) 20%, transparent);
  }
  .c-cs-body :global(.c-cs-body__figure-caption) {
    margin-top: 1.143rem;
    color: var(--color-text);
    text-align: center;
  }

  @media (max-width: 767px) {
    .c-cs-body :global(.c-cs-body__figure-frame) {
      padding: 2.222rem 2.222rem 0;
    }
    /* Mobile: phase text full width (lead 2026-10-21, round 4). */
    .c-cs-body :global(.c-cs-body__phase > *) {
      max-width: none;
    }
    .c-cs-body :global(.c-cs-body__quote) {
      padding: 2.222rem 1.111rem; /* variant B: rules stay full width */
    }
  }
</style>
