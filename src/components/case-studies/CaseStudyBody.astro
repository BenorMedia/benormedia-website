---
/**
 * CaseStudyBody — c-cs-body
 * The case study's Portable Text body (Figma article column 3768:26274):
 * H2 sections (Text L, ids for the table of contents: `caseStudyToc` gives
 * the sidebar the same ids), paragraphs, bold / italic, links, bullet and
 * numbered lists. From an H3 up to the next H2 the content sits in the
 * phase block with the left rule (3768:26281). The tree comes from
 * `parseCaseStudyBody` (`src/lib/sanity/case-study-body.ts`); the markup is
 * in `./body/`. Renders nothing when the body is empty.
 */
import CaseStudyNodes from "./body/CaseStudyNodes.astro";
import type { CaseStudyBodyBlock } from "../../lib/sanity/types";
import { parseCaseStudyBody } from "../../lib/sanity/case-study-body";

interface Props {
  body: readonly CaseStudyBodyBlock[] | null | undefined;
}

const nodes = parseCaseStudyBody(Astro.props.body);
---

{nodes.length > 0 && (
  <div class="c-cs-body">
    <CaseStudyNodes nodes={nodes} />
  </div>
)}

<style>
  /* Figma: Paragraph 20px #5B6170, line-height 1.5; 24px between blocks,
     80px between sections. Sizes follow the blog body's tokens. */
  .c-cs-body {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--fs-p);
    line-height: 1.5;
  }
  /* Margins reset at zero specificity so the spacing rules below win. */
  :global(:where(.c-cs-body__h2, .c-cs-body__h3, .c-cs-body__p, .c-cs-body__list)) {
    margin: 0;
  }
  .c-cs-body :global(.c-cs-body__h2),
  .c-cs-body :global(.c-cs-body__h3) {
    color: var(--color-black-secondary);
    font-family: var(--font-heading);
    font-weight: 400;
    scroll-margin-top: calc(var(--c-nav-height, 0px) + 2rem);
  }
  /* Figma Text L 38px. */
  .c-cs-body :global(.c-cs-body__h2) {
    font-size: var(--fs-text-l);
    line-height: 1.3;
  }
  /* Figma Text M 30px. */
  .c-cs-body :global(.c-cs-body__h3) {
    font-size: var(--fs-text-m);
    line-height: 1.5;
  }
  /* 24px between blocks. */
  .c-cs-body > :global(* + *),
  .c-cs-body :global(.c-cs-body__phase > * + *) {
    margin-top: 1.714rem;
  }
  /* 80px before each section and before the phase block; 24px under an H2. */
  .c-cs-body > :global(* + .c-cs-body__h2),
  .c-cs-body > :global(* + .c-cs-body__phase) {
    margin-top: 5.714rem;
  }
  .c-cs-body > :global(.c-cs-body__h2 + *) {
    margin-top: 1.714rem;
  }
  /* 40px between phases. */
  .c-cs-body :global(.c-cs-body__phase > * + .c-cs-body__h3) {
    margin-top: 2.857rem;
  }
  /* Phase block: 40px left padding, the rule from 22px down (Figma 976px
     line in a 1084px block; here to the block's end). */
  .c-cs-body :global(.c-cs-body__phase) {
    position: relative;
    padding-left: 2.857rem;
  }
  /* Phase text 858px of the 1180px next to the rule (Figma), as a share. */
  .c-cs-body :global(.c-cs-body__phase > *) {
    max-width: 72.7%;
  }
  .c-cs-body :global(.c-cs-body__phase)::before {
    content: "";
    position: absolute;
    top: 1.571rem;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--color-border);
  }
  /* Figma: Poppins SemiBold 20px #212427 (no Poppins in the DS: body font at
     600, TODO: DS). */
  .c-cs-body :global(strong) {
    color: var(--color-black-secondary);
    font-weight: 600;
  }
  .c-cs-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .c-cs-body :global(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  /* Figma: disc bullets, 30px indent. */
  .c-cs-body :global(.c-cs-body__list) {
    padding-left: 2.143rem;
  }
  .c-cs-body :global(ul.c-cs-body__list) {
    list-style: disc;
  }
  .c-cs-body :global(ol.c-cs-body__list) {
    list-style: decimal;
  }
  .c-cs-body :global(.c-cs-body__list .c-cs-body__list) {
    margin-top: 0;
  }
  @media (max-width: 767px) {
    .c-cs-body > :global(* + .c-cs-body__h2),
    .c-cs-body > :global(* + .c-cs-body__phase) {
      margin-top: 4.444rem;
    }
    .c-cs-body > :global(.c-cs-body__h2 + *) {
      margin-top: 1.714rem;
    }
    .c-cs-body :global(.c-cs-body__phase) {
      padding-left: 1.778rem;
    }
    /* Mobile: phase text full width (lead 2026-10-21, round 4). */
    .c-cs-body :global(.c-cs-body__phase > *) {
      max-width: none;
    }
  }
</style>
