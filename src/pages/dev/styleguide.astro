---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Tag from "../../components/ui/Tag.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import SegmentedControl from "../../components/ui/SegmentedControl.astro";
import FaqAccordion from "../../components/ui/FaqAccordion.astro";
import PricingCard from "../../components/ui/PricingCard.astro";
import CtaBanner from "../../components/layout/CtaBanner.astro";
import type { SiteSettings } from "../../lib/sanity/types";

// Mock siteSettings shape used only to preview the CTA banner on the styleguide.
// The banner reads `.ctaBanner` — everything else is unused by this preview.
const demoSiteSettings = {
  _id: "styleguide-demo",
  _type: "siteSettings",
  siteName: "BenorMedia",
  siteUrl: "https://example.com",
  ctaBanner: {
    title: "Ready to build your website? Let's chat.",
    buttons: [
      {
        variant: "white",
        link: { label: "Get in Touch", type: "contact" },
      },
      {
        variant: "glass",
        link: { label: "See Pricing", type: "internal" },
      },
    ],
    socialProofText: "Trusted by +100 companies",
  },
} satisfies Partial<SiteSettings> as unknown as SiteSettings;

// Full color token inventory — must stay in sync with DESIGN_SYSTEM §4.
const colors = [
  { name: "White",             hex: "#FFFFFF", var: "--color-white" },
  { name: "Text",              hex: "#5B6170", var: "--color-text" },
  { name: "Heading",           hex: "#12142B", var: "--color-heading" },
  { name: "Black secondary",   hex: "#212427", var: "--color-black-secondary" },
  { name: "Text secondary",    hex: "#4F4F4F", var: "--color-text-secondary" },
  { name: "Accent",            hex: "#3467E5", var: "--color-accent" },
  { name: "Blue",              hex: "#6275F6", var: "--color-blue" },
  { name: "Blue light",        hex: "#6BB0F7", var: "--color-blue-light" },
  { name: "Gray",              hex: "#C9CEDA", var: "--color-gray" },
  { name: "Gray light",        hex: "#F0F0F0", var: "--color-gray-light" },
  { name: "Border",            hex: "#E4E6EA", var: "--color-border" },
];

const textClasses = [
  "c-text_xxl",
  "c-text_xl",
  "c-text_l",
  "c-text_m",
  "c-text",
  "c-text_s",
  "c-text_xs",
];

const paragraphClasses = [
  "c-paragraph_xl",
  "c-paragraph_l",
  "c-paragraph_m",
  "c-paragraph",
  "c-paragraph_s",
];

const pangram = "The quick brown fox jumps over the lazy dog";

const buttonVariants = ["gradient", "gradient-outline", "white", "glass"] as const;

// Phase 5 primitives — sample data only (copy from the refs, not final).
const workFilters = [
  { label: "View All", value: "all" },
  { label: "Professional Services", value: "professional-services" },
  { label: "SaaS / B2B Tech", value: "saas" },
  { label: "Agency", value: "agency" },
];

const faqTabs = [
  { label: "Web Design And Development", value: "web", controls: "sg-faq-web" },
  { label: "Answer Engine Optimization (AEO)", value: "aeo", controls: "sg-faq-aeo" },
];

const loremAnswer =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in.";

const faqWeb = [
  { question: "Are requests really unlimited?", answer: loremAnswer },
  { question: "How many months will I need?", answer: loremAnswer },
  { question: "How does the turnaround time work?", answer: loremAnswer },
  { question: "What if I'm still unhappy with the work at the end?", answer: loremAnswer },
  { question: "How will I communicate with you?", answer: loremAnswer },
];

const faqAeo = [
  { question: "TODO: COPY — AEO question", answer: "TODO: COPY — AEO answer." },
];

const plans = [
  {
    name: "Design + Development",
    description:
      "Unlimited marketing design, web design, and web development support for growing B2B companies.",
    price: "€2,000",
    period: "/mo",
    features: [
      "Unlimited development requests",
      "Unlimited web and marketing design requests",
      "Unlimited revisions",
      "Unlimited projects",
      "Fast turnaround",
      "Updates via our dashboard, Slack or Email",
      "Dedicated client manager",
      "Cancel anytime",
    ],
  },
  {
    name: "Growth (SEO/GEO + CRO)",
    description:
      "Technical AEO, AI search analytics, content creation, and ongoing optimization to improve your LLMs visibility and web conversion rate.",
    price: "€2,500",
    period: "/mo",
    features: [
      "Content creation",
      "AI Search Analytics",
      "AI Visibility Reporting",
      "Competitive Intelligence",
      "Technical Optimization",
      "Conversion Rate Experiments",
      "Content Opportunity Analysis",
      "Behavior Analysis",
      "Cancel anytime",
    ],
  },
  {
    name: "One Off",
    description:
      "A fixed-scope engagement for businesses that need expert design or development without a retainer.",
    priceLabel: "Let's chat",
    features: [
      "Webflow development",
      "Conversion-focused designs",
      "Scalable development system",
      "Scalable design system",
      "Custom illustrations",
      "Technical SEO optimization",
      "Tutorials and Training",
      "Dedicated client manager",
      "Multiple reviews",
    ],
  },
];
---

<BaseLayout title="Style guide" noindex={true}>
  <Container>
    <header class="sg-header">
      <p class="c-text_xs sg-kicker">/dev/styleguide</p>
      <h1 class="c-text_xl">BenorMedia — Design System</h1>
      <p class="c-paragraph sg-lead">
        Every token, text class, button variant and primitive rendered from the
        global CSS. Source of truth: <code>docs/DESIGN_SYSTEM.md</code>.
      </p>
    </header>

    <!-- ================================================================== -->
    <!-- 1. Colors                                                          -->
    <!-- ================================================================== -->
    <section class="sg-section">
      <h2 class="c-text_l">1. Colors</h2>
      <div class="sg-swatches">
        {colors.map((c) => (
          <div class="sg-swatch">
            <div class="sg-swatch__chip" style={`background-color: ${c.hex};`}></div>
            <div class="sg-swatch__meta">
              <p class="c-paragraph_s sg-swatch__name">{c.name}</p>
              <p class="c-paragraph_s sg-mono">{c.hex}</p>
              <p class="c-paragraph_s sg-mono sg-muted">{c.var}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="sg-gradient-bar" aria-label="Primary gradient">
        <p class="c-paragraph_s sg-mono sg-on-dark">--gradient-primary</p>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- 2. Typography                                                      -->
    <!-- ================================================================== -->
    <section class="sg-section">
      <h2 class="c-text_l">2. Typography</h2>

      <h3 class="c-text_m sg-subhead">Heading scale (c-text_*)</h3>
      <div class="sg-type-stack">
        {textClasses.map((cls) => (
          <div class="sg-type-row">
            <p class="c-paragraph_s sg-mono sg-muted">.{cls}</p>
            <p class={cls}>{pangram}</p>
          </div>
        ))}
      </div>

      <h3 class="c-text_m sg-subhead">Paragraph scale (c-paragraph_*)</h3>
      <div class="sg-type-stack">
        {paragraphClasses.map((cls) => (
          <div class="sg-type-row">
            <p class="c-paragraph_s sg-mono sg-muted">.{cls}</p>
            <p class={cls}>{pangram}</p>
          </div>
        ))}
      </div>

      <h3 class="c-text_m sg-subhead">Button text class (c-button)</h3>
      <div class="sg-type-row">
        <p class="c-paragraph_s sg-mono sg-muted">.c-button</p>
        <p class="c-button" style="color: var(--color-heading);">{pangram}</p>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- 3. Buttons                                                         -->
    <!-- ================================================================== -->
    <section class="sg-section">
      <h2 class="c-text_l">3. Buttons</h2>

      <h3 class="c-text_m sg-subhead">On white background</h3>
      <div class="sg-btn-panel sg-btn-panel--light">
        {buttonVariants.map((v) => (
          <Button variant={v} href="#">is-{v}</Button>
        ))}
        <Button variant="gradient" type="button">is-gradient (button)</Button>
      </div>

      <h3 class="c-text_m sg-subhead">On dark gradient background</h3>
      <div class="sg-btn-panel sg-btn-panel--dark">
        {buttonVariants.map((v) => (
          <Button variant={v} href="#">is-{v}</Button>
        ))}
        <Button variant="glass" type="button">is-glass (button)</Button>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- 4. Primitives                                                      -->
    <!-- ================================================================== -->
    <section class="sg-section">
      <h2 class="c-text_l">4. Primitives</h2>

      <h3 class="c-text_m sg-subhead">Eyebrow — default (is-default)</h3>
      <p class="c-paragraph_s sg-muted">
        Two decorative squares hug the outer edges. Border, text and squares share <code>--color-gray</code>.
      </p>
      <div class="sg-inline-row">
        <Eyebrow>Trusted by 100+ B2B teams</Eyebrow>
        <Eyebrow>Case studies</Eyebrow>
        <Eyebrow>Services</Eyebrow>
      </div>

      <h3 class="c-text_m sg-subhead">Eyebrow — accent (is-accent)</h3>
      <p class="c-paragraph_s sg-muted">
        No squares. Accent border, tinted accent background (8%), weight 600.
      </p>
      <div class="sg-inline-row">
        <Eyebrow variant="accent">New</Eyebrow>
        <Eyebrow variant="accent">Featured</Eyebrow>
        <Eyebrow variant="accent">Case studies</Eyebrow>
      </div>

      <h3 class="c-text_m sg-subhead">Tag</h3>
      <div class="sg-inline-row">
        <Tag>SaaS</Tag>
        <Tag>Sales tech</Tag>
        <Tag>Fintech</Tag>
      </div>

      <h3 class="c-text_m sg-subhead">Container</h3>
      <p class="c-paragraph_s sg-muted">
        Max-width 1440px, centered, padding 5rem 7.5rem desktop / 5rem 2rem mobile
        (5rem vertical is a placeholder — see TODO).
      </p>
      <div class="sg-container-outer">
        <Container>
          <div class="sg-container-inner">
            <p class="c-paragraph">.c-container content area</p>
          </div>
        </Container>
      </div>
    </section>
  </Container>

  <!-- ================================================================== -->
  <!-- 5. Layout components                                               -->
  <!-- ================================================================== -->
  <Container>
    <section class="sg-section">
      <h2 class="c-text_l">5. Layout components</h2>
      <p class="c-paragraph_s sg-muted">
        <strong>Nav</strong> is rendered at the top of this page and <strong>Footer</strong>
        at the bottom (both from <code>BaseLayout</code>). Below: <strong>CTA banner</strong>
        with mock content, and a trigger for the <strong>contact modal</strong>.
      </p>

      <h3 class="c-text_m sg-subhead">CTA banner (with mock content)</h3>
      <p class="c-paragraph_s sg-muted">
        Reads content from <code>siteSettings.ctaBanner</code>. Hides itself entirely when
        <code>title</code> is missing. Demo below uses a hardcoded mock.
      </p>
    </section>
  </Container>
  <CtaBanner siteSettings={demoSiteSettings} />
  <Container>
    <section class="sg-section">
      <h3 class="c-text_m sg-subhead">Contact modal</h3>
      <p class="c-paragraph_s sg-muted">
        Modal is mounted once by <code>BaseLayout</code>. Any element with
        <code>[data-open-contact]</code> or <code>.js-open-contact</code> opens it.
      </p>
      <div class="sg-inline-row">
        <Button variant="gradient" class="js-open-contact">Open contact modal</Button>
      </div>
    </section>
  </Container>
  <!-- ================================================================== -->
  <!-- 6. Phase 5 primitives                                              -->
  <!-- ================================================================== -->
  <Container>
    <section class="sg-section">
      <h2 class="c-text_l">6. Phase 5 primitives</h2>

      <h3 class="c-text_m sg-subhead">SectionHeader — accent</h3>
      <p class="c-paragraph_s sg-muted">
        <code>accent</code> wraps a substring of <code>title</code> in
        <code>.c-section-header__accent</code> (gradient text). Whitespace in the accent
        matches a forced line break in the title.
      </p>
      <div class="sg-stack">
        <SectionHeader
          eyebrow="Pricing"
          title={"Simple and transparent\npricing that meets your needs."}
          accent="that meets your needs."
          as="h3"
          titleClass="c-text_xxl"
        />
        <SectionHeader
          title={"Where marketing\nambition meets creative."}
          accent="marketing ambition"
          description="Accent crossing a forced line break."
          as="h3"
        />
      </div>

      <h3 class="c-text_m sg-subhead">SegmentedControl — toggle (Work filters, squares)</h3>
      <p class="c-paragraph_s sg-muted">
        <code>role="group"</code> + <code>aria-pressed</code> buttons. The caller wires the
        behavior (styleguide demo script below).
      </p>
      <div class="sg-center" data-sg-toggle>
        <SegmentedControl items={workFilters} label="Filter projects by industry" squares />
      </div>

      <h3 class="c-text_m sg-subhead">SegmentedControl — tabs (FAQ) + FaqAccordion</h3>
      <p class="c-paragraph_s sg-muted">
        <code>role="tablist"</code>; behavior from <code>initTabs()</code>
        (<code>src/scripts/ui/tabs.ts</code>): click, Left/Right/Home/End, roving tabindex.
        Without JS the tablist stays <code>hidden</code> (no dead tabs) and both panels stay
        visible; <code>initTabs()</code> reveals the tabs. Accordion = native <code>&lt;details name&gt;</code>.
      </p>
      <div class="sg-faq" data-sg-tabs>
        <SegmentedControl items={faqTabs} label="FAQ topics" mode="tabs" />
        <div id="sg-faq-web" class="sg-faq__panel">
          <FaqAccordion items={faqWeb} name="sg-faq-web" />
        </div>
        <div id="sg-faq-aeo" class="sg-faq__panel">
          <FaqAccordion items={faqAeo} name="sg-faq-aeo" openFirst />
        </div>
      </div>

      <h3 class="c-text_m sg-subhead">PricingCard</h3>
      <p class="c-paragraph_s sg-muted">
        Subgrid card: place cards directly in a grid parent so prices and buttons align.
        Buttons carry <code>.js-open-contact</code>.
      </p>
      <div class="sg-pricing">
        {plans.map((plan) => <PricingCard {...plan} />)}
      </div>
    </section>
  </Container>
</BaseLayout>

<script>
  // Styleguide-only wiring for the Phase 5 demos.
  import { initTabs } from "../../scripts/ui/tabs";

  document.querySelectorAll<HTMLElement>("[data-sg-tabs]").forEach((el) => initTabs(el));

  document.querySelectorAll<HTMLElement>("[data-sg-toggle]").forEach((group) => {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>("button[aria-pressed]"));
    group.addEventListener("click", (event) => {
      const pressed = (event.target as Element | null)?.closest<HTMLButtonElement>(
        "button[aria-pressed]",
      );
      if (!pressed) return;
      for (const b of buttons) {
        const on = b === pressed;
        b.setAttribute("aria-pressed", String(on));
        b.classList.toggle("is-active", on);
      }
    });
  });
</script>

<style>
  /* Styleguide-only styles. Not part of the DS. */

  .sg-header {
    margin-bottom: 4rem;
  }
  .sg-kicker {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .sg-lead {
    margin-top: 1rem;
    max-width: 60ch;
  }

  .sg-section {
    padding: 4rem 0;
    border-top: var(--border-default);
  }

  .sg-subhead {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }

  /* Colors */
  .sg-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .sg-swatch {
    border: var(--border-default);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-white);
  }
  .sg-swatch__chip {
    height: 6rem;
    border-bottom: var(--border-default);
  }
  .sg-swatch__meta {
    padding: 0.75rem 1rem;
  }
  .sg-swatch__name {
    color: var(--color-heading);
    margin-bottom: 0.25rem;
  }
  .sg-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .sg-muted {
    color: var(--color-text-secondary);
    opacity: 0.85;
  }
  .sg-on-dark {
    color: var(--color-white);
  }

  .sg-gradient-bar {
    margin-top: 2rem;
    height: 6rem;
    border-radius: 6px;
    background: var(--gradient-primary);
    display: flex;
    align-items: flex-end;
    padding: 1rem 1.25rem;
  }

  /* Typography */
  .sg-type-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1rem;
  }
  .sg-type-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: var(--border-default);
  }
  .sg-type-row:last-child {
    border-bottom: 0;
  }

  /* Buttons */
  .sg-btn-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 2rem;
    border-radius: 6px;
    margin-top: 1rem;
  }
  .sg-btn-panel--light {
    background: var(--color-white);
    border: var(--border-default);
  }
  .sg-btn-panel--dark {
    background: var(--gradient-primary);
  }

  /* Primitives */
  .sg-inline-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .sg-container-outer {
    margin-top: 1.5rem;
    background: var(--color-gray-light);
    border-radius: 6px;
    /* Reset the outer padding so we can see .c-container's own edges */
  }
  .sg-container-inner {
    outline: 1px dashed var(--color-gray);
    outline-offset: -1px;
    padding: 2rem;
    background: var(--color-white);
    border-radius: 3px;
  }

  /* Phase 5 primitives */
  .sg-stack {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 1.5rem;
  }
  .sg-center {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .sg-faq {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.5rem;
    margin-top: 1.5rem;
  }
  .sg-faq__panel {
    width: 100%;
  }
  .sg-pricing {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.071rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 991px) {
    .sg-pricing {
      grid-template-columns: 1fr;
    }
  }
</style>
