---
/**
 * Case study template — one static page per published Sanity `caseStudy`
 * (`/case-studies/<slug>`, SCHEMAS.md v0.10, DECISIONS → Case studies).
 * Drafts never build: the queries return published documents only.
 *
 * Body: the shared `CaseStudyPage` (also used by `/dev/case-study`); CTA
 * banner + footer from BaseLayout.
 *
 * SEO: `caseStudy.seo` wins in `Seo` (metaTitle, metaDescription, ogImage,
 * noIndex, canonicalUrl); fallbacks passed here are title = the case study
 * title, description = the intro (≤160 characters), else a factual line
 * built from the data ("{title}. Case study: {client}. {challenge}",
 * ≤160 characters, QA nit 12) instead of the site-wide default. OG image
 * falls back to the site default like every other page (a client logo
 * would be cropped to 1200×630). Canonical = `/case-studies/<slug>` (Seo's
 * default).
 *
 * JSON-LD: Article (author and publisher = the shared Organization, `about`
 * = the client, `dateModified` = the date of `_updatedAt`, never before
 * `publishedAt`; `image` = the SEO OG image, else the client logo, else
 * none) + BreadcrumbList (Home › Case studies › title), emitted here
 * because `NpCrumbs` prints none. No offers.
 *
 * Placeholder guard (`guardCaseStudyCopy`, lead 2026-10-21): a production
 * build STOPS when a published case study would show placeholder labels
 * from code (breadcrumb, related section heading); other builds warn.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../../components/layout/JsonLd.astro";
import CaseStudyPage from "../../components/case-studies/CaseStudyPage.astro";
import { getCaseStudyBySlug, getCaseStudySlugs } from "../../lib/sanity/queries";
import type { CaseStudy } from "../../lib/sanity/types";
import { caseStudyJsonLd } from "../../lib/new-pages/jsonld";
import { CASE_STUDIES_PATH, CASE_STUDY_COPY, caseStudyHref } from "../../components/case-studies/copy";
import { caseStudyResources } from "../../lib/sanity/case-studies";
import { detailCopyFields, guardCaseStudyCopy, isProductionBuild } from "../../lib/sanity/case-study-release";
import { isSvgAsset, urlFor } from "../../lib/sanity/image";

export async function getStaticPaths() {
  const slugs = await getCaseStudySlugs();
  const caseStudies = (await Promise.all(slugs.map((slug) => getCaseStudyBySlug(slug)))).filter(
    (cs): cs is CaseStudy => cs !== null,
  );
  const production = isProductionBuild();
  for (const caseStudy of caseStudies) {
    guardCaseStudyCopy(caseStudyHref(caseStudy.slug), detailCopyFields(caseStudyResources(caseStudy).length > 0), production);
  }
  return caseStudies.map((caseStudy) => ({ params: { slug: caseStudy.slug }, props: { caseStudy } }));
}

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;

// Same clamp as the service template's description fallback.
function clamp(text: string, max = 160): string {
  const clean = text.replace(/\s+/g, " ").trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max - 1);
  return `${cut.slice(0, cut.lastIndexOf(" ")).replace(/[\s,;:.]+$/, "")}…`;
}

// No intro and no SEO description: a factual line from the data, not the
// site-wide default (QA nit 12). TODO: COPY: wording of the template.
function fallbackDescription(cs: CaseStudy): string {
  const sentence = (text: string) => text.replace(/[\s.]+$/, "") + ".";
  const client = cs.client?.name?.trim();
  const challenge = cs.challenge?.trim();
  const parts = [sentence(cs.title), client ? `Case study: ${sentence(client)}` : "Case study."];
  if (challenge) parts.push(challenge);
  return clamp(parts.join(" "));
}

const intro = caseStudy.intro?.trim();
const metaDescription =
  caseStudy.seo?.metaDescription?.trim() || (intro ? clamp(intro) : fallbackDescription(caseStudy));
const layoutOptional = { description: metaDescription };

// Article `dateModified`: the date part of `_updatedAt` (blog Articles use
// `YYYY-MM-DD` too), never earlier than `publishedAt` (an editor's date).
const updated = caseStudy._updatedAt?.slice(0, 10);
const dateModified = updated && updated > caseStudy.publishedAt ? updated : caseStudy.publishedAt;

// Article `image`: the SEO OG image (same 1200×630 crop as `Seo`), else the
// client logo (raw SVG, or a 1200px-wide raster), else none. Sanity CDN URLs
// are absolute.
const ogImage = caseStudy.seo?.ogImage;
const logo = caseStudy.client?.logo;
const articleImage = ogImage?.asset
  ? urlFor(ogImage).width(1200).height(630).fit("crop").url()
  : logo?.asset
    ? isSvgAsset(logo.asset._id ?? logo.asset._ref) ? urlFor(logo).url() : urlFor(logo).width(1200).url()
    : undefined;

const path = caseStudyHref(caseStudy.slug);
const jsonLd = caseStudyJsonLd({
  url: path,
  headline: caseStudy.title,
  description: metaDescription,
  datePublished: caseStudy.publishedAt,
  dateModified,
  image: articleImage,
  client: caseStudy.client,
  crumbs: [
    { name: CASE_STUDY_COPY.breadcrumb.home, url: "/" },
    { name: CASE_STUDY_COPY.breadcrumb.index, url: CASE_STUDIES_PATH },
    { name: caseStudy.title, url: path },
  ],
});
---

<BaseLayout pageSeo={caseStudy.seo ?? null} title={caseStudy.title} {...layoutOptional}>
  {jsonLd.map((data) => <JsonLd data={data} />)}
  <CaseStudyPage caseStudy={caseStudy} />
</BaseLayout>
