---
/**
 * Case studies index — `/case-studies` (Figma 3790:36365, DECISIONS → Case
 * studies). `CaseStudiesIndexHero` (rings + client icon tiles from
 * `getClientsWithIconByRank`, lead 2026-10-22) + every published case study (`CaseStudyListing`,
 * newest first, no pagination or filters). CTA banner + footer from
 * BaseLayout. SEO lives in code (`PAGE_META.caseStudies`, like `/work`).
 *
 * A rest route, not `index.astro`, because a fixed page can't be left out of
 * a build (same pattern as `/dev/case-study`). `getStaticPaths` only ever
 * returns `index: undefined`, i.e. `/case-studies` itself, so it never
 * competes with `[slug].astro` for `/case-studies/<slug>` (a named param
 * outranks a rest param in Astro's routing anyway).
 *
 * While no case study is published (lead 2026-10-20, 2026-10-21):
 *   - production builds (`isProductionBuild`: VERCEL_ENV=production or
 *     PUBLIC_SITE_ENV=production) don't emit the page at all;
 *   - other builds (dev, Vercel previews) emit it, noindex, hero only.
 * Once one is published, every build emits it, indexable. Nobody flips a
 * switch: the Sanity publish webhook triggers the rebuild.
 *   - sitemap: `astro.config.mjs` reads the published case studies at build
 *     time (`src/lib/sanity/case-study-sitemap.mjs`) and lists this path
 *     only when at least one of them is indexable.
 *   - placeholder guard (`guardCaseStudyCopy`): with a case study published,
 *     a production build STOPS if the hero or meta copy below is still
 *     "Lorem ipsum" / "TODO: COPY"; other builds warn.
 *
 * JSON-LD: CollectionPage (ItemList of the case studies) + BreadcrumbList,
 * as on /blog (`caseStudiesIndexJsonLd`, lead 2026-10-21).
 *
 * Empty state (no design, non-production only): the hero only;
 * `CaseStudyListing` renders nothing without cards, so there is no empty
 * grid and no "no results" copy. The empty hero (`empty`) adds the
 * listing's own top padding to keep the same gap above the CTA banner.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudiesIndexHero from "../../components/case-studies/CaseStudiesIndexHero.astro";
import CaseStudyListing from "../../components/case-studies/CaseStudyListing.astro";
import { getAllCaseStudies, getClientsWithIconByRank } from "../../lib/sanity/queries";
import { PAGE_META } from "../../lib/content/seo";
import { CASE_STUDY_COPY } from "../../components/case-studies/copy";
import JsonLd from "../../components/layout/JsonLd.astro";
import { caseStudiesIndexJsonLd } from "../../lib/new-pages/jsonld";
import { guardCaseStudyCopy, indexCopyFields, isProductionBuild } from "../../lib/sanity/case-study-release";
import type { CaseStudyCard } from "../../lib/sanity/types";

export async function getStaticPaths() {
  const cards = await getAllCaseStudies();
  const production = isProductionBuild();
  if (cards.length === 0) return production ? [] : [{ params: { index: undefined }, props: { cards } }];
  guardCaseStudyCopy("/case-studies", indexCopyFields(), production);
  return [{ params: { index: undefined }, props: { cards } }];
}

interface Props {
  cards: CaseStudyCard[];
}

const { cards } = Astro.props;
const hero = CASE_STUDY_COPY.indexHero;
// Indexable only when at least one listed case study is indexable, so the
// robots tag agrees with the sitemap (`case-study-sitemap.mjs`).
const noIndex = !cards.some((card) => card.noIndex !== true);
// Hero tiles: clients with an icon in the Studio order (`orderRank`); the hero
// shows the first 21, orbiting the rings.
const clients = await getClientsWithIconByRank();
---

<BaseLayout
  title={PAGE_META.caseStudies.title}
  description={PAGE_META.caseStudies.description}
  noIndex={noIndex}
>
  {/* Same CollectionPage + BreadcrumbList as /blog (lead 2026-10-21). */}
  {caseStudiesIndexJsonLd({ name: CASE_STUDY_COPY.breadcrumb.index, description: PAGE_META.caseStudies.description }, cards).map((data) => <JsonLd data={data} />)}
  <CaseStudiesIndexHero
    eyebrow={hero.eyebrow}
    title={hero.title}
    accent={hero.accent}
    description={hero.description}
    clients={clients}
    empty={cards.length === 0}
  />
  <CaseStudyListing cards={cards} />
</BaseLayout>

