---
/**
 * Testimonials page — Phase 5; cards redesigned 2026-11-05 after Figma
 * 4271:13535 (hero copy from the same frame).
 *
 * All page copy is static. Sanity supplies the testimonials and the
 * `testimonialsPage` SEO singleton (null until the document is created: the
 * title/description props below are the fallback).
 *
 * No Review / AggregateRating JSON-LD: Google ignores self-serving reviews
 * (an organization's reviews of itself on its own site).
 *
 * BaseLayout owns Nav, CtaBanner, Footer and ContactModal.
 *
 * `noindex` and out of the sitemap for now (lead 2026-09-30): production
 * ships without testimonials (the section and the nav / footer links are
 * hidden).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageSeo, getTestimonials } from "../lib/sanity/queries";
import { PAGE_META } from "../lib/content/seo";
import PageHero from "../components/sections/PageHero.astro";
import TestimonialsGrid from "../components/sections/TestimonialsGrid.astro";

const [testimonialsPage, testimonials] = await Promise.all([
  getPageSeo("testimonialsPage"),
  getTestimonials(),
]);

---

<BaseLayout
  pageSeo={testimonialsPage?.seo ?? null}
  title={PAGE_META.testimonials.title}
  description={PAGE_META.testimonials.description}
  noIndex={true}
>
  <PageHero
    eyebrow="Testimonials"
    title={"Hear from our\nhappy clients."}
    accent="happy clients."
    description="What marketing leaders say after launch day, and years into working together."
  />
  <TestimonialsGrid testimonials={testimonials} />
</BaseLayout>
