---
/**
 * Home page — Phase 4.
 *
 * All Home copy is static in the section components. Sanity only feeds the
 * client-driven sections (LogoStrip, FeaturedWork, OurWork) with clients pinned
 * by document `_id`. See `getClientsByIds` in `src/lib/sanity/queries.ts`; the
 * Our Work pins are shared with Pricing (`src/lib/content/our-work.ts`).
 *
 * BaseLayout owns Nav, Footer, CtaBanner and ContactModal — do not repeat
 * them here.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getHome,
  getClientsByIds,
  getAllClientsWithLogo,
  getAllClientsWithIcon,
  getTestimonials,
} from "../lib/sanity/queries";
import { OUR_WORK_GRID_IDS, OUR_WORK_LIST_IDS } from "../lib/content/our-work";
import { PAGE_META } from "../lib/content/seo";
import { AREA_SERVED_LD, ENTITY, ORG_ID, SITE, WEBSITE_ID } from "../lib/content/entity";
import JsonLd from "../components/layout/JsonLd.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import LogoStrip from "../components/sections/LogoStrip.astro";
import FeaturedWork from "../components/sections/FeaturedWork.astro";
import Services from "../components/sections/Services.astro";
import OurWork from "../components/sections/OurWork.astro";
import Technologies from "../components/sections/Technologies.astro";
import Testimonials from "../components/sections/Testimonials.astro";

const home = await getHome();
const [heroClients, logoClients, featuredClients, workClients, workListClients, testimonials] = await Promise.all([
  getAllClientsWithIcon(),
  getAllClientsWithLogo(),
  getClientsByIds(["client-surfe", "client-puzzle"]),
  getClientsByIds(OUR_WORK_GRID_IDS),
  getClientsByIds(OUR_WORK_LIST_IDS),
  getTestimonials(),
]);

// Organization + WebSite JSON-LD, Home only (SEO quick changes, lead
// 2026-10-06). Facts from `lib/content/entity.ts`; description = the Home
// meta description. No SearchAction: the site has no search.
const homeLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORG_ID,
      name: ENTITY.name,
      alternateName: ENTITY.alternateName,
      url: `${SITE}/`,
      logo: { "@type": "ImageObject", url: `${SITE}/apple-touch-icon.png`, width: 180, height: 180 },
      description: PAGE_META.home.description,
      email: ENTITY.email,
      address: { "@type": "PostalAddress", ...ENTITY.address },
      areaServed: AREA_SERVED_LD,
      knowsAbout: ENTITY.knowsAbout,
      sameAs: ENTITY.sameAs,
    },
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      url: `${SITE}/`,
      name: ENTITY.name,
      alternateName: ENTITY.alternateName,
      inLanguage: "en",
      publisher: { "@id": ORG_ID },
    },
  ],
};
---

<BaseLayout pageSeo={home?.seo ?? null} title={PAGE_META.home.title} description={PAGE_META.home.description}>
  <JsonLd data={homeLd} />
  <HomeHero clients={heroClients} />
  {/* Hidden on Home above 767px (lead 2026-09-30); shown on phones (2026-10-06). */}
  <LogoStrip clients={logoClients} hidden />
  <FeaturedWork clients={featuredClients} />
  <Services />
  <OurWork clients={workClients} listClients={workListClients} />
  <Technologies />
  <Testimonials testimonials={testimonials} />
</BaseLayout>
