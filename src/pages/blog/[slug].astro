---
/**
 * Blog posts from `content-drafts/blog/*.md` at /blog/<slug>, rendered with
 * the article template (the guides'). Drafts are built in previews and dev
 * only (src/lib/new-pages/registry.mjs). Docs: docs/new-pages.md.
 */
import NpArticlePage from "../../components/new-pages/NpArticlePage.astro";
import { pagesOf, type NpPage } from "../../lib/new-pages/loader";

export function getStaticPaths() {
  return pagesOf("blog").map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: NpPage;
}

const { page } = Astro.props;
---

<NpArticlePage page={page} />
